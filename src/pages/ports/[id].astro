---
import BaseLayout from '../../layouts/BaseLayout.astro';
import placesIndex from '../../data/places/places_index.json';

export function getStaticPaths() {
  return placesIndex.map((p: { id: string }) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');

// Dynamic import of port JSON
const portModule = await import(`../../data/places/${id}.json`);
const port = portModule.default;

const countryNames: Record<string, string> = {
  AE: 'الإمارات', BH: 'البحرين', DJ: 'جيبوتي', DZ: 'الجزائر',
  EG: 'مصر', IQ: 'العراق', JO: 'الأردن', KM: 'جزر القمر',
  KW: 'الكويت', LB: 'لبنان', LY: 'ليبيا', MA: 'المغرب',
  MR: 'موريتانيا', OM: 'عُمان', PS: 'فلسطين', QA: 'قطر',
  SA: 'السعودية', SD: 'السودان', SO: 'الصومال', SY: 'سوريا',
  TN: 'تونس', YE: 'اليمن',
};

const constituents = port.constituents as Record<string, { amp: number; phase: number }>;
const m2 = constituents.M2;
const s2 = constituents.S2;
const k1 = constituents.K1;
const o1 = constituents.O1;
const tidalRange = ((m2.amp + s2.amp) * 2).toFixed(0);

const title = `${port.name_ar} — مواقيت المد والجزر`;
---

<BaseLayout
  title={title}
  description={`مواقيت المد والجزر والحسابات الفلكية لـ${port.name_ar}، ${countryNames[port.country] || port.country}`}
>
  <div class="min-h-screen flex flex-col">

    <!-- Top bar -->
    <header class="sticky top-0 z-10 backdrop-blur-md bg-white/90 border-b border-[var(--border-subtle)] shadow-sm">
      <div class="max-w-4xl mx-auto px-4 py-3 flex items-center gap-4">
        <a href={BASE} class="flex items-center gap-2 shrink-0 text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors">
          <span class="text-sm">&larr;</span>
          <span class="text-sm hidden sm:inline">الرئيسية</span>
        </a>
        <span class="text-[var(--text-dim)] text-sm">/</span>
        <span class="text-[var(--text-primary)] text-sm font-medium truncate">{port.name_ar}</span>
        <span class="text-xs text-[var(--text-dim)] latin ml-auto shrink-0">{port.name_en}</span>
      </div>
    </header>

    <main class="flex-1 max-w-4xl mx-auto px-4 py-6 w-full">

      <!-- Port identity -->
      <div class="mb-8">
        <div class="text-xs text-[var(--text-muted)]">{countryNames[port.country] || port.country}</div>
        <h1 class="text-2xl font-bold text-[var(--text-primary)] mt-1">{port.name_ar}</h1>
        <div class="flex flex-wrap gap-3 mt-2 text-xs text-[var(--text-dim)]">
          <span class="latin">{port.name_en}</span>
          <span>&middot;</span>
          <span class="latin">{port.lat.toFixed(2)}&deg;N, {port.lon.toFixed(2)}&deg;E</span>
          <span>&middot;</span>
          <span class="latin">{port.timezone}</span>
        </div>
      </div>

      <!-- Quick stats row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
        <div class="p-3 rounded-[var(--radius-lg)] bg-[var(--surface-card)] border border-[var(--border-subtle)]">
          <div class="text-[10px] text-[var(--text-dim)] tracking-wide">المدى التقريبي</div>
          <div class="text-lg font-semibold text-[var(--text-primary)] latin mt-1">{tidalRange} سم</div>
        </div>
        <div class="p-3 rounded-[var(--radius-lg)] bg-[var(--surface-card)] border border-[var(--border-subtle)]">
          <div class="text-[10px] text-[var(--text-dim)] tracking-wide">M2 السعة</div>
          <div class="text-lg font-semibold text-[var(--text-primary)] latin mt-1">{m2.amp.toFixed(1)} سم</div>
        </div>
        <div class="p-3 rounded-[var(--radius-lg)] bg-[var(--surface-card)] border border-[var(--border-subtle)]">
          <div class="text-[10px] text-[var(--text-dim)] tracking-wide">المركبات</div>
          <div class="text-lg font-semibold text-[var(--text-primary)] mt-1">{Object.keys(constituents).length}</div>
        </div>
        <div class="p-3 rounded-[var(--radius-lg)] bg-[var(--surface-card)] border border-[var(--border-subtle)]">
          <div class="text-[10px] text-[var(--text-dim)] tracking-wide">خلية الشبكة</div>
          <div class="text-lg font-semibold text-[var(--text-primary)] latin mt-1">{port.grid.distance_km.toFixed(0)} كم</div>
        </div>
      </div>

      <!-- Tide info (placeholder for chart) -->
      <section class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <h2 class="text-sm font-medium text-[var(--text-muted)] tracking-wide">المد والجزر</h2>
          <div class="flex-1 h-px bg-[var(--border-subtle)]"></div>
        </div>
        <div class="p-8 rounded-[var(--radius-xl)] bg-[var(--surface-card)] border border-[var(--border-subtle)] text-center">
          <div class="text-4xl mb-3">🌊</div>
          <p class="text-[var(--text-secondary)] text-sm">مخطط المد والجزر قيد التطوير</p>
          <p class="text-[var(--text-dim)] text-xs mt-1">سيتم عرض منحنى المد والجزر اليومي هنا</p>
        </div>
      </section>

      <!-- Constituents table -->
      <section class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <h2 class="text-sm font-medium text-[var(--text-muted)] tracking-wide">المركبات التوافقية</h2>
          <div class="flex-1 h-px bg-[var(--border-subtle)]"></div>
        </div>
        <div class="overflow-x-auto rounded-[var(--radius-lg)] border border-[var(--border-subtle)]">
          <table class="w-full text-sm">
            <thead class="bg-[var(--surface-elevated)] text-[var(--text-muted)] text-xs">
              <tr>
                <th class="text-right px-4 py-2 font-medium">المركبة</th>
                <th class="text-right px-4 py-2 font-medium latin">السعة (سم)</th>
                <th class="text-right px-4 py-2 font-medium latin">الطور (&deg;)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border-subtle)]">
              {Object.entries(constituents).map(([name, c]) => (
                <tr class="hover:bg-[var(--surface-elevated)] transition-colors">
                  <td class="px-4 py-2 text-[var(--text-primary)] font-medium latin">{name}</td>
                  <td class="px-4 py-2 text-[var(--text-secondary)] latin">{c.amp.toFixed(2)}</td>
                  <td class="px-4 py-2 text-[var(--text-secondary)] latin">{c.phase.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Source -->
      <section class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <h2 class="text-sm font-medium text-[var(--text-muted)] tracking-wide">المصدر</h2>
          <div class="flex-1 h-px bg-[var(--border-subtle)]"></div>
        </div>
        <p class="text-xs text-[var(--text-dim)] leading-relaxed">
          {port.source}
        </p>
        <p class="text-xs text-[var(--text-dim)] mt-2">
          ⚠️ هذه حسابات فلكية تقديرية. قد تختلف ارتفاعات المد والجزر الفعلية تبعاً للظروف الجوية وعوامل محلية أخرى.
        </p>
      </section>

      <!-- Back link -->
      <div class="pt-8 border-t border-[var(--border-subtle)] text-center">
        <a href={BASE} class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">
          &larr; العودة للرئيسية
        </a>
      </div>

    </main>
  </div>
</BaseLayout>