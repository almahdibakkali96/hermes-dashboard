---
import BaseLayout from '../../layouts/BaseLayout.astro';
import placesIndex from '../../data/places/places_index.json';
import {
  generateTideCurve, dayExtremes, formatTime,
  classifyTide, classifySpringNeap, getTimezoneOffset
} from '../../lib/tides';
import { moonPhase, sunTimes, moonTimes, solunarPeriods } from '../../lib/astronomy';
import { calculatePrayerTimes, gregorianToHijri } from '../../lib/prayer';
import { countryName, formatCoords } from '../../lib/countries';
import FishRating from '../../components/FishRating.astro';
import { yearStats, seas, portSea } from '../../lib/seas';
import { fishForPort } from '../../lib/fish';
import GuidePromo from '../../components/GuidePromo.astro';

export function getStaticPaths() {
  return placesIndex.map((p: { id: string }) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');

const portModule = await import(`../../data/places/${id}.json`);
const port = portModule.default;


const constituents = port.constituents as Record<string, { amp: number; phase: number }>;
const portFish = fishForPort(id!);

const today = new Date();
const tzOffset = getTimezoneOffset(port.timezone, today);
const curve = generateTideCurve(constituents, today, tzOffset);
const extremes = dayExtremes(constituents, today, tzOffset);
const tideClass = classifyTide(constituents);

const moon = moonPhase(today);
const sun = sunTimes(today, port.lat, port.lon, tzOffset);
const moonT = moonTimes(today, port.lat, port.lon, tzOffset);
const solunar = solunarPeriods(moonT.moonrise, moonT.moonset, moonT.lunarTransit, moon.phase, today);

const prayers = calculatePrayerTimes(today, port.lat, port.lon, tzOffset, 'UmmAlQura');
const hijri = gregorianToHijri(today);

// 7-day forecast — simple data, no per-day charts
const weekDays = ['الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
const forecast = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(today); d.setDate(d.getDate() + i);
  const ex = dayExtremes(constituents, d, tzOffset);
  const hs = ex.filter((e: { type: string }) => e.type === 'high').sort((a: { height: number }, b: { height: number }) => b.height - a.height);
  const ls = ex.filter((e: { type: string }) => e.type === 'low').sort((a: { height: number }, b: { height: number }) => a.height - b.height);
  const m = moonPhase(d);
  return {
    label: i===0?'اليوم':weekDays[d.getDay()],
    dateStr: d.toLocaleDateString('en-GB',{day:'numeric',month:'short'}),
    highs: hs.slice(0, 3), lows: ls.slice(0, 3),
    range: hs.length&&ls.length?(hs[0].height-ls[0].height).toFixed(0):'—',
    moon: m, moonPct: Math.round(m.illumination*100),
    isToday: i===0
  };
});

// Monthly calendar — with fish rating
const year = today.getFullYear(), month = today.getMonth();
const daysInMonth = new Date(year, month+1, 0).getDate();
const monthDaysRaw = Array.from({length: daysInMonth}, (_,i) => {
  const d = new Date(year, month, i+1);
  const ex = dayExtremes(constituents, d, tzOffset);
  const hs = ex.filter((e: { type: string }) => e.type==='high'), ls = ex.filter((e: { type: string }) => e.type==='low');
  const range = hs.length&&ls.length?Math.max(...hs.map((h: { height: number }) => h.height))-Math.min(...ls.map((l: { height: number }) => l.height)):0;
  const m = moonPhase(d);
  return { day: i+1, range, moon: m, isToday: i+1===today.getDate() };
});

// Fish rating: 1-5 scale.
// Moon score based on lunar age (days since new moon, 0-29.53). Narrow windows around new/full moon.
// Tide score based on daily range relative to month's max.
// Colors: 5=green, 4=teal, 3=amber, 2=orange, 1=red
const maxMonthRange = Math.max(...monthDaysRaw.map(d => d.range), 1);
const fishColors = ['', '#ef4444', '#f97316', '#f59e0b', '#0d9488', '#16a34a'];
const fishLabels = ['', 'ضعيف', 'دون المتوسط', 'متوسط', 'جيد', 'ممتاز'];
const fishAdvice = ['', 'يوم غير مناسب للصيد', 'صيد ضعيف — يفضل التأجيل', 'صيد متوسط — قد تحصل على شيء', 'يوم جيد للصيد', 'يوم ممتاز — أفضل وقت للصيد'];

// Moon score: narrow windows around new moon (age 0-1.5 or 28-29.5) and full moon (age 13.5-16)
const moonScoreFromAge = (age: number) => {
  // Normalize age to 0-29.53
  const a = ((age % 29.53) + 29.53) % 29.53;
  // New moon window: 0-2 or 28-29.53 → score 3
  if (a <= 2 || a >= 28.0) return 3;
  if (a <= 3.5 || a >= 27.0) return 2;
  if (a <= 5 || a >= 25.5) return 1;
  // Full moon window: 13.5-16.5
  if (a >= 13.5 && a <= 16.0) return 3;
  if (a >= 12.5 && a <= 17.0) return 2;
  if (a >= 11.5 && a <= 18.0) return 1;
  return 0;
};

const calcFish = (range: number, moonAge: number) => {
  const moonScore = moonScoreFromAge(moonAge);
  const pct = range / maxMonthRange;
  const tideScore = pct >= 0.8 ? 2 : pct >= 0.5 ? 1 : 0;
  // 1-5 scale
  return Math.max(1, Math.min(5, 1 + moonScore + tideScore));
};

const monthDays = monthDaysRaw.map(d => {
  const fishRating = calcFish(d.range, d.moon.age);
  const emptyFish = '🐟'.repeat(5 - fishRating);
  const fullFish = '🐟'.repeat(fishRating);
  return { ...d, fishRating, fullFish, emptyFish, fishColor: fishColors[fishRating], fishLabel: fishLabels[fishRating], fishAdvice: fishAdvice[fishRating] };
});

// Add fish rating to 7-day forecast
const forecastWithFish = forecast.map(d => {
  const fishRating = calcFish(parseFloat(String(d.range)), d.moon.age);
  const emptyFish = '🐟'.repeat(5 - fishRating);
  const fullFish = '🐟'.repeat(fishRating);
  return { ...d, fishRating, fullFish, emptyFish, fishColor: fishColors[fishRating], fishLabel: fishLabels[fishRating], fishAdvice: fishAdvice[fishRating] };
});

// Best fishing days this month for the conclusion
const bestDays = monthDays.filter(d => d.fishRating >= 4).slice(0, 6);

// Today at a glance
const todayFish = forecastWithFish[0];
const springNeap = classifySpringNeap(moon.age);
const nextHigh = extremes.find(e => e.type === 'high' && e.time > today) || extremes.find(e => e.type === 'high');
const nextLow = extremes.find(e => e.type === 'low' && e.time > today) || extremes.find(e => e.type === 'low');
const todayRange = todayFish.range;
const localDateStr = new Date(today.getTime() + tzOffset * 60000).toISOString().slice(0, 10);
const prayerLabels: Record<string, string> = { fajr: 'الفجر', sunrise: 'الشروق', dhuhr: 'الظهر', asr: 'العصر', maghrib: 'المغرب', isha: 'العشاء' };

// Today's chart
const CHART_W = 760, CHART_H = 280, PAD_L = 44, PAD_R = 14, PAD_T = 30, PAD_B = 30;
const plotW = CHART_W - PAD_L - PAD_R, plotH = CHART_H - PAD_T - PAD_B;
const heights = curve.map((p: { height: number }) => p.height);
const hMin = Math.min(...heights), hMax = Math.max(...heights), hRange = hMax - hMin || 1;
const yScale = (h: number) => PAD_T + plotH - ((h - hMin) / hRange) * plotH;
const xHours = (h: number) => PAD_L + (h / 24) * plotW;
const pathD = curve.map((p: { height: number; hours: number }, i: number) => `${i === 0 ? 'M' : 'L'}${xHours(p.hours).toFixed(1)},${yScale(p.height).toFixed(1)}`).join(' ');
const yTicks = [0, 1 / 3, 2 / 3, 1].map(f => hMin + hRange * f);

// Monthly calendar grid — week starts Saturday; the RTL grid flows right to left
const firstWeekday = new Date(year, month, 1).getDay();
const leadingBlanks = (firstWeekday + 1) % 7;
const calWeekdays = ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'];

const title = `مواقيت المد والجزر في ${port.name_ar} اليوم — جدول 7 أيام وأوقات الصيد`;
const pageUrl = new URL(`${BASE}ports/${port.id}`, Astro.site).href;
const monthNames = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
const shareText = `مواقيت المد والجزر — ${port.name_ar}`;

// --- Plain-language summary + FAQ: quotable by search engines and AI assistants
const country = countryName(port.country);
const stats = (await yearStats(year)).find(r => r.id === port.id)!;
const dateAr = today.toLocaleDateString('ar-EG-u-nu-latn', { timeZone: port.timezone, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const fmtList = (xs: { time: Date; height: number }[]) => xs.map(x => `${formatTime(x.time, tzOffset)} (${x.height.toFixed(0)} سم)`).join('، ');
const todayHighs = extremes.filter(e => e.type === 'high'), todayLows = extremes.filter(e => e.type === 'low');
const tideTypeExplain: Record<string, string> = {
  'نصف يومي': 'مدّان عاليان وجزران منخفضان كل يوم تقريباً، بارتفاعات متقاربة',
  'مختلط، نصف يومي غالباً': 'مدّان وجزران في معظم الأيام، لكن بارتفاعات مختلفة بوضوح',
  'مختلط، يومي غالباً': 'مد عالٍ وجزر منخفض واحد في معظم الأيام، وأحياناً اثنان',
  'يومي': 'مد عالٍ واحد وجزر منخفض واحد كل يوم',
};
const maxRangeDateAr = new Date(stats.maxRangeDate + 'T12:00:00Z').toLocaleDateString('ar-EG-u-nu-latn', { day: 'numeric', month: 'long' });
const summary = `${dateAr} في ${port.name_ar} (${country}): المد العالي عند ${fmtList(todayHighs) || '—'}، والجزر المنخفض عند ${fmtList(todayLows) || '—'} بالتوقيت المحلي. المد هنا ${tideClass.typeAr}، ومدى اليوم ${todayRange} سم (${springNeap.conditionAr}). أقصى مدى متوقع خلال ${year} نحو ${(stats.maxRange / 100).toFixed(1)} م في ${maxRangeDateAr}.`;
const faq = [
  { q: `متى المد العالي اليوم في ${port.name_ar}؟`,
    a: todayHighs.length ? `اليوم (${dateAr}) المد العالي في ${port.name_ar} عند ${fmtList(todayHighs)}، والجزر المنخفض عند ${fmtList(todayLows)} بالتوقيت المحلي (${port.timezone}).` : 'لا يوجد مد عالٍ اليوم.' },
  { q: `ما نوع المد والجزر في ${port.name_ar}؟`,
    a: `المد في ${port.name_ar} ${tideClass.typeAr}: ${tideTypeExplain[tideClass.typeAr] ?? ''}. معامل الشكل F = ${tideClass.formFactor}.` },
  { q: `ما أكبر فرق بين المد والجزر في ${port.name_ar}؟`,
    a: `أقصى مدى يومي متوقع في ${port.name_ar} خلال ${year} نحو ${(stats.maxRange / 100).toFixed(2)} م (${maxRangeDateAr})، وأقل مدى نحو ${stats.minRange} سم في أيام المد المحاقي.` },
  { q: `ما أفضل أيام الصيد في ${port.name_ar} في ${monthNames[month]}؟`,
    a: bestDays.length ? `حسب تقييم ArabTides (طور القمر وقوة المد): ${bestDays.map(d => `${d.day} ${monthNames[month]}`).join('، ')}.` : `لا توجد أيام بتقييم جيد أو ممتاز في ${monthNames[month]}.` },
  { q: 'هل يمكن استخدام هذه الأوقات للملاحة؟',
    a: 'لا. هذه تقديرات فلكية من نموذج EOT20 العالمي، وليست جداول رسمية للميناء. قد يختلف المد الفعلي بسبب الرياح والضغط الجوي. للملاحة استخدم جداول الهيئة الهيدروغرافية الرسمية.' },
];
const pageJsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: new URL(BASE, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: country, item: new URL(`${BASE}country/${port.country}`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: port.name_ar, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'WebPage', url: pageUrl, name: title, inLanguage: 'ar',
    dateModified: today.toISOString(), description: summary,
    about: {
      '@type': 'Place', name: port.name_ar, alternateName: port.name_en,
      geo: { '@type': 'GeoCoordinates', latitude: port.lat, longitude: port.lon },
      address: { '@type': 'PostalAddress', addressCountry: port.country },
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={title} jsonLd={pageJsonLd} description={`مواقيت المد والجزر في ${port.name_ar} (${country}) اليوم وتوقعات 7 أيام: أوقات المد العالي والجزر المنخفض، أفضل أيام الصيد، طور القمر وأوقات الصلاة.`}>
  <!-- Hero -->
  <section class="hero">
    <div class="max-w-6xl mx-auto px-4 pt-8 pb-20 sm:pb-24">
      <nav class="breadcrumb breadcrumb-light" aria-label="مسار التنقل">
        <a href={BASE}>الرئيسية</a><span class="sep">/</span>
        <a href={`${BASE}country/${port.country}`}>{countryName(port.country)}</a><span class="sep">/</span>
        <span aria-current="page">{port.name_ar}</span>
      </nav>

      <div class="mt-4 flex flex-wrap items-end gap-x-6 gap-y-3">
        <div>
          <h1 class="text-4xl sm:text-5xl font-bold display leading-tight">{port.name_ar}</h1>
          <p class="mt-2 text-sm text-slate-300">
            <span class="latin" lang="en">{port.name_en}</span>
            <span class="mx-1.5 opacity-50">·</span>{countryName(port.country)}
            <span class="mx-1.5 opacity-50">·</span><span class="latin" lang="en">{formatCoords(port.lat, port.lon)}</span>
          </p>
        </div>
        <div class="ms-auto flex flex-wrap items-center gap-2 text-xs">
          <span class="hero-chip">📅 {hijri.day} {hijri.monthAr} {hijri.year} هـ</span>
          <span class="hero-chip">{moon.emoji} {moon.phaseNameAr} <span class="latin">{Math.round(moon.illumination * 100)}%</span></span>
          <span class="hero-chip">🌊 {tideClass.typeAr}</span>
        </div>
      </div>

      <!-- Today at a glance -->
      <dl class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="hero-stat">
          <dt class="text-xs text-slate-400">▲ المد القادم</dt>
          <dd class="mt-1 text-3xl font-bold latin text-teal-300">{nextHigh ? formatTime(nextHigh.time, tzOffset) : '—'}</dd>
          <dd class="text-xs text-slate-400">{nextHigh && <><span class="latin">{nextHigh.height.toFixed(0)}</span> سم</>}</dd>
        </div>
        <div class="hero-stat">
          <dt class="text-xs text-slate-400">▼ الجزر القادم</dt>
          <dd class="mt-1 text-3xl font-bold latin text-rose-300">{nextLow ? formatTime(nextLow.time, tzOffset) : '—'}</dd>
          <dd class="text-xs text-slate-400">{nextLow && <><span class="latin">{nextLow.height.toFixed(0)}</span> سم</>}</dd>
        </div>
        <div class="hero-stat">
          <dt class="text-xs text-slate-400">مدى اليوم</dt>
          <dd class="mt-1 text-3xl font-bold"><span class="latin">{todayRange}</span> <span class="text-base font-normal text-slate-300">سم</span></dd>
          <dd class="text-xs text-slate-400">{springNeap.conditionAr}</dd>
        </div>
        <div class="hero-stat">
          <dt class="text-xs text-slate-400">تقييم الصيد اليوم</dt>
          <dd class="mt-2"><span class="fish-on-dark"><FishRating rating={todayFish.fishRating} color={todayFish.fishColor} size={20} /></span></dd>
          <dd class="mt-1 text-sm font-semibold" style={`color:${todayFish.fishColor}`}>{todayFish.fishLabel}</dd>
        </div>
      </dl>
    </div>
    <svg class="hero-waves" viewBox="0 0 1440 72" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 40c120-20 240-30 360-18s240 40 360 36 240-34 360-38 240 18 360 26v26H0z" fill="currentColor" />
    </svg>
  </section>

  <main id="main" class="max-w-6xl mx-auto px-4 w-full mt-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

      <!-- Main column -->
      <div class="lg:col-span-2 space-y-6 min-w-0">

        <section class="card p-5 summary-card" aria-labelledby="summary-title">
          <h2 id="summary-title" class="text-sm font-semibold text-[var(--accent)]">ملخص اليوم</h2>
          <p class="mt-2 leading-relaxed text-[var(--text-secondary)]">{summary}</p>
        </section>

        <!-- Today's tide chart -->
        <section class="card p-5" aria-labelledby="chart-title">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 id="chart-title" class="text-lg font-semibold display">منحنى المد والجزر اليوم</h2>
            <span class="text-xs text-[var(--text-muted)] latin">{today.toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' })}</span>
            <span class="ms-auto text-xs text-[var(--text-muted)]">بالتوقيت المحلي · الارتفاع بالسنتيمتر</span>
          </div>
          <div class="chart-ltr mt-3">
            <svg id="tide-chart" viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="w-full h-auto" role="img"
                 aria-label={`منحنى المد والجزر لـ${port.name_ar} اليوم`}
                 data-tz={tzOffset} data-date={localDateStr} data-padl={PAD_L} data-plotw={plotW}>
              <defs>
                <linearGradient id="tideFill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#14b8a6" stop-opacity="0.28" />
                  <stop offset="100%" stop-color="#14b8a6" stop-opacity="0.02" />
                </linearGradient>
              </defs>
              {yTicks.map(v => (
                <>
                  <line x1={PAD_L} y1={yScale(v)} x2={CHART_W - PAD_R} y2={yScale(v)} stroke="#e8ecf0" stroke-width="1" />
                  <text x={PAD_L - 8} y={yScale(v) + 4} text-anchor="end" font-size="11" fill="#94a3b8" font-family="Inter,sans-serif">{v.toFixed(0)}</text>
                </>
              ))}
              {[0, 3, 6, 9, 12, 15, 18, 21, 24].map(h => (
                <text x={xHours(h)} y={CHART_H - 8} text-anchor="middle" font-size="11" fill="#94a3b8" font-family="Inter,sans-serif">{String(h).padStart(2, '0')}:00</text>
              ))}
              <path d={`${pathD} L${xHours(24).toFixed(1)},${PAD_T + plotH} L${xHours(0).toFixed(1)},${PAD_T + plotH} Z`} fill="url(#tideFill)" />
              <path d={pathD} fill="none" stroke="#0d9488" stroke-width="2.5" stroke-linejoin="round" />
              <g id="now-marker" style="display:none">
                <line y1={PAD_T - 6} y2={PAD_T + plotH} stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="4 3" />
                <text y={PAD_T - 10} text-anchor="middle" font-size="11" font-weight="600" fill="#d97706" font-family="Noto Naskh Arabic,serif">الآن</text>
              </g>
              {extremes.map(ex => {
                const cx = xHours(ex.hours), cy = yScale(ex.height), hi = ex.type === 'high';
                return (
                  <>
                    <circle cx={cx} cy={cy} r="5" fill={hi ? '#0d9488' : '#e11d48'} stroke="#fff" stroke-width="2" />
                    <text x={cx} y={hi ? cy - 12 : cy + 20} text-anchor="middle" font-size="12" font-weight="600" fill={hi ? '#0f766e' : '#be123c'} font-family="Inter,sans-serif">{formatTime(ex.time, tzOffset)}</text>
                  </>
                );
              })}
            </svg>
          </div>
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-2">
            {extremes.map(ex => (
              <div class={`rounded-xl px-3 py-2.5 ${ex.type === 'high' ? 'bg-teal-50' : 'bg-rose-50'}`}>
                <div class={`text-xs font-medium ${ex.type === 'high' ? 'text-teal-700' : 'text-rose-700'}`}>{ex.type === 'high' ? '▲ مد عالٍ' : '▼ جزر منخفض'}</div>
                <div class="text-xl font-bold latin mt-0.5">{formatTime(ex.time, tzOffset)}</div>
                <div class="text-xs text-[var(--text-muted)]"><span class="latin">{ex.height.toFixed(0)}</span> سم</div>
              </div>
            ))}
          </div>
        </section>

        <!-- 7-day forecast -->
        <section class="card overflow-hidden" aria-labelledby="week-title">
          <div class="px-5 pt-5 pb-3 flex flex-wrap items-baseline gap-x-3">
            <h2 id="week-title" class="text-lg font-semibold display">توقعات ٧ أيام</h2>
            <span class="text-xs text-[var(--text-muted)]">المد والجزر وتقييم الصيد</span>
          </div>
          <ul class="divide-y divide-[var(--border-subtle)]">
            {forecastWithFish.map(day => (
              <li class={`week-row px-5 py-4 ${day.isToday ? 'bg-teal-50/50' : ''}`}>
                <div class="flex items-center gap-3">
                  <span class="text-2xl" aria-hidden="true">{day.moon.emoji}</span>
                  <div>
                    <div class="font-semibold">{day.label}</div>
                    <div class="text-xs text-[var(--text-muted)] latin">{day.dateStr}</div>
                  </div>
                </div>
                <div class="week-fish">
                  <FishRating rating={day.fishRating} color={day.fishColor} />
                  <div class="text-xs font-medium mt-0.5" style={`color:${day.fishColor}`}>{day.fishLabel}</div>
                  <div class="text-[11px] text-[var(--text-muted)]">المدى <span class="latin">{day.range}</span> سم</div>
                </div>
                <div class="text-sm">
                  <div class="text-[11px] text-teal-700 font-medium mb-1">▲ مد</div>
                  <div class="flex flex-wrap gap-x-3 gap-y-0.5">
                    {[...day.highs].sort((a, b) => a.time.getTime() - b.time.getTime()).map(h => <span class="latin font-semibold">{formatTime(h.time, tzOffset)} <span class="font-normal text-[var(--text-muted)] text-xs">{h.height.toFixed(0)}</span></span>)}
                  </div>
                </div>
                <div class="text-sm">
                  <div class="text-[11px] text-rose-700 font-medium mb-1">▼ جزر</div>
                  <div class="flex flex-wrap gap-x-3 gap-y-0.5">
                    {[...day.lows].sort((a, b) => a.time.getTime() - b.time.getTime()).map(l => <span class="latin font-semibold">{formatTime(l.time, tzOffset)} <span class="font-normal text-[var(--text-muted)] text-xs">{l.height.toFixed(0)}</span></span>)}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- Monthly calendar + fishing summary -->
        <section class="card p-5" aria-labelledby="cal-title">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 id="cal-title" class="text-lg font-semibold display">تقويم الصيد — {monthNames[month]} <span class="latin">{year}</span></h2>
            <span class="text-xs text-[var(--text-muted)]">طور القمر وتقييم كل يوم</span>
          </div>
          <div class="mt-4 grid grid-cols-7 gap-1 sm:gap-1.5 text-center">
            {calWeekdays.map(w => <div class="text-[10px] sm:text-xs text-[var(--text-muted)] pb-1">{w}</div>)}
            {Array.from({ length: leadingBlanks }).map(() => <div></div>)}
            {monthDays.map(d => (
              <div class={`cal-cell ${d.isToday ? 'cal-today' : ''}`} style={`--rating:${d.fishColor}`} title={`${d.day} ${monthNames[month]} — ${d.fishLabel}`}>
                <div class="text-xs sm:text-sm font-semibold latin">{d.day}</div>
                <div class="text-sm sm:text-base leading-none my-0.5" aria-hidden="true">{d.moon.emoji}</div>
                <div class="hidden sm:block"><FishRating rating={d.fishRating} color={d.fishColor} size={8} /></div>
                <div class="sm:hidden h-1.5 rounded-full mx-1" style={`background:${d.fishColor};opacity:${0.25 + d.fishRating * 0.15}`}></div>
              </div>
            ))}
          </div>

          <div class="mt-6 rounded-xl bg-[var(--surface-elevated)] p-4">
            <h3 class="font-semibold text-sm">🎣 أفضل أيام الصيد في {monthNames[month]}</h3>
            {bestDays.length > 0 ? (
              <div class="mt-3 flex flex-wrap gap-2">
                {bestDays.map(d => (
                  <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white text-sm font-medium border" style={`border-color:${d.fishColor}55;color:${d.fishColor}`}>
                    <span class="latin">{d.day}</span> {monthNames[month]}
                    <FishRating rating={d.fishRating} color={d.fishColor} size={10} />
                  </span>
                ))}
              </div>
            ) : (
              <p class="mt-2 text-sm text-[var(--text-muted)]">لا توجد أيام ممتازة هذا الشهر</p>
            )}
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
              <p class="text-[var(--text-secondary)] leading-relaxed"><strong class="text-[var(--text-primary)]">📖 التفسير:</strong> أفضل الصيد قرب اكتمال القمر (بدر) وميلاده (محاق) — يرتفع المد وتتحرك المياه فتنشط الأسماك على التغذي.</p>
              <p class="text-[var(--text-secondary)] leading-relaxed"><strong class="text-[var(--text-primary)]">🎯 القاعدة العملية:</strong> انطلق قبل ساعتين من ذروة المد أو بعدها مباشرة. أثناء الجزر تتركز الأسماك في القنوات العميقة.</p>
            </div>
          </div>
        </section>

        <!-- Fish in this port's sea -->
        <section class="card p-5" aria-labelledby="fish-title">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 id="fish-title" class="text-lg font-semibold display">أسماك {port.name_ar}</h2>
            <span class="text-xs text-[var(--text-muted)]">أنواع تعيش في {seas[portSea[id!]].name}</span>
            <a href={`${BASE}fish`} class="ms-auto text-xs text-[var(--accent)] hover:underline">دليل الأسماك ←</a>
          </div>
          <div class="mt-4 grid grid-cols-3 sm:grid-cols-4 gap-2.5">
            {portFish.fish.slice(0, 12).map(f => (
              <a href={`${BASE}fish/${f.id}`} class="rounded-lg overflow-hidden border border-[var(--border-subtle)] group block">
                <img src={`${BASE}fish/${f.id}.webp`} alt={f.ar} loading="lazy" decoding="async" class="fish-thumb" />
                <span class="block px-2 py-1.5 text-xs font-semibold truncate group-hover:text-[var(--accent)] transition-colors">
                  {portFish.observed.has(f.id) && <span title="سُجّلت مشاهدته قرب الميناء">📍 </span>}{f.ar}
                </span>
              </a>
            ))}
          </div>
          <p class="mt-3 text-xs text-[var(--text-muted)] leading-relaxed">
            {portFish.observed.size > 0
              ? <>📍 <span class="latin">{portFish.observed.size}</span> من هذه الأنواع سجّل الغواصون والصيادون مشاهدتها في نطاق <span class="latin">50</span> كم من {port.name_ar} على منصة iNaturalist.</>
              : <>الأنواع الشائعة في {seas[portSea[id!]].name}.</>}
            {portFish.fish.length > 12 && <> وأنواع أخرى في <a href={`${BASE}fish`} class="text-[var(--accent)] hover:underline">دليل الأسماك</a>.</>}
          </p>
        </section>

        <GuidePromo variant="strip" />

        <!-- FAQ -->
        <section class="card p-5" aria-labelledby="faq-title">
          <h2 id="faq-title" class="text-lg font-semibold display">أسئلة شائعة عن المد والجزر في {port.name_ar}</h2>
          <div class="mt-3 divide-y divide-[var(--border-subtle)]">
            {faq.map((f, i) => (
              <details class="faq py-3" open={i === 0}>
                <summary class="flex items-center gap-3 cursor-pointer font-medium list-none">
                  <span class="faq-icon" aria-hidden="true">+</span>{f.q}
                </summary>
                <p class="mt-2 ps-9 text-sm leading-relaxed text-[var(--text-secondary)]">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6 min-w-0">
        <GuidePromo variant="card" />

        <section class="card p-5" aria-labelledby="sun-title">
          <h2 id="sun-title" class="font-semibold">☀️ الشمس والقمر</h2>
          <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
            <div class="info-tile"><dt>الشروق</dt><dd class="latin">{sun.sunrise || '—'}</dd></div>
            <div class="info-tile"><dt>الغروب</dt><dd class="latin">{sun.sunset || '—'}</dd></div>
            <div class="info-tile"><dt>شروق القمر</dt><dd class="latin">{moonT.moonrise || '—'}</dd></div>
            <div class="info-tile"><dt>غروب القمر</dt><dd class="latin">{moonT.moonset || '—'}</dd></div>
          </dl>
          <div class="mt-3 flex items-center gap-3 rounded-xl bg-[var(--surface-elevated)] p-3">
            <span class="text-3xl" aria-hidden="true">{moon.emoji}</span>
            <div>
              <div class="font-semibold text-sm">{moon.phaseNameAr}</div>
              <div class="text-xs text-[var(--text-muted)]">الإضاءة <span class="latin">{Math.round(moon.illumination * 100)}%</span> · عمر القمر <span class="latin">{moon.age.toFixed(1)}</span> يوم</div>
            </div>
          </div>
        </section>

        <section class="card p-5" aria-labelledby="solunar-title">
          <h2 id="solunar-title" class="font-semibold">🎣 أوقات الصيد (سولونار)</h2>
          {solunar.periods.length > 0 ? (
            <ul class="mt-3 space-y-2 text-sm">
              {solunar.periods.map(p => (
                <li class={`flex items-center gap-2 rounded-lg px-3 py-2 ${p.type === 'major' ? 'bg-teal-50' : 'bg-[var(--surface-elevated)]'}`}>
                  <span class={`w-2 h-2 rounded-full shrink-0 ${p.quality === 'excellent' ? 'bg-green-500' : p.quality === 'good' ? 'bg-teal-500' : 'bg-amber-400'}`}></span>
                  <span class="font-medium">{p.typeAr}</span>
                  <span class="latin ms-auto text-[var(--text-secondary)]">{p.start} – {p.end}</span>
                </li>
              ))}
            </ul>
          ) : <p class="mt-3 text-sm text-[var(--text-muted)]">لا توجد بيانات</p>}
          <p class="mt-3 text-xs text-[var(--text-muted)] leading-relaxed">الفترات الكبرى حول عبور القمر، والصغرى حول شروقه وغروبه.</p>
        </section>

        <section class="card p-5" aria-labelledby="prayer-title">
          <h2 id="prayer-title" class="font-semibold">🕌 أوقات الصلاة</h2>
          <dl class="mt-3 grid grid-cols-3 gap-2 text-sm">
            {Object.entries(prayers).map(([name, time]) => (
              <div class="info-tile text-center"><dt>{prayerLabels[name]}</dt><dd class="latin">{time}</dd></div>
            ))}
          </dl>
          <p class="mt-3 text-xs text-[var(--text-muted)]">طريقة أم القرى · التاريخ الهجري تقديري وقد يختلف بيوم</p>
        </section>

        <section class="card p-3" aria-label="موقع الميناء على الخريطة">
          <div id="map" class="port-map w-full" data-lat={port.lat} data-lon={port.lon} data-name={port.name_ar}></div>
          <p class="text-[11px] text-[var(--text-dim)] mt-2 text-center">بيانات الخريطة &copy; <a href="https://www.openstreetmap.org/copyright" class="underline hover:text-[var(--accent)]" lang="en">OpenStreetMap</a></p>
        </section>

        <section class="card p-5 no-print" aria-labelledby="share-title">
          <h2 id="share-title" class="font-semibold">شارك الصفحة</h2>
          <div class="mt-3 grid grid-cols-3 gap-2 text-sm">
            <a href={`https://wa.me/?text=${encodeURIComponent(shareText)}%20${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" class="share-btn">💬 واتساب</a>
            <button type="button" class="share-btn" id="copy-link" data-url={pageUrl}>🔗 نسخ الرابط</button>
            <button type="button" class="share-btn" onclick="window.print()">🖨️ طباعة</button>
          </div>
        </section>

        <section class="card p-5 text-xs text-[var(--text-muted)] leading-relaxed">
          <p>⚠️ تقديرات فلكية، لا تُستخدم للملاحة. الارتفاعات بالنسبة لمتوسط سطح البحر. <a href={`${BASE}disclaimer`} class="text-[var(--accent)] hover:underline">إخلاء المسؤولية</a> · <a href={`${BASE}methodology`} class="text-[var(--accent)] hover:underline">كيف تعمل الحسابات؟</a></p>
          <p class="mt-2 latin" lang="en">{port.source}</p>
          <details class="mt-3">
            <summary class="cursor-pointer select-none hover:text-[var(--text-primary)]">المركبات التوافقية (<span class="latin">{Object.keys(constituents).length}</span>)</summary>
            <table class="mt-2 w-full">
              <thead><tr class="text-[var(--text-secondary)]"><th class="text-start py-1">المركبة</th><th class="text-start py-1">السعة (سم)</th><th class="text-start py-1">الطور (°)</th></tr></thead>
              <tbody class="latin">
                {Object.entries(constituents).map(([name, c]) => <tr class="border-t border-[var(--border-subtle)]"><td class="py-1 font-medium">{name}</td><td class="py-1">{c.amp.toFixed(2)}</td><td class="py-1">{c.phase.toFixed(1)}</td></tr>)}
              </tbody>
            </table>
          </details>
        </section>
      </aside>
    </div>
  </main>

  <!-- "Now" marker on today's chart, in the port's local time; copy-link button -->
  <script is:inline>
    (function () {
      var svg = document.getElementById('tide-chart');
      var g = document.getElementById('now-marker');
      if (!svg || !g) return;
      var tz = parseFloat(svg.dataset.tz), local = new Date(Date.now() + tz * 60000);
      if (local.toISOString().slice(0, 10) !== svg.dataset.date) return;
      var hours = local.getUTCHours() + local.getUTCMinutes() / 60;
      var x = parseFloat(svg.dataset.padl) + hours / 24 * parseFloat(svg.dataset.plotw);
      g.querySelector('line').setAttribute('x1', x);
      g.querySelector('line').setAttribute('x2', x);
      g.querySelector('text').setAttribute('x', x);
      g.style.display = '';
    })();
    (function () {
      var btn = document.getElementById('copy-link');
      if (!btn || !navigator.clipboard) return;
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(btn.dataset.url).then(function () {
          var old = btn.textContent; btn.textContent = '✓ تم النسخ';
          setTimeout(function () { btn.textContent = old; }, 1800);
        });
      });
    })();
  </script>

  <!-- Leaflet map -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      function initMap() {
        var el = document.getElementById('map');
        if (!el || typeof L === 'undefined') return;
        var lat = parseFloat(el.dataset.lat), lon = parseFloat(el.dataset.lon);
        var map = L.map(el, { scrollWheelZoom: false, attributionControl: false }).setView([lat, lon], 9);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18, attribution: '&copy; OpenStreetMap'
        }).addTo(map);
        L.circleMarker([lat, lon], {
          radius: 8, color: '#ffffff', fillColor: '#0d9488', fillOpacity: 0.95, weight: 2.5
        }).addTo(map).bindPopup(el.dataset.name);
        map.on('click', function () { map.scrollWheelZoom.enable(); });
        setTimeout(function () { map.invalidateSize(); }, 200);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMap);
      } else { initMap(); }
    })();
  </script>
</BaseLayout>
