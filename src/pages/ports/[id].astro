---
import BaseLayout from '../../layouts/BaseLayout.astro';
import placesIndex from '../../data/places/places_index.json';
import {
  generateTideCurve, dayExtremes, formatTime, localMidnight, DATUM_KEY,
  classifyTide, classifySpringNeap, getTimezoneOffset, portDay, tideCoefficient, coefficientLabelAr
} from '../../lib/tides';
import { moonIcon, moonPhase, sunTimes, moonTimes, solunarPeriods } from '../../lib/astronomy';
import { calculatePrayerTimes, gregorianToHijri } from '../../lib/prayer';
import { countryName, formatCoords } from '../../lib/countries';
import RatingBadge from '../../components/RatingBadge.astro';
import Icon from '../../components/Icon.astro';
import { calcFish, fishColors, fishLabels, fishAdvice, monthDays as monthDaysOf, maxRangeOf, ratingsFrom } from '../../lib/fishing';
import { yearStats, seas, portSea } from '../../lib/seas';
import { fishForPort, fishLabel } from '../../lib/fish';
import CalendarPromo from '../../components/CalendarPromo.astro';
import LiveTides from '../../components/LiveTides.astro';
import { altNamesAr, frenchName, nameWithAlts } from '../../lib/portNames';
import { CAL, forPort, hasCalendar, portYearSummary } from '../../lib/calendar';
import PortMiniMap from '../../components/PortMiniMap.astro';
import { isWorld } from '../../lib/regions';

export function getStaticPaths() {
  return placesIndex.map((p: { id: string }) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');

const portModule = await import(`../../data/places/${id}.json`);
const port = portModule.default;


const constituents = port.constituents as Record<string, { amp: number; phase: number }>;
// Z0 (mean sea level above LAT) is the chart datum, not a wave: listed apart from the constituents
const waves = Object.entries(constituents).filter(([name]) => name !== DATUM_KEY);
const datumCm = Math.round(constituents[DATUM_KEY]?.amp ?? 0);
const portFish = fishForPort(id!);

// "Today" is the port's local date; the daily refresh rebuilds just after each timezone's midnight
const now = new Date();
const tzOffset = getTimezoneOffset(port.timezone, now);
const today = portDay(now, tzOffset);
const curve = generateTideCurve(constituents, today, tzOffset);
const extremes = dayExtremes(constituents, today, tzOffset);
const tideClass = classifyTide(constituents);

const moon = moonPhase(today);
const sun = sunTimes(today, port.lat, port.lon, tzOffset);
const moonT = moonTimes(today, port.lat, port.lon, tzOffset);
const solunar = solunarPeriods(moonT.moonrise, moonT.moonset, moonT.lunarTransit, moon.phase, today);

// World places (src/lib/regions.ts): Muslim World League prayer times, no fish list, no Arab-ports calendar
const world = isWorld(port.id);
const prayerMethod = world ? 'MWL' : 'UmmAlQura';
const prayers = calculatePrayerTimes(today, port.lat, port.lon, tzOffset, prayerMethod);
const hijri = gregorianToHijri(today);

// 7-day forecast — simple data, no per-day charts; each day rated against its own month
const weekDays = ['الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
const weekRatings = ratingsFrom(constituents, today, 7, tzOffset);
const forecastWithFish = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(today); d.setUTCDate(d.getUTCDate() + i);
  const ex = dayExtremes(constituents, d, tzOffset);
  const hs = ex.filter((e: { type: string }) => e.type === 'high').sort((a: { height: number }, b: { height: number }) => b.height - a.height);
  const ls = ex.filter((e: { type: string }) => e.type === 'low').sort((a: { height: number }, b: { height: number }) => a.height - b.height);
  const m = moonPhase(d);
  const fishRating = weekRatings[i].rating;
  return {
    label: i===0?'اليوم':weekDays[d.getUTCDay()],
    dateStr: d.toLocaleDateString('en-GB',{timeZone:'UTC',day:'numeric',month:'short'}),
    highs: hs.slice(0, 3), lows: ls.slice(0, 3),
    range: hs.length&&ls.length?(hs[0].height-ls[0].height).toFixed(0):'—',
    moon: m, moonPct: Math.round(m.illumination*100),
    isToday: i===0,
    fishRating, fishColor: fishColors[fishRating], fishLabel: fishLabels[fishRating],
  };
});

// Monthly calendar with the fishing rating (src/lib/fishing.ts): moon age + the day's range
// relative to the month's largest range at this port
const year = today.getUTCFullYear(), month = today.getUTCMonth();
const monthDaysRaw = monthDaysOf(constituents, year, month, tzOffset).map(d => ({ ...d, isToday: d.day === today.getUTCDate() }));
const maxMonthRange = maxRangeOf(monthDaysRaw);
const monthDays = monthDaysRaw.map(d => {
  const fishRating = calcFish(d.range, d.moon.age, maxMonthRange);
  return { ...d, fishRating, fishColor: fishColors[fishRating], fishLabel: fishLabels[fishRating] };
});

// Best fishing days in the next 30 days (rolling into next month, rated against that month's
// calendar). The moon is the same for every port, so ties are broken by what differs between
// ports: a high tide within 1 h of sunrise or sunset, then the day's tide range.
const nextMonth = monthDaysOf(constituents, month === 11 ? year + 1 : year, (month + 1) % 12, tzOffset);
const nextMaxRange = maxRangeOf(nextMonth);
const nextMonthRated = nextMonth.map(d => ({ ...d, fishRating: calcFish(d.range, d.moon.age, nextMaxRange) }));
const localHour = (t: Date) => (((t.getTime() + tzOffset * 60000) / 3600000) % 24 + 24) % 24;
const clockHour = (s: string | null) => s ? Number(s.slice(0, 2)) + Number(s.slice(3, 5)) / 60 : null;
const tideAtTwilight = (d: { date: Date; extremes: { time: Date; type: string }[] }) => {
  const sunD = sunTimes(d.date, port.lat, port.lon, tzOffset);
  const marks = [clockHour(sunD.sunrise), clockHour(sunD.sunset)].filter((h): h is number => h !== null);
  return d.extremes.some(e => e.type === 'high' && marks.some(h => Math.abs(localHour(e.time) - h) <= 1));
};
const bestDays = [
  ...monthDays.filter(d => d.day >= today.getUTCDate()),
  ...nextMonthRated,
].slice(0, 30)
  .filter(d => d.fishRating >= 4)
  .map(d => ({ ...d, twilight: tideAtTwilight(d), fishColor: fishColors[d.fishRating] }))
  .sort((a, b) => b.fishRating - a.fishRating || Number(b.twilight) - Number(a.twilight) || b.range - a.range)
  .slice(0, 6)
  .sort((a, b) => a.date.getTime() - b.date.getTime());

// Solunar periods as absolute times. The strings are clock times rounded to the half hour; a
// period around midnight wraps (23:30–01:30): its centre tells which side of midnight it starts.
const DAY_MS = 86400000;
const periodsAt = (periods: typeof solunar.periods, midnight: number) => periods.map(p => {
  const at = (hhmm: string) => midnight + (Number(hhmm.slice(0, 2)) * 60 + Number(hhmm.slice(3, 5))) * 60000;
  let s = at(p.start), e = at(p.end);
  if (e <= s) {
    const centre = (s + e + DAY_MS) / 2;
    if (centre >= midnight + DAY_MS) s -= DAY_MS; else e += DAY_MS;
  }
  return { ...p, s, e };
}).sort((a, b) => a.s - b.s);
const midnightToday = localMidnight(today, tzOffset).getTime();
const tomorrowDay = new Date(today.getTime() + DAY_MS);
const moonTomorrow = moonTimes(tomorrowDay, port.lat, port.lon, tzOffset);
const solunarTomorrow = solunarPeriods(moonTomorrow.moonrise, moonTomorrow.moonset, moonTomorrow.lunarTransit, moonPhase(tomorrowDay).phase, tomorrowDay);
const todayPeriods = periodsAt(solunar.periods, midnightToday);
const majorPeriods = [...todayPeriods, ...periodsAt(solunarTomorrow.periods, midnightToday + DAY_MS)].filter(p => p.type === 'major');
const liveMajors = JSON.stringify(majorPeriods.map(p => [p.s, p.e, p.start, p.end]));
const nextMajor = majorPeriods.find(p => p.e > now.getTime()) ?? majorPeriods[0];
const qualityAr: Record<string, string> = { excellent: 'قوية جداً', good: 'قوية', fair: 'متوسطة', poor: 'ضعيفة' };

// Today at a glance
const todayFish = forecastWithFish[0];
const springNeap = classifySpringNeap(moon.age);
const nextHigh = extremes.find(e => e.type === 'high' && e.time > now) || extremes.find(e => e.type === 'high');
const nextLow = extremes.find(e => e.type === 'low' && e.time > now) || extremes.find(e => e.type === 'low');
// Today's and tomorrow's tides: the page is built at midnight, the browser picks the next ones (LiveTides)
const liveTides = JSON.stringify([...extremes, ...dayExtremes(constituents, new Date(today.getTime() + 86400000), tzOffset)]
  .map(e => [e.type === 'high' ? 'h' : 'l', e.time.getTime(), formatTime(e.time, tzOffset), Math.round(e.height)]));
const todayRange = todayFish.range;
const localDateStr = new Date(today.getTime() + tzOffset * 60000).toISOString().slice(0, 10);
const prayerLabels: Record<string, string> = { fajr: 'الفجر', sunrise: 'الشروق', dhuhr: 'الظهر', asr: 'العصر', maghrib: 'المغرب', isha: 'العشاء' };

// Today's chart
const CHART_W = 600, CHART_H = 310, PAD_L = 52, PAD_R = 18, PAD_T = 40, PAD_B = 58;
const plotW = CHART_W - PAD_L - PAD_R, plotH = CHART_H - PAD_T - PAD_B;
const heights = curve.map((p: { height: number }) => p.height);
const hMin = Math.min(...heights), hMax = Math.max(...heights), hRange = hMax - hMin || 1;
const yScale = (h: number) => PAD_T + plotH - ((h - hMin) / hRange) * plotH;
const xHours = (h: number) => PAD_L + (h / 24) * plotW;
const pathD = curve.map((p: { height: number; hours: number }, i: number) => `${i === 0 ? 'M' : 'L'}${xHours(p.hours).toFixed(1)},${yScale(p.height).toFixed(1)}`).join(' ');
const yTicks = [0, 1 / 3, 2 / 3, 1].map(f => hMin + hRange * f);

// Monthly calendar grid — week starts Saturday; the RTL grid flows right to left
const firstWeekday = new Date(Date.UTC(year, month, 1)).getUTCDay();
const leadingBlanks = (firstWeekday + 1) % 7;
const calWeekdays = ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'];

// Name in the title as people search it (Search Console: "المد والجزر الكويت", never "مدينة الكويت")
const TITLE_NAME: Record<string, string> = { 'kuwait-city': 'الكويت' };
// Leads with the words people type ("المد والجزر الدار البيضاء", "جدول المد والجزر في …", "حالة الصيد اليوم")
const title = `المد والجزر في ${TITLE_NAME[port.id] || port.name_ar} اليوم — جدول 7 أيام وحالة الصيد`;
const pageUrl = new URL(`${BASE}ports/${port.id}`, Astro.site).href;
const monthNames = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];

// Tide coefficient (20–120, 120 = this port's largest range of the year); null on micro-tidal coasts
const stats = (await yearStats(year)).find(r => r.id === port.id)!;
const coefOf = (range: number) => tideCoefficient(range, stats.maxRange);
const todayCoef = coefOf(monthDays.find(d => d.isToday)!.range);

// Calendar day details: tap a day, or step with the arrows into next month. Embedded as JSON
// for the inline script; times are the port's local time, heights in cm.
const dayDetails = [...monthDays, ...nextMonthRated].map(d => {
  const sunD = sunTimes(d.date, port.lat, port.lon, tzOffset);
  const byTime = [...d.extremes].sort((a, b) => a.time.getTime() - b.time.getTime());
  const tideList = (type: string) => byTime.filter(e => e.type === type).map(e => [formatTime(e.time, tzOffset), Math.round(e.height)]);
  return {
    key: d.date.toISOString().slice(0, 10),
    title: `${weekDays[d.date.getUTCDay()]} ${d.day} ${monthNames[d.month]}`,
    rating: d.fishRating, color: fishColors[d.fishRating], label: fishLabels[d.fishRating],
    highs: tideList('high'), lows: tideList('low'),
    sun: `${sunD.sunrise ?? '—'} / ${sunD.sunset ?? '—'}`,
    coef: coefOf(d.range),
    moon: `${d.moon.phaseNameAr} · ${Math.round(d.moon.illumination * 100)}%`,
  };
});
const shareText = `مواقيت المد والجزر — ${port.name_ar}`;

// Day viewer (src/scripts/port-day.ts): today plus the next six days as tabs, and any day of this month and
// next through the month calendar's "curve of this day" button. No date picker on purpose: the year is the 2027 calendar's job.
const keyOf = (d: Date) => d.toISOString().slice(0, 10);
const viewDays = [...monthDays, ...nextMonthRated];
const viewLast = viewDays[viewDays.length - 1];
// The 2027 numbers are for the calendar promo: ports with a calendar only (about 200 ms a port, so other world places skip it)
const hasCal = hasCalendar(port.id, world);
const calSummary = hasCal ? portYearSummary(port.id, constituents, port.timezone) : undefined;
const dayTabs = forecastWithFish.map((f, i) => {
  const d = new Date(today.getTime() + i * DAY_MS);
  return { key: keyOf(d), label: i === 0 ? 'اليوم' : i === 1 ? 'غداً' : weekDays[d.getUTCDay()], day: d.getUTCDate(), rating: f.fishRating };
});
const engineCfg = {
  cons: constituents, lat: port.lat, lon: port.lon, today: localDateStr,
  min: keyOf(viewDays[0].date), max: keyOf(viewLast.date),
  offsets: viewDays.map(d => getTimezoneOffset(port.timezone, d.date)),
  tz: tzOffset,
  yearMax: calSummary ? { [CAL.year]: calSummary.yearMax, [year]: stats.maxRange } : { [year]: stats.maxRange },
  calYear: CAL.year,
};
const todayMajors = solunar.periods.filter(p => p.type === 'major').sort((a, b) => a.start.localeCompare(b.start));

// Nearby ports (within 400 km), with their next high tide kept current by LiveTides and today's rating
type Place = { id: string; name_ar: string; name_en: string; country: string; lat: number; lon: number };
const toRad = (x: number) => (x * Math.PI) / 180;
const distKm = (a: { lat: number; lon: number }, b: { lat: number; lon: number }) => {
  const s = Math.sin(toRad(b.lat - a.lat) / 2) ** 2 + Math.cos(toRad(a.lat)) * Math.cos(toRad(b.lat)) * Math.sin(toRad(b.lon - a.lon) / 2) ** 2;
  return 2 * 6371 * Math.asin(Math.sqrt(s));
};
const nearby = await Promise.all((placesIndex as Place[])
  .filter(p => p.id !== port.id)
  .map(p => ({ ...p, km: distKm(port, p) }))
  .filter(p => p.km <= 400)
  .sort((a, b) => a.km - b.km)
  .slice(0, 4)
  .map(async p => {
    const data = (await import(`../../data/places/${p.id}.json`)).default;
    const cons = data.constituents as Record<string, { amp: number; phase: number }>;
    const tz = getTimezoneOffset(data.timezone, now), day = portDay(now, tz);
    const ex = [...dayExtremes(cons, day, tz), ...dayExtremes(cons, new Date(day.getTime() + DAY_MS), tz)];
    const nextHi = ex.find(e => e.type === 'high' && e.time > now) ?? ex.find(e => e.type === 'high');
    return {
      ...p, km: Math.round(p.km), tz, country: countryName(p.country),
      live: JSON.stringify(ex.map(e => [e.type === 'high' ? 'h' : 'l', e.time.getTime(), formatTime(e.time, tz), Math.round(e.height)])),
      nextHigh: nextHi ? formatTime(nextHi.time, tz) : '—',
      rating: ratingsFrom(cons, day, 1, tz)[0].rating,
    };
  }));

// --- Plain-language summary + FAQ: quotable by search engines and AI assistants
const country = countryName(port.country);
const dateAr = today.toLocaleDateString('ar-EG-u-nu-latn', { timeZone: port.timezone, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const fmtList = (xs: { time: Date; height: number }[]) => xs.map(x => `${formatTime(x.time, tzOffset)} (${x.height.toFixed(0)} سم)`).join('، ');
const todayHighs = extremes.filter(e => e.type === 'high'), todayLows = extremes.filter(e => e.type === 'low');
// Search snippet: other spellings people search with, and today's times (refreshed nightly)
const altAr = altNamesAr(port.id, port.name_ar);
const frName = frenchName(port.id);
const timesAr = (xs: { time: Date }[]) => xs.map(x => formatTime(x.time, tzOffset)).join(' و') || '—';
const fishTodayAr = `حالة الصيد اليوم: ${fishLabels[todayFish.fishRating]}`;
const metaDescription = `المد والجزر في ${nameWithAlts(port.name_ar, [...altAr, port.name_en.replace(/\s*\(.*\)$/, '')])} اليوم: المد العالي ${timesAr(todayHighs)}، والجزر المنخفض ${timesAr(todayLows)}. ${fishTodayAr}. جدول 7 أيام ومعامل المد وأفضل أيام الصيد في ${country}.`;
// Today's major solunar periods, for the summary sentence
const majorsToday = todayPeriods.filter(p => p.type === 'major').map(p => `${p.start}–${p.end}`);
const tideTypeExplain: Record<string, string> = {
  'نصف يومي': 'مدّان عاليان وجزران منخفضان كل يوم تقريباً، بارتفاعات متقاربة',
  'مختلط، نصف يومي غالباً': 'مدّان وجزران في معظم الأيام، لكن بارتفاعات مختلفة بوضوح',
  'مختلط، يومي غالباً': 'مد عالٍ وجزر منخفض واحد في معظم الأيام، وأحياناً اثنان',
  'يومي': 'مد عالٍ واحد وجزر منخفض واحد كل يوم',
};
const maxRangeDateAr = new Date(stats.maxRangeDate + 'T12:00:00Z').toLocaleDateString('ar-EG-u-nu-latn', { day: 'numeric', month: 'long' });
const summary = `${dateAr} في ${port.name_ar} (${country}): المد العالي عند ${fmtList(todayHighs) || '—'}، والجزر المنخفض عند ${fmtList(todayLows) || '—'} بالتوقيت المحلي. حالة الصيد اليوم ${fishLabels[todayFish.fishRating]} (${todayFish.fishRating} من 5)${majorsToday.length ? `، وأفضل أوقاته ${majorsToday.join(' و')}` : ''}. المد هنا ${tideClass.typeAr}، ومدى اليوم ${todayRange} سم (${springNeap.conditionAr}). أقصى مدى متوقع خلال ${year} نحو ${(stats.maxRange / 100).toFixed(1)} م في ${maxRangeDateAr}.`;
// Tomorrow, for "المد والجزر غداً" searches
const tomorrowEx = dayExtremes(constituents, tomorrowDay, tzOffset);
const tomorrowAr = tomorrowDay.toLocaleDateString('ar-EG-u-nu-latn', { timeZone: port.timezone, weekday: 'long', day: 'numeric', month: 'long' });
const tomorrowRating = forecastWithFish[1].fishRating;
const faq = [
  { q: `متى المد والجزر اليوم في ${port.name_ar}؟`,
    a: todayHighs.length ? `اليوم (${dateAr}) المد العالي في ${port.name_ar} عند ${fmtList(todayHighs)}، والجزر المنخفض عند ${fmtList(todayLows)} بالتوقيت المحلي (${port.timezone}).` : 'لا يوجد مد عالٍ اليوم.' },
  { q: `متى المد والجزر غداً في ${port.name_ar}؟`,
    a: `غداً (${tomorrowAr}) المد العالي في ${port.name_ar} عند ${fmtList(tomorrowEx.filter(e => e.type === 'high')) || '—'}، والجزر المنخفض عند ${fmtList(tomorrowEx.filter(e => e.type === 'low')) || '—'} بالتوقيت المحلي. تقييم الصيد غداً ${fishLabels[tomorrowRating]} (${tomorrowRating} من 5).` },
  { q: `ما حالة الصيد اليوم في ${port.name_ar}؟`,
    a: `تقييم الصيد اليوم (${dateAr}) في ${port.name_ar}: ${fishLabels[todayFish.fishRating]} (${todayFish.fishRating} من 5)، ${fishAdvice[todayFish.fishRating]}.${majorsToday.length ? ` أفضل أوقات الصيد (الفترات الكبرى): ${majorsToday.join(' و')} بالتوقيت المحلي.` : ''} يجمع التقييم طور القمر وقوة المد في ذلك اليوم.` },
  { q: `ما نوع المد والجزر في ${port.name_ar}؟`,
    a: `المد في ${port.name_ar} ${tideClass.typeAr}: ${tideTypeExplain[tideClass.typeAr] ?? ''}. معامل الشكل F = ${tideClass.formFactor}.` },
  { q: `ما أكبر فرق بين المد والجزر في ${port.name_ar}؟`,
    a: `أقصى مدى يومي متوقع في ${port.name_ar} خلال ${year} نحو ${(stats.maxRange / 100).toFixed(2)} م (${maxRangeDateAr})، وأقل مدى نحو ${stats.minRange} سم في أيام المد المحاقي.` },
  { q: `ما أفضل أيام الصيد في ${port.name_ar} خلال الأيام القادمة؟`,
    a: bestDays.length ? `حسب تقييم ArabTides (طور القمر وقوة المد ووقوع المد العالي قرب الشروق أو الغروب): ${bestDays.map(d => `${d.day} ${monthNames[d.month]}`).join('، ')}.` : `لا توجد أيام بتقييم جيد أو ممتاز خلال الثلاثين يوماً القادمة.` },
  ...(todayCoef !== null ? [{ q: `ما معامل المد اليوم في ${port.name_ar}؟`,
    a: `معامل المد اليوم (${dateAr}) في ${port.name_ar} هو ${todayCoef}، أي مد ${coefficientLabelAr(todayCoef)}. المعامل من 20 إلى 120، و120 أقوى مد في السنة في هذا الميناء.` }] : []),
  { q: 'هل يمكن استخدام هذه الأوقات للملاحة؟',
    a: 'لا. هذه تقديرات فلكية من نموذج EOT20 العالمي، وليست جداول رسمية للميناء. قد يختلف المد الفعلي بسبب الرياح والضغط الجوي. للملاحة استخدم جداول الهيئة الهيدروغرافية الرسمية.' },
];
const pageJsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: new URL(BASE, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: country, item: new URL(`${BASE}country/${port.country}`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: port.name_ar, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'WebPage', url: pageUrl, name: title, inLanguage: 'ar',
    dateModified: now.toISOString(), description: summary,
    about: {
      '@type': 'Place', name: port.name_ar, alternateName: port.name_en,
      geo: { '@type': 'GeoCoordinates', latitude: port.lat, longitude: port.lon },
      address: { '@type': 'PostalAddress', addressCountry: port.country },
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={title} jsonLd={pageJsonLd} description={metaDescription}>
  <!-- Hero -->
  <section class="hero">
    <div class="max-w-6xl mx-auto px-4 pt-8 pb-20 sm:pb-24">
      <nav class="breadcrumb breadcrumb-light" aria-label="مسار التنقل">
        <a href={BASE}>الرئيسية</a><span class="sep">/</span>
        <a href={`${BASE}country/${port.country}`}>{countryName(port.country)}</a><span class="sep">/</span>
        <span aria-current="page">{port.name_ar}</span>
      </nav>

      <div class="mt-4 flex flex-wrap items-end gap-x-6 gap-y-3">
        <div>
          <h1 class="text-4xl sm:text-5xl display display-heavy leading-tight">{port.name_ar}</h1>
          <p class="mt-2 text-sm text-slate-300">
            <span class="latin" lang="en">{port.name_en}</span>
            <span class="mx-1.5 opacity-50">·</span>{countryName(port.country)}
            <span class="mx-1.5 opacity-50">·</span><span class="latin" lang="en">{formatCoords(port.lat, port.lon)}</span>
          </p>
          {altAr.length > 0 && <p class="mt-1 text-xs text-slate-400">يُكتب أيضاً: {altAr.join('، ')}</p>}
          {port.country === 'IR' && <p class="mt-1 text-xs text-slate-400">على الساحل الإيراني للخليج العربي.</p>}
          {frName && <p class="mt-1 text-xs text-slate-400"><span lang="fr" dir="ltr">Marées à {frName} aujourd'hui : horaires de marée haute et marée basse</span></p>}
        </div>
        <div class="ms-auto flex flex-wrap items-center gap-2 text-xs">
          <span class="hero-chip"><Icon name="calendar" size={14} /> {hijri.day} {hijri.monthAr} {hijri.year} هـ</span>
          <span class="hero-chip"><Fragment set:html={moonIcon(moon.phase, 14)} /> {moon.phaseNameAr} <span class="latin">{Math.round(moon.illumination * 100)}%</span></span>
          <span class="hero-chip"><Icon name="waves" size={14} /> {tideClass.typeAr}</span>
        </div>
      </div>

      <!-- Right now: rising or falling, the height, and time to the next turn (filled by port-day.ts; space reserved) -->
      <p id="now-status" class="now-status"></p>

      <!-- Today at a glance: next tides and the next major solunar period stay current (LiveTides) -->
      <dl class="mt-3 grid grid-cols-2 lg:grid-cols-4 gap-3" data-tides={liveTides} data-tz={tzOffset} data-periods={liveMajors}>
        <div class="hero-stat">
          <dt class="text-xs text-slate-400">▲ المد القادم</dt>
          <dd class="mt-1 text-3xl font-bold latin text-teal-300" data-next="h">{nextHigh ? formatTime(nextHigh.time, tzOffset) : '—'}</dd>
          <dd class="text-xs text-slate-400" data-next-h="h">{nextHigh && <><span class="latin">{nextHigh.height.toFixed(0)}</span> سم</>}</dd>
        </div>
        <div class="hero-stat">
          <dt class="text-xs text-slate-400">▼ الجزر القادم</dt>
          <dd class="mt-1 text-3xl font-bold latin text-rose-300" data-next="l">{nextLow ? formatTime(nextLow.time, tzOffset) : '—'}</dd>
          <dd class="text-xs text-slate-400" data-next-h="l">{nextLow && <><span class="latin">{nextLow.height.toFixed(0)}</span> سم</>}</dd>
        </div>
        <div class="hero-stat">
          <dt class="text-xs text-slate-400">تقييم الصيد اليوم</dt>
          <dd class="mt-2"><RatingBadge rating={todayFish.fishRating} size="lg" dark /></dd>
          <dd class="mt-2 text-xs text-slate-400">المدى <span class="latin">{todayRange}</span> سم{todayCoef !== null && <> · <a href={`${BASE}articles/tide-coefficient`} class="hover:text-teal-300">معامل <span class="latin">{todayCoef}</span></a></>}</dd>
        </div>
        <div class="hero-stat">
          <dt class="text-xs text-slate-400">أفضل وقت للصيد</dt>
          <dd class="mt-1 text-3xl font-bold latin text-amber-200" data-period>{nextMajor ? nextMajor.start : '—'}</dd>
          <dd class="text-xs text-slate-400"><span data-period-when>{nextMajor && <>حتى <span class="latin">{nextMajor.end}</span></>}</span> · <a href="#solunar-title" class="hover:text-teal-300">فترة كبرى</a></dd>
        </div>
      </dl>

      <div class="mt-4 flex flex-wrap gap-2 no-print">
        <button type="button" class="hero-action" id="my-port" data-id={port.id} data-name={port.name_ar} aria-pressed="false" title="يظهر أولاً في الصفحة الرئيسية">
          <span data-star class="inline-flex"><Icon name="star" size={15} /></span> <span data-label>اجعله ميناءي</span>
        </button>
        <a class="hero-action" href={`https://wa.me/?text=${encodeURIComponent(`${shareText} ${pageUrl}`)}`} target="_blank" rel="noopener"><Icon name="message" size={15} /> أرسله في واتساب</a>
      </div>
    </div>
    <svg class="hero-waves" viewBox="0 0 1440 72" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 40c120-20 240-30 360-18s240 40 360 36 240-34 360-38 240 18 360 26v26H0z" fill="currentColor" />
    </svg>
  </section>

  <main id="main" class="max-w-6xl mx-auto px-4 w-full mt-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

      <!-- Main column -->
      <div class="lg:col-span-2 space-y-6 min-w-0">

        <!-- Plain-text answer first: the sentence search snippets and AI answers quote -->
        <section class="card p-5 summary-card" aria-labelledby="summary-title">
          <h2 id="summary-title" class="text-sm font-semibold text-[var(--accent-text)]">المد والجزر وحالة الصيد اليوم في {port.name_ar}</h2>
          <p id="summary-text" class="summary-text is-clamped mt-2 text-[0.95rem] leading-relaxed text-[var(--text-secondary)]">{summary}</p>
          <button type="button" class="summary-more no-print" onclick="document.getElementById('summary-text').classList.remove('is-clamped');this.remove()">اقرأ الملخص كاملاً</button>
        </section>

        <!-- Today's tide chart; the tabs redraw it for another day (src/scripts/port-day.ts) -->
        <section id="chart-card" class="card p-5 scroll-mt-20" aria-labelledby="chart-title">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 id="chart-title" class="text-lg font-semibold display">منحنى المد والجزر اليوم</h2>
            <span id="chart-date" class="text-xs text-[var(--text-muted)] latin">{today.toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' })}</span>
            <span class="ms-auto text-xs text-[var(--text-muted)]">بالتوقيت المحلي · الارتفاع بالسنتيمتر</span>
          </div>
          <!-- The week scrolls sideways on phones -->
          <div class="day-bar no-print">
            <div class="day-tabs" role="group" aria-label="اختر اليوم">
              {dayTabs.map((t, i) => (
                <button type="button" class="day-tab" data-day={t.key} aria-pressed={i === 0 ? 'true' : 'false'} style={`--rating:${fishColors[t.rating]}`}>
                  <span class="d-name">{t.label}</span>
                  <span class="d-num latin">{t.day}</span>
                  <span class="d-bar" style={`opacity:${0.25 + t.rating * 0.15}`} title={`${t.rating}/5 ${fishLabels[t.rating]}`}></span>
                </button>
              ))}
            </div>
          </div>
          <div class="chart-ltr mt-3">
            <svg id="tide-chart" viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="tide-chart w-full h-auto" role="img"
                 aria-label={`منحنى المد والجزر لـ${port.name_ar} اليوم`}
                 data-tz={tzOffset} data-date={localDateStr} data-padl={PAD_L} data-plotw={plotW}>
              <defs>
                <linearGradient id="tideFill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#14b8a6" stop-opacity="0.28" />
                  <stop offset="100%" stop-color="#14b8a6" stop-opacity="0.02" />
                </linearGradient>
              </defs>
              {yTicks.map(v => (
                <>
                  <line x1={PAD_L} y1={yScale(v)} x2={CHART_W - PAD_R} y2={yScale(v)} stroke="#e8ecf0" stroke-width="1" />
                  <text x={PAD_L - 8} y={yScale(v) + 4} text-anchor="end" class="tick">{v.toFixed(0)}</text>
                </>
              ))}
              {[0, 3, 6, 9, 12, 15, 18, 21].map(h => (
                <text x={xHours(h)} y={CHART_H - 8} text-anchor="middle" class={h % 6 ? 'tick tick-minor' : 'tick'}>{String(h).padStart(2, '0')}:00</text>
              ))}
              <path d={`${pathD} L${xHours(24).toFixed(1)},${PAD_T + plotH} L${xHours(0).toFixed(1)},${PAD_T + plotH} Z`} fill="url(#tideFill)" />
              <path d={pathD} fill="none" stroke="#0d9488" stroke-width="2.5" stroke-linejoin="round" />
              <g id="now-marker" style="display:none">
                <line y1={PAD_T - 6} y2={PAD_T + plotH} stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="4 3" />
                <text y={PAD_T - 12} text-anchor="middle" class="now-label">الآن</text>
              </g>
              {extremes.map(ex => {
                const cx = xHours(ex.hours), cy = yScale(ex.height), hi = ex.type === 'high';
                return (
                  <>
                    <circle cx={cx} cy={cy} r="5" fill={hi ? '#0d9488' : '#e11d48'} stroke="#fff" stroke-width="2" />
                    <text x={cx} y={hi ? cy - 13 : cy + 24} text-anchor={cx > CHART_W - PAD_R - 40 ? 'end' : cx < PAD_L + 40 ? 'start' : 'middle'} class="ex-label" fill={hi ? '#0f766e' : '#be123c'}>{formatTime(ex.time, tzOffset)}</text>
                  </>
                );
              })}
            </svg>
          </div>
          <div id="tide-tiles" class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-2">
            {extremes.map(ex => (
              <div class={`rounded-xl px-3 py-2.5 ${ex.type === 'high' ? 'bg-teal-50' : 'bg-rose-50'}`}>
                <div class={`text-xs font-medium ${ex.type === 'high' ? 'text-teal-700' : 'text-rose-700'}`}>{ex.type === 'high' ? '▲ مد عالٍ' : '▼ جزر منخفض'}</div>
                <div class="text-xl font-bold latin mt-0.5">{formatTime(ex.time, tzOffset)}</div>
                <div class="text-xs text-[var(--text-muted)]"><span class="latin">{ex.height.toFixed(0)}</span> سم</div>
              </div>
            ))}
          </div>
          <!-- The chosen day's rating, best hours, sun, moon and coefficient (same markup as port-day.ts factsMarkup) -->
          <div id="day-facts" class="day-facts">
            <RatingBadge rating={todayFish.fishRating} size="sm" />
            {todayMajors.length > 0 && <span class="day-fact"><Icon name="fish" size={14} /> أفضل وقت {todayMajors.map((p, i) => <>{i > 0 && ' و'}<span class="latin">{p.start}–{p.end}</span></>)}</span>}
            <span class="day-fact">الشروق <span class="latin">{sun.sunrise ?? '—'}</span> · الغروب <span class="latin">{sun.sunset ?? '—'}</span></span>
            <span class="day-fact"><Fragment set:html={moonIcon(moon.phase, 14)} /> {moon.phaseNameAr} <span class="latin">{Math.round(moon.illumination * 100)}%</span></span>
            {todayCoef !== null && <span class="day-fact">معامل المد <span class="latin">{todayCoef}</span> · {coefficientLabelAr(todayCoef)}</span>}
          </div>
          <p id="day-more" class="day-more no-print">
            اضغط على المنحنى لترى ارتفاع الماء في أي ساعة. يعرض المنحنى أي يوم حتى <span class="latin">{viewLast.day}</span> {monthNames[viewLast.month]}{!hasCal ? '.' : <>، وتجد كل أيام سنة <span class="latin">{CAL.year}</span> في <a href={`${BASE}calendar?port=${port.id}`} data-track="calendar_cta" data-track-where="day-viewer">تقويم <span class="latin">{CAL.year}</span> {forPort(port.name_ar)}</a>.</>}
          </p>
        </section>

        <!-- Solunar periods: the hours the hero's "best time" comes from -->
        <section class="card p-5" aria-labelledby="solunar-title">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 id="solunar-title" class="text-lg font-semibold display scroll-mt-24">أوقات الصيد اليوم</h2>
            <span class="text-xs text-[var(--text-muted)]">فترات السولونار · بالتوقيت المحلي</span>
          </div>
          {todayPeriods.length > 0 ? (
            <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2">
              {todayPeriods.map(p => (
                <li class:list={['solunar-row', { 'is-major': p.type === 'major' }]}>
                  <span class="latin text-lg font-bold">{p.start} – {p.end}</span>
                  <span class="text-sm">{p.typeAr}</span>
                  <span class={`solunar-q q-${p.quality}`}>{qualityAr[p.quality]}</span>
                </li>
              ))}
            </ul>
          ) : <p class="mt-3 text-sm text-[var(--text-muted)]">لا توجد بيانات</p>}
          <p class="mt-3 text-xs text-[var(--text-muted)] leading-relaxed">الفترة الكبرى ساعتان حول عبور القمر فوق الميناء أو تحته، والصغرى ساعة حول شروقه أو غروبه. وتقوى قرب البدر والمحاق، وإذا وافقت الشروق أو الغروب أو تغيّر المد. <a href={`${BASE}articles/solunar-fishing-hours`} class="text-[var(--accent-text)] underline">كيف تُحسب؟</a></p>
        </section>

        <!-- 7-day forecast -->
        <section class="card overflow-hidden" aria-labelledby="week-title">
          <div class="px-5 pt-5 pb-3 flex flex-wrap items-baseline gap-x-3">
            <h2 id="week-title" class="text-lg font-semibold display">جدول المد والجزر — <span class="latin">7</span> أيام</h2>
            <span class="text-xs text-[var(--text-muted)]">المد والجزر وتقييم الصيد</span>
          </div>
          <ul class="divide-y divide-[var(--border-subtle)]">
            {forecastWithFish.map(day => (
              <li class:list={['week-row px-5 py-4', { 'bg-teal-50/50': day.isToday }]}>
                <div class="flex items-center gap-3">
                  <span class="inline-flex text-slate-400" aria-hidden="true" set:html={moonIcon(day.moon.phase, 24)} />
                  <div>
                    <div class="font-semibold">{day.label}</div>
                    <div class="text-xs text-[var(--text-muted)] latin">{day.dateStr}</div>
                  </div>
                </div>
                <div class="week-fish">
                  <RatingBadge rating={day.fishRating} size="sm" />
                  <div class="text-xs text-[var(--text-muted)] mt-1">المدى <span class="latin">{day.range}</span> سم</div>
                </div>
                {[{ label: '▲ مد', cls: 'text-teal-700', list: day.highs }, { label: '▼ جزر', cls: 'text-rose-700', list: day.lows }].map(col => (
                  <div>
                    <div class={`text-xs font-medium mb-1 ${col.cls}`}>{col.label}</div>
                    <div class="flex flex-wrap gap-x-4 gap-y-1">
                      {[...col.list].sort((a, b) => a.time.getTime() - b.time.getTime()).map(e => (
                        <span class="week-tide"><span class="latin font-semibold">{formatTime(e.time, tzOffset)}</span><span class="text-xs text-[var(--text-muted)]"><span class="latin">{e.height.toFixed(0)}</span> سم</span></span>
                      ))}
                    </div>
                  </div>
                ))}
              </li>
            ))}
          </ul>
        </section>

        <!-- Monthly calendar + fishing summary -->
        <section class="card p-5" aria-labelledby="cal-title">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 id="cal-title" class="text-lg font-semibold display">تقويم الصيد — {monthNames[month]} <span class="latin">{year}</span></h2>
            <span class="text-xs text-[var(--text-muted)]">طور القمر وتقييم كل يوم</span>
          </div>
          <div class="mt-4 grid grid-cols-7 gap-1 sm:gap-1.5 text-center">
            {calWeekdays.map(w => <div class="text-[10px] sm:text-xs text-[var(--text-muted)] pb-1">{w}</div>)}
            {Array.from({ length: leadingBlanks }).map(() => <div></div>)}
            {monthDays.map(d => (
              <button type="button" class={`cal-cell ${d.isToday ? 'cal-today' : ''}`} style={`--rating:${d.fishColor}`} data-day={d.date.toISOString().slice(0, 10)} aria-pressed={d.isToday ? 'true' : 'false'} title={`${d.day} ${monthNames[month]} — ${d.fishLabel}`}>
                <div class="text-xs sm:text-sm font-semibold latin">{d.day}</div>
                <div class="flex justify-center my-0.5 text-slate-400" aria-hidden="true" set:html={moonIcon(d.moon.phase, 15)} />
                <div class="cal-bar" style={`background:${d.fishColor};opacity:${0.25 + d.fishRating * 0.15}`}></div>
              </button>
            ))}
          </div>

          <ul class="rating-key" aria-label="ألوان التقييم">
            {[5, 4, 3, 2, 1].map(r => <li><span style={`background:${fishColors[r]};opacity:${0.25 + r * 0.15}`}></span><span class="latin">{r}</span> {fishLabels[r]}</li>)}
          </ul>

          <div id="day-detail" class="mt-4 rounded-xl border border-[var(--border-subtle)] p-4" data-today={localDateStr} aria-live="polite" hidden>
            <div class="flex items-center gap-2">
              <button type="button" class="day-step" data-step="-1" aria-label="اليوم السابق">→</button>
              <div class="flex-1 text-center">
                <div class="font-semibold" data-f="title"></div>
                <div class="mt-0.5 text-sm font-semibold" data-f="rating"></div>
              </div>
              <button type="button" class="day-step" data-step="1" aria-label="اليوم التالي">←</button>
            </div>
            <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
              <div><dt class="text-xs text-[var(--text-muted)]">المد العالي</dt><dd class="mt-0.5 latin font-semibold" data-f="highs"></dd></div>
              <div><dt class="text-xs text-[var(--text-muted)]">الجزر المنخفض</dt><dd class="mt-0.5 latin font-semibold" data-f="lows"></dd></div>
              <div><dt class="text-xs text-[var(--text-muted)]">الشروق / الغروب</dt><dd class="mt-0.5 latin font-semibold" data-f="sun"></dd></div>
              <div><dt class="text-xs text-[var(--text-muted)]">القمر</dt><dd class="mt-0.5" data-f="moon"></dd></div>
              {todayCoef !== null && <div><dt class="text-xs text-[var(--text-muted)]">معامل المد</dt><dd class="mt-0.5 font-semibold" data-f="coef"></dd></div>}
            </dl>
            <div class="mt-3 flex items-center gap-3">
              <p class="text-xs text-[var(--text-muted)]">اضغط على أي يوم في التقويم لعرض تفاصيله.</p>
              <button type="button" class="day-chart-link ms-auto no-print" data-f="chart"><Icon name="chart" size={14} /> منحنى هذا اليوم</button>
            </div>
          </div>
          <script type="application/json" id="day-data" set:html={JSON.stringify(dayDetails)} />

          <div class="mt-6 rounded-xl bg-[var(--surface-elevated)] p-4">
            <h3 class="font-semibold text-sm inline-flex items-center gap-2"><Icon name="fish" size={16} class="text-[var(--text-muted)]" /> أفضل أيام الصيد القادمة</h3>
            {bestDays.length > 0 ? (
              <div class="mt-3 flex flex-wrap gap-2">
                {bestDays.map(d => (
                  <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white text-sm font-medium border" style={`border-color:${d.fishColor}55;color:${d.fishColor}`}>
                    <span class="latin">{d.day}</span> {monthNames[d.month]}
                    {d.twilight && <span title="مد عالٍ قرب الشروق أو الغروب" aria-label="مد عالٍ قرب الشروق أو الغروب" class="text-amber-600"><Icon name="sunrise" size={14} /></span>}
                    <RatingBadge rating={d.fishRating} size="sm" label={false} />
                  </span>
                ))}
              </div>
            ) : (
              <p class="mt-2 text-sm text-[var(--text-muted)]">لا توجد أيام ممتازة خلال الثلاثين يوماً القادمة</p>
            )}
            {bestDays.some(d => d.twilight) && <p class="mt-2 text-xs text-[var(--text-muted)] inline-flex items-center gap-1.5"><span class="text-amber-600"><Icon name="sunrise" size={14} /></span> مد عالٍ قرب الشروق أو الغروب، وهو من أنشط أوقات الصيد.</p>}
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
              <p class="text-[var(--text-secondary)] leading-relaxed"><strong class="text-[var(--text-primary)]">التفسير:</strong> أفضل الصيد قرب اكتمال القمر (بدر) وميلاده (محاق) — يرتفع المد وتتحرك المياه فتنشط الأسماك على التغذي.</p>
              <p class="text-[var(--text-secondary)] leading-relaxed"><strong class="text-[var(--text-primary)]">القاعدة العملية:</strong> انطلق قبل ساعتين من ذروة المد أو بعدها مباشرة. أثناء الجزر تتركز الأسماك في القنوات العميقة.</p>
            </div>
          </div>
        </section>

        <!-- Fish in this port's sea (Arab seas only) -->
        {!world && <section class="card p-5" aria-labelledby="fish-title">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 id="fish-title" class="text-lg font-semibold display">أسماك {port.name_ar}</h2>
            <span class="text-xs text-[var(--text-muted)]">أنواع تعيش في {seas[portSea[id!]].name}</span>
            <a href={`${BASE}fish`} class="ms-auto text-xs text-[var(--accent-text)] hover:underline">دليل الأسماك ←</a>
          </div>
          <div class="mt-4 grid grid-cols-3 sm:grid-cols-4 gap-2.5">
            {portFish.fish.slice(0, 12).map(f => (
              <a href={`${BASE}fish/${f.id}`} class="rounded-lg overflow-hidden border border-[var(--border-subtle)] group block">
                <img src={`${BASE}fish/sm/${f.id}.webp`} srcset={`${BASE}fish/xs/${f.id}.webp 240w, ${BASE}fish/sm/${f.id}.webp 480w`} sizes="(min-width: 1024px) 170px, (min-width: 640px) 25vw, 33vw" alt={fishLabel(f)} width="480" height="360" loading="lazy" decoding="async" class="fish-thumb" />
                <span class="block px-2 py-1.5 text-xs font-semibold truncate group-hover:text-[var(--accent-text)] transition-colors">
                  {portFish.observed.has(f.id) && <span title="سُجّلت مشاهدته قرب الميناء" class="text-[var(--accent-text)] inline-block align-[-2px] me-1"><Icon name="pin" size={13} /></span>}{f.ar}
                </span>
              </a>
            ))}
          </div>
          <p class="mt-3 text-xs text-[var(--text-muted)] leading-relaxed">
            {portFish.observed.size > 0
              ? <><span class="text-[var(--accent-text)] inline-block align-[-2px]"><Icon name="pin" size={13} /></span> <span class="latin">{portFish.observed.size}</span> من هذه الأنواع سجّل الغواصون والصيادون مشاهدتها في نطاق <span class="latin">50</span> كم من {port.name_ar} على منصة iNaturalist.</>
              : <>الأنواع الشائعة في {seas[portSea[id!]].name}.</>}
            {portFish.fish.length > 12 && <> وأنواع أخرى في <a href={`${BASE}fish`} class="text-[var(--accent-text)] underline">دليل الأسماك</a>.</>}
          </p>
        </section>}

        <!-- Nearby ports: the next page for visitors whose spot is between two ports -->
        {nearby.length > 0 && (
          <section class="card p-5" aria-labelledby="near-title">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 id="near-title" class="text-lg font-semibold display">موانئ قريبة من {port.name_ar}</h2>
              <span class="text-xs text-[var(--text-muted)]">المد العالي القادم وتقييم الصيد اليوم</span>
            </div>
            <div class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-2.5">
              {nearby.map(p => (
                <a href={`${BASE}ports/${p.id}`} class="near-card group" data-tides={p.live} data-tz={p.tz}>
                  <span class="block font-semibold truncate group-hover:text-[var(--accent-text)] transition-colors">{p.name_ar}</span>
                  <span class="block text-xs text-[var(--text-muted)] truncate"><span class="latin">{p.km}</span> كم{p.country !== country && <> · {p.country}</>}</span>
                  <span class="mt-2 flex flex-wrap items-center justify-between gap-1.5">
                    <span class="text-xs text-teal-700">▲ <span class="latin font-bold text-sm" data-next="h">{p.nextHigh}</span></span>
                    <RatingBadge rating={p.rating} size="sm" label={false} />
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class:list={['lg:hidden', { hidden: !hasCal }]}><CalendarPromo variant="strip" port={{ id: id!, name: port.name_ar }} summary={calSummary} /></div>

        <!-- FAQ -->
        <section class="card p-5" aria-labelledby="faq-title">
          <h2 id="faq-title" class="text-lg font-semibold display">أسئلة شائعة عن المد والجزر في {port.name_ar}</h2>
          <div class="mt-3 divide-y divide-[var(--border-subtle)]">
            {faq.map((f, i) => (
              <details class="faq py-3" open={i === 0}>
                <summary class="flex items-center gap-3 cursor-pointer font-medium list-none">
                  <span class="faq-icon" aria-hidden="true">+</span>{f.q}
                </summary>
                <p class="mt-2 ps-9 text-sm leading-relaxed text-[var(--text-secondary)]">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6 min-w-0">
        <div class:list={['hidden', { 'lg:block': hasCal }]}><CalendarPromo variant="card" port={{ id: id!, name: port.name_ar }} summary={calSummary} /></div>

        <section class="card p-5" aria-labelledby="sun-title">
          <h2 id="sun-title" class="font-semibold inline-flex items-center gap-2"><span class="text-[var(--text-muted)]"><Icon name="sun" size={18} /></span> الشمس والقمر</h2>
          <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
            <div class="info-tile"><dt>الشروق</dt><dd class="latin">{sun.sunrise || '—'}</dd></div>
            <div class="info-tile"><dt>الغروب</dt><dd class="latin">{sun.sunset || '—'}</dd></div>
            <div class="info-tile"><dt>شروق القمر</dt><dd class="latin">{moonT.moonrise || '—'}</dd></div>
            <div class="info-tile"><dt>غروب القمر</dt><dd class="latin">{moonT.moonset || '—'}</dd></div>
          </dl>
          <div class="mt-3 flex items-center gap-3 rounded-xl bg-[var(--surface-elevated)] p-3">
            <span class="inline-flex text-slate-400" aria-hidden="true" set:html={moonIcon(moon.phase, 32)} />
            <div>
              <div class="font-semibold text-sm">{moon.phaseNameAr}</div>
              <div class="text-xs text-[var(--text-muted)]">الإضاءة <span class="latin">{Math.round(moon.illumination * 100)}%</span> · عمر القمر <span class="latin">{moon.age.toFixed(1)}</span> يوم</div>
            </div>
          </div>
        </section>

        <section class="card p-5" aria-labelledby="prayer-title">
          <h2 id="prayer-title" class="font-semibold inline-flex items-center gap-2"><span class="text-[var(--text-muted)]"><Icon name="clock" size={18} /></span> أوقات الصلاة</h2>
          <dl class="mt-3 grid grid-cols-3 gap-2 text-sm">
            {Object.entries(prayers).map(([name, time]) => (
              <div class="info-tile text-center"><dt>{prayerLabels[name]}</dt><dd class="latin">{time}</dd></div>
            ))}
          </dl>
          <p class="mt-3 text-xs text-[var(--text-muted)]">{world ? 'طريقة رابطة العالم الإسلامي' : 'طريقة أم القرى'} · التاريخ الهجري تقديري وقد يختلف بيوم</p>
        </section>

        <PortMiniMap port={port} />

        <section class="card p-5 no-print" aria-labelledby="share-title">
          <h2 id="share-title" class="font-semibold">شارك الصفحة</h2>
          <div class="mt-3 grid grid-cols-3 gap-2 text-sm">
            <a href={`https://wa.me/?text=${encodeURIComponent(shareText)}%20${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" class="share-btn"><Icon name="message" size={15} /> واتساب</a>
            <button type="button" class="share-btn" id="copy-link" data-url={pageUrl}><Icon name="link" size={15} /> <span data-copy-label>نسخ الرابط</span></button>
            <button type="button" class="share-btn" onclick="window.print()"><Icon name="printer" size={15} /> طباعة</button>
          </div>
        </section>

        <section class="card p-5 text-xs text-[var(--text-muted)] leading-relaxed">
          <p><span class="inline-block align-[-3px] text-amber-600 me-1"><Icon name="alert" size={15} /></span>تقديرات فلكية، لا تُستخدم للملاحة. الارتفاعات فوق أدنى جزر فلكي (<span class="latin">LAT</span>)، وهو صفر جداول المد الرسمية، ومتوسط سطح البحر هنا على <span class="latin">{datumCm}</span> سم فوقه. <a href={`${BASE}disclaimer`} class="text-[var(--accent-text)] underline">إخلاء المسؤولية</a> · <a href={`${BASE}methodology`} class="text-[var(--accent-text)] underline">كيف تعمل الحسابات؟</a></p>
          <p class="mt-2 latin" lang="en">{port.source}</p>
          <details class="mt-3">
            <summary class="cursor-pointer select-none hover:text-[var(--text-primary)]">المركبات التوافقية (<span class="latin">{waves.length}</span>)</summary>
            <table class="mt-2 w-full">
              <thead><tr class="text-[var(--text-secondary)]"><th class="text-start py-1">المركبة</th><th class="text-start py-1">السعة (سم)</th><th class="text-start py-1">الطور (°)</th></tr></thead>
              <tbody class="latin">
                {waves.map(([name, c]) => <tr class="border-t border-[var(--border-subtle)]"><td class="py-1 font-medium">{name}</td><td class="py-1">{c.amp.toFixed(2)}</td><td class="py-1">{c.phase.toFixed(1)}</td></tr>)}
              </tbody>
            </table>
          </details>
        </section>
      </aside>
    </div>
  </main>

  <LiveTides />

  <!-- Day viewer, scrubbable chart and the "now" line: the site's engine, bundled for the browser -->
  <script type="application/json" id="port-engine" set:html={JSON.stringify(engineCfg)} />
  <script>
    import '../../scripts/port-day';
  </script>

  <!-- "My port": remembered in this browser; the homepage shows it first -->
  <script is:inline>
    (function () {
      var b = document.getElementById('my-port');
      if (!b) return;
      // Recently viewed ports, newest first: the homepage offers them again
      try {
        var R = 'arabtides.recent', recent = JSON.parse(localStorage.getItem(R) || '[]');
        recent = (Array.isArray(recent) ? recent : []).filter(function (x) { return x && x.id && x.id !== b.dataset.id; });
        recent.unshift({ id: b.dataset.id, name: b.dataset.name });
        localStorage.setItem(R, JSON.stringify(recent.slice(0, 6)));
      } catch (e) {}
      var KEY = 'arabtides.myPort', saved = null;
      try { saved = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) {}
      function paint(on) {
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.querySelector('[data-label]').textContent = on ? 'ميناءي' : 'اجعله ميناءي';
      }
      paint(!!saved && saved.id === b.dataset.id);
      b.addEventListener('click', function () {
        var on = b.getAttribute('aria-pressed') !== 'true';
        try {
          if (on) localStorage.setItem(KEY, JSON.stringify({ id: b.dataset.id, name: b.dataset.name }));
          else localStorage.removeItem(KEY);
        } catch (e) {}
        paint(on);
      });
    })();
  </script>

  <!-- "Now" marker on today's chart, in the port's local time; copy-link button -->
  <script is:inline>
    (function () {
      var svg = document.getElementById('tide-chart');
      var g = document.getElementById('now-marker');
      if (!svg || !g) return;
      var tz = parseFloat(svg.dataset.tz), local = new Date(Date.now() + tz * 60000);
      if (local.toISOString().slice(0, 10) !== svg.dataset.date) return;
      var hours = local.getUTCHours() + local.getUTCMinutes() / 60;
      var x = parseFloat(svg.dataset.padl) + hours / 24 * parseFloat(svg.dataset.plotw);
      g.querySelector('line').setAttribute('x1', x);
      g.querySelector('line').setAttribute('x2', x);
      g.querySelector('text').setAttribute('x', x);
      g.style.display = '';
    })();
    (function () {
      // Calendar day details: tap a day or step with the arrows (this month and next)
      var box = document.getElementById('day-detail'), src = document.getElementById('day-data');
      if (!box || !src) return;
      var days = JSON.parse(src.textContent), idx = {}, cur = 0;
      days.forEach(function (d, i) { idx[d.key] = i; });
      var cells = document.querySelectorAll('.cal-cell[data-day]');
      var prev = box.querySelector('[data-step="-1"]'), next = box.querySelector('[data-step="1"]');
      function f(n) { return box.querySelector('[data-f="' + n + '"]'); }
      function tides(list) {
        return list.length ? list.map(function (e) {
          return '<span class="inline-block me-3">' + e[0] + ' <span class="text-xs font-normal text-[var(--text-muted)]">' + e[1] + ' سم</span></span>';
        }).join('') : '—';
      }
      function show(i) {
        cur = Math.max(0, Math.min(days.length - 1, i));
        var d = days[cur], r = f('rating');
        f('title').textContent = d.title;
        r.textContent = d.rating + '/5 · ' + d.label; r.style.color = d.color;
        f('highs').innerHTML = tides(d.highs);
        f('lows').innerHTML = tides(d.lows);
        f('sun').textContent = d.sun;
        f('moon').textContent = d.moon;
        if (d.coef != null && f('coef')) f('coef').textContent = d.coef + ' · ' + (d.coef >= 95 ? 'قوي جداً' : d.coef >= 70 ? 'قوي' : d.coef >= 45 ? 'متوسط' : 'ضعيف');
        cells.forEach(function (c) { c.setAttribute('aria-pressed', c.dataset.day === d.key ? 'true' : 'false'); });
        prev.disabled = cur === 0; next.disabled = cur === days.length - 1;
      }
      cells.forEach(function (c) {
        c.addEventListener('click', function () {
          show(idx[c.dataset.day]);
          box.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        });
      });
      prev.addEventListener('click', function () { show(cur - 1); });
      next.addEventListener('click', function () { show(cur + 1); });
      // Draw this day's curve in the chart card (port-day.ts listens)
      var chartBtn = box.querySelector('[data-f="chart"]');
      if (chartBtn) chartBtn.addEventListener('click', function () {
        document.dispatchEvent(new CustomEvent('port:day', { detail: days[cur].key }));
      });
      show(idx[box.dataset.today] != null ? idx[box.dataset.today] : 0);
      box.hidden = false;
    })();
    (function () {
      var btn = document.getElementById('copy-link');
      if (!btn || !navigator.clipboard) return;
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(btn.dataset.url).then(function () {
          var l = btn.querySelector('[data-copy-label]'), old = l.textContent; l.textContent = 'تم النسخ';
          setTimeout(function () { l.textContent = old; }, 1800);
        });
      });
    })();
  </script>

</BaseLayout>
