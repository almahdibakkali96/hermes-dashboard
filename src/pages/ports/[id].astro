---
import BaseLayout from '../../layouts/BaseLayout.astro';
import placesIndex from '../../data/places/places_index.json';
import {
  generateTideCurve, findExtremes, formatTime,
  classifyTide, getTimezoneOffset
} from '../../lib/tides';
import { moonPhase, sunTimes, moonTimes, solunarPeriods } from '../../lib/astronomy';
import { calculatePrayerTimes, gregorianToHijri } from '../../lib/prayer';

export function getStaticPaths() {
  return placesIndex.map((p: { id: string }) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');

const portModule = await import(`../../data/places/${id}.json`);
const port = portModule.default;

const countryNames: Record<string, string> = {
  AE: 'الإمارات', BH: 'البحرين', DJ: 'جيبوتي', DZ: 'الجزائر',
  EG: 'مصر', IQ: 'العراق', JO: 'الأردن', KM: 'جزر القمر',
  KW: 'الكويت', LB: 'لبنان', LY: 'ليبيا', MA: 'المغرب',
  MR: 'موريتانيا', OM: 'عُمان', PS: 'فلسطين', QA: 'قطر',
  SA: 'السعودية', SD: 'السودان', SO: 'الصومال', SY: 'سوريا',
  TN: 'تونس', YE: 'اليمن',
};

const constituents = port.constituents as Record<string, { amp: number; phase: number }>;

const today = new Date();
const tzOffset = getTimezoneOffset(port.timezone, today);

const sun = sunTimes(today, port.lat, port.lon, tzOffset);
const moonT = moonTimes(today, port.lat, port.lon, tzOffset);

const prayers = calculatePrayerTimes(today, port.lat, port.lon, tzOffset, 'UmmAlQura');
const hijri = gregorianToHijri(today);

const weekDays = ['الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];

// Pre-compute full tide curves + chart params for all 7 days
const CHART_W=720,CHART_H=200,PAD_L=40,PAD_R=10,PAD_T=10,PAD_B=22,plotW=CHART_W-PAD_L-PAD_R,plotH=CHART_H-PAD_T-PAD_B;

const allDays: { label:string; dateStr:string; curve:{hours:number;height:number}[]; extremes:{type:'high'|'low';hours:number;height:number;time:Date}[]; pathD:string; yMin:number; yMax:number; yRange:number; highs:{time:Date;hours:number;height:number}[]; lows:{time:Date;hours:number;height:number}[]; range:string; moon:ReturnType<typeof moonPhase>; moonLabel:string; moonPct:number; dateLabel:string }[] = [];
for (let i = 0; i < 7; i++) {
  const d = new Date(today); d.setDate(d.getDate() + i);
  const c = generateTideCurve(constituents, d, tzOffset);
  const ex = findExtremes(c);
  const hs = ex.filter(e => e.type === 'high').sort((a,b) => b.height - a.height);
  const ls = ex.filter(e => e.type === 'low').sort((a,b) => a.height - b.height);
  const heights = c.map(p => p.height);
  const yMin = Math.min(...heights), yMax = Math.max(...heights), yRange = yMax - yMin || 1;
  const yScale = (h:number) => PAD_T + plotH - ((h - yMin) / yRange) * plotH;
  const xScale = (idx:number) => PAD_L + (idx / (c.length - 1)) * plotW;
  const pathD = c.map((p,idx) => `${idx===0?'M':'L'}${xScale(idx).toFixed(1)},${yScale(p.height).toFixed(1)}`).join(' ');
  const m = moonPhase(d);
  allDays.push({
    label: i===0?'اليوم':weekDays[d.getDay()],
    dateStr: d.toLocaleDateString('en-GB',{day:'numeric',month:'short'}),
    curve: c, extremes: ex, pathD, yMin, yMax, yRange,
    highs: hs, lows: ls,
    range: hs.length&&ls.length?(hs[0].height-ls[0].height).toFixed(0):'—',
    moon: m, moonLabel: m.phaseNameAr, moonPct: Math.round(m.illumination*100),
    dateLabel: d.toLocaleDateString('en-GB')
  });
}

// Today-only references for initial render
const day0 = allDays[0];
const forecast = allDays; // alias — used in the table

const moon = day0.moon;
const solunar = solunarPeriods(moonT.moonrise, moonT.moonset, moonT.lunarTransit, moon.phase, today);

const tideClass = classifyTide(constituents);
const title=`${port.name_ar} — مواقيت المد والجزر`;
const shareText=encodeURIComponent(`مواقيت المد والجزر — ${port.name_ar}`);
const shareUrl=encodeURIComponent(`https://prompt-tempest-on6uicu.vercel.app/ports/${port.id}`);
const monthNames=['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];

// Monthly calendar
const year = today.getFullYear(), month = today.getMonth();
const daysInMonth = new Date(year, month+1, 0).getDate();
const monthDays = Array.from({length: daysInMonth}, (_,i) => {
  const d = new Date(year, month, i+1);
  const c = generateTideCurve(constituents, d, tzOffset);
  const ex = findExtremes(c);
  const hs = ex.filter(e=>e.type==='high'), ls = ex.filter(e=>e.type==='low');
  return { day: i+1, range: hs.length&&ls.length?Math.max(...hs.map(h=>h.height))-Math.min(...ls.map(l=>l.height)):0, moon: moonPhase(d), isToday: i+1===today.getDate() };
});

// Embed all 7 days as JSON for client-side switching (only what JS needs)
const daysJSON = JSON.stringify(allDays.map(d => ({
  pathD: d.pathD, yMin: d.yMin, yMax: d.yMax, yRange: d.yRange,
  extremes: d.extremes.map(ex => ({ type: ex.type, hours: ex.hours, height: ex.height, timeStr: formatTime(ex.time, tzOffset) })),
  highs: d.highs.slice(0,4).map(ex => ({ timeStr: formatTime(ex.time, tzOffset), height: ex.height })),
  lows: d.lows.slice(0,4).map(ex => ({ timeStr: formatTime(ex.time, tzOffset), height: ex.height })),
  moonLabel: d.moonLabel, moonPct: d.moonPct, dateLabel: d.dateLabel, range: d.range
})));
---

<BaseLayout title={title} description={`مواقيت المد والجزر لـ${port.name_ar}`}>
  <div class="min-h-screen flex flex-col bg-[var(--surface-page)]">

    <header class="sticky top-0 z-10 backdrop-blur-md bg-white/95 border-b border-[var(--border-subtle)]" style="box-shadow:var(--shadow-sm)">
      <nav class="max-w-4xl mx-auto px-3 py-2 flex items-center gap-2" aria-label="التنقّل الرئيسي">
        <a href={BASE} class="text-[var(--text-muted)] hover:text-[var(--accent)] shrink-0 text-sm" aria-label="العودة إلى الصفحة الرئيسية">&larr;</a>
        <div class="min-w-0"><div class="text-sm font-semibold truncate display">{port.name_ar}</div><div class="text-[10px] text-[var(--text-dim)] latin" lang="en">{port.name_en}</div></div>
        <div class="flex-1"></div>
        <span class="text-sm" aria-hidden="true">{moon.emoji}</span>
        <span class="text-[10px] text-[var(--text-dim)] hidden sm:inline">{hijri.day} {hijri.monthAr}</span>
      </nav>
      <div class="flex overflow-x-auto gap-1 px-3 pb-2 scrollbar-hide" role="list" aria-label="أيام التوقعات" id="day-pills">
        {forecast.map((day,i) => (
          <button type="button" role="listitem" data-index={i}
            class={`day-pill shrink-0 px-3 py-1.5 rounded-lg text-xs text-center min-w-[60px] border-0 cursor-pointer font-[inherit] ${i===0?'bg-[var(--accent)] text-white font-medium':'bg-[var(--surface-elevated)] text-[var(--text-secondary)]'}`}>
            <span class="block">{day.label}</span><span class="block text-[10px] opacity-70 latin" lang="en">{day.dateStr}</span>
          </button>
        ))}
      </div>
    </header>

    <main id="main" class="flex-1 max-w-4xl mx-auto px-3 py-4 w-full">

      <!-- Page title + location -->
      <div class="mb-5">
        <p class="text-xs text-[var(--text-muted)] mb-1">{countryNames[port.country] || port.country}</p>
        <h1 class="text-2xl font-bold display leading-tight">{port.name_ar}</h1>
        <p class="text-[11px] text-[var(--text-dim)] mt-1">
          <span class="latin" lang="en">{port.lat.toFixed(2)}°, {port.lon.toFixed(2)}°</span>
          <span class="mx-1">·</span>{port.timezone}
        </p>
      </div>

      <!-- Location map -->
      <section class="mb-5" aria-label="موقع الميناء على الخريطة">
        <div id="map" class="port-map w-full border border-[var(--border-subtle)]" data-lat={port.lat} data-lon={port.lon} data-name={port.name_ar}></div>
        <p class="text-[10px] text-[var(--text-dim)] mt-1.5 text-center">خريطة الموقع · بيانات &copy; <a href="https://www.openstreetmap.org/copyright" class="underline hover:text-[var(--accent)]" lang="en">OpenStreetMap</a></p>
      </section>

      <!-- Tide chart -->
      <section class="mb-5"><div class="flex items-center gap-2 mb-2">
        <h2 class="text-sm font-semibold">منحنى المد والجزر</h2>
        <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-[var(--accent-muted)] text-[var(--accent)]">{tideClass.typeAr}</span>
        <div class="flex-1"></div><span id="chart-date" class="text-[10px] text-[var(--text-dim)] latin">{day0.dateLabel}</span>
      </div>
      <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-3 overflow-x-auto" style="box-shadow:var(--shadow-sm)"><div class="chart-ltr">
        <svg id="tide-svg" viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="w-full h-auto" role="img" aria-label={`منحنى المد والجزر لـ${port.name_ar}، نوع المد: ${tideClass.typeAr}`}>
          {[0,.25,.5,.75,1].map(f=>{const y=PAD_T+plotH*(1-f);return(<><line x1={PAD_L} y1={y} x2={CHART_W-PAD_R} y2={y} stroke="#e8ecf0" stroke-width=".5"/><text x={PAD_L-4} y={y+4} text-anchor="end" font-size="9" fill="#94a3b8" font-family="Inter,sans-serif">{(day0.yMin+day0.yRange*f).toFixed(0)}</text></>);})}
          {[0,3,6,9,12,15,18,21,24].map(h=><text x={PAD_L + (Math.round(h*day0.curve.length/24) / (day0.curve.length-1)) * plotW} y={CHART_H-4} text-anchor="middle" font-size="9" fill="#94a3b8" font-family="Inter,sans-serif">{h}:00</text>)}
          <line x1={PAD_L} y1={PAD_T+plotH-((0-day0.yMin)/day0.yRange)*plotH} x2={CHART_W-PAD_R} y2={PAD_T+plotH-((0-day0.yMin)/day0.yRange)*plotH} stroke="#cbd5e1" stroke-width=".5" stroke-dasharray="4,3"/>
          <path id="tide-path" d={day0.pathD} fill="none" stroke="#0d9488" stroke-width="2" stroke-linejoin="round"/>
          <path d={`${day0.pathD} L${PAD_L+(plotW).toFixed(1)},${CHART_H-PAD_B} L${PAD_L.toFixed(1)},${CHART_H-PAD_B} Z`} fill="rgba(13,148,136,0.06)"/>
          {day0.extremes.slice(0,6).map(ex=>{const idx=day0.curve.findIndex(p=>Math.abs(p.hours-ex.hours)<.01);const cx=PAD_L+(idx/(day0.curve.length-1))*plotW,cy=PAD_T+plotH-((ex.height-day0.yMin)/day0.yRange)*plotH;return(<><circle cx={cx.toFixed(1)} cy={cy.toFixed(1)} r="3.5" fill={ex.type==='high'?'#0d9488':'#ef4444'} stroke="white" stroke-width="1.5"/><text x={cx.toFixed(1)} y={cy+(ex.type==='high'?-9:14)} text-anchor="middle" font-size="8" fill="#64748b" font-family="Inter,sans-serif">{formatTime(ex.time,tzOffset)}</text></>);})}
        </svg>
      </div></div></section>

      <!-- Quick stats -->
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mb-5 text-center" id="quick-stats">
        {day0.extremes.slice(0,4).map(ex=><div class={`stat-card p-2 rounded-lg border text-xs ${ex.type==='high'?'bg-teal-50 border-teal-200':'bg-red-50 border-red-100'}`}><div class={`${ex.type==='high'?'text-teal-700':'text-red-600'} font-medium`}>{ex.type==='high'?'مد':'جزر'}</div><div class="font-bold latin">{formatTime(ex.time,tzOffset)}</div><div class="text-[10px] text-[var(--text-dim)] latin">{ex.height.toFixed(0)} سم</div></div>)}
        <div class="stat-card p-2 rounded-lg border border-[var(--border-subtle)] text-xs"><div class="text-[var(--text-dim)]">🌙</div><div class="font-bold" id="moon-pct">{day0.moonPct}%</div><div class="text-[10px] text-[var(--text-dim)]" id="moon-label">{day0.moonLabel}</div></div>
        <div class="p-2 rounded-lg border border-[var(--border-subtle)] text-xs"><div class="text-[var(--text-dim)]">🎣</div><div class="font-bold">{solunar.ratingAr}</div><div class="text-[10px] text-[var(--text-dim)]">الصيد</div></div>
      </div>

      <!-- Sun/Moon + Solunar -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
        <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-3"><h3 class="text-xs font-semibold text-[var(--text-muted)] mb-2">☀️🌙 الشمس والقمر</h3>
          <div class="grid grid-cols-2 gap-1.5 text-[11px]">
            <div class="flex justify-between p-1.5 rounded bg-[var(--surface-elevated)]"><span class="text-[var(--text-dim)]">الشروق</span><span class="font-medium latin">{sun.sunrise||'—'}</span></div>
            <div class="flex justify-between p-1.5 rounded bg-[var(--surface-elevated)]"><span class="text-[var(--text-dim)]">الغروب</span><span class="font-medium latin">{sun.sunset||'—'}</span></div>
            <div class="flex justify-between p-1.5 rounded bg-[var(--surface-elevated)]"><span class="text-[var(--text-dim)]">شروق القمر</span><span class="font-medium latin">{moonT.moonrise||'—'}</span></div>
            <div class="flex justify-between p-1.5 rounded bg-[var(--surface-elevated)]"><span class="text-[var(--text-dim)]">غروب القمر</span><span class="font-medium latin">{moonT.moonset||'—'}</span></div>
          </div></div>
        <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-3"><h3 class="text-xs font-semibold text-[var(--text-muted)] mb-2">🎣 أوقات الصيد</h3>
          {solunar.periods.slice(0,4).map(p=><div class={`flex items-center gap-2 p-1.5 rounded text-[11px] ${p.type==='major'?'bg-teal-50':''}`}><span class={`w-1.5 h-1.5 rounded-full shrink-0 ${p.quality==='excellent'?'bg-green-500':p.quality==='good'?'bg-teal-500':'bg-amber-400'}`}></span><span class="font-medium">{p.typeAr}</span><span class="text-[var(--text-dim)] latin ml-auto">{p.start} — {p.end}</span></div>)}
          {solunar.periods.length===0&&<p class="text-[11px] text-[var(--text-dim)]">لا توجد بيانات</p>}
        </div>
      </div>

      <!-- Ad zone -->
      <div class="mb-5 p-4 rounded-xl bg-[var(--surface-elevated)] border border-dashed border-[var(--border-standard)] text-center"><p class="text-[10px] text-[var(--text-dim)] tracking-wide">مساحة إعلانية</p></div>

      <!-- Prayer + Hijri -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
        <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-3"><h3 class="text-xs font-semibold text-[var(--text-muted)] mb-2">🕌 أوقات الصلاة</h3>
          <div class="grid grid-cols-3 gap-1 text-[11px]">
            {Object.entries(prayers).map(([name,time])=>{const labels:Record<string,string>={fajr:'الفجر',sunrise:'الشروق',dhuhr:'الظهر',asr:'العصر',maghrib:'المغرب',isha:'العشاء'};return<div class="p-1.5 rounded bg-[var(--surface-elevated)] text-center"><div class="text-[10px] text-[var(--text-dim)]">{labels[name]}</div><div class="font-medium latin">{time}</div></div>;})}
          </div></div>
        <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-3 flex items-center justify-center gap-4"><div class="text-3xl">📅</div><div class="text-center"><div class="text-lg font-bold">{hijri.day} {hijri.monthAr} {hijri.year} هـ</div><div class="text-[10px] text-[var(--text-dim)] mt-1">تقديري — قد يختلف بيوم</div></div></div>
      </div>

      <!-- 7-day -->
      <section class="mb-5"><h2 class="text-sm font-semibold mb-2">📊 توقعات ٧ أيام</h2>
        <div class="overflow-x-auto rounded-xl border border-[var(--border-subtle)]"><table class="w-full text-xs">
          <thead><tr class="bg-[var(--surface-elevated)] text-[var(--text-muted)]"><th class="text-right px-2 py-2 font-medium">اليوم</th><th class="text-center px-1 w-6">🌙</th><th class="text-center px-1">المدى</th><th class="text-right px-2" colspan="2">المد</th><th class="text-right px-2" colspan="2">الجزر</th></tr></thead>
          <tbody class="divide-y divide-[var(--border-subtle)]">{forecast.map((day,i)=><tr class={`${i===0?'bg-teal-50/60':''} hover:bg-[var(--surface-elevated)]`}><td class="px-2 py-1.5"><div class="font-medium">{day.label}</div><div class="text-[10px] text-[var(--text-dim)] latin">{day.dateStr}</div></td><td class="text-center px-1 py-1.5 text-sm">{day.moon.emoji}</td><td class="text-center px-1 py-1.5 latin font-medium">{day.range} سم</td><td class="px-1 py-1.5" colspan="2">{day.highs.map(h=><div class="flex gap-1"><span class="text-teal-600 font-medium latin w-10 text-right">{formatTime(h.time,tzOffset)}</span><span class="text-[var(--text-dim)] latin">{h.height.toFixed(0)}</span></div>)}</td><td class="px-1 py-1.5" colspan="2">{day.lows.map(l=><div class="flex gap-1"><span class="text-red-500 font-medium latin w-10 text-right">{formatTime(l.time,tzOffset)}</span><span class="text-[var(--text-dim)] latin">{l.height.toFixed(0)}</span></div>)}</td></tr>)}</tbody>
        </table></div>
      </section>

      <!-- Share -->
      <div class="flex flex-wrap items-center gap-2 mb-5 text-xs">
        <button onclick="window.print()" class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-[var(--border-standard)] text-[var(--text-secondary)] hover:bg-[var(--surface-elevated)] transition-colors">🖨️ طباعة</button>
        <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener" class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-[var(--border-standard)] text-[var(--text-secondary)] hover:bg-[var(--surface-elevated)] transition-colors">💬 واتساب</a>
        <a href={`${BASE}methodology`} class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-[var(--border-standard)] text-[var(--text-secondary)] hover:bg-[var(--surface-elevated)] transition-colors mr-auto">📖 كيف تعمل الحسابات؟</a>
      </div>

      <!-- Ad zone 2 -->
      <div class="mb-5 p-4 rounded-xl bg-[var(--surface-elevated)] border border-dashed border-[var(--border-standard)] text-center"><p class="text-[10px] text-[var(--text-dim)] tracking-wide">مساحة إعلانية</p></div>

      <!-- Monthly calendar -->
      <section class="mb-5"><h2 class="text-sm font-semibold mb-2">📅 تقويم {monthNames[month]} {year}</h2>
        <div class="overflow-x-auto rounded-xl border border-[var(--border-subtle)]"><table class="w-full text-[10px]">
          <thead><tr class="bg-[var(--surface-elevated)] text-[var(--text-muted)]"><th class="p-1">السبت</th><th class="p-1">الجمعة</th><th class="p-1">الخميس</th><th class="p-1">الأربعاء</th><th class="p-1">الثلاثاء</th><th class="p-1">الإثنين</th><th class="p-1">الأحد</th></tr></thead>
          <tbody>{(()=>{const fd=new Date(year,month,1).getDay();const off=(6-fd)%7;const wks:number[][]=[];let wk:number[]=Array(off).fill(0);for(let d=1;d<=daysInMonth;d++){wk.push(d);if(wk.length===7||d===daysInMonth){while(wk.length<7)wk.push(0);wks.push(wk);wk=[]}}return wks.map(w=><tr class="divide-x divide-[var(--border-subtle)] border-t border-[var(--border-subtle)]">{w.map(day=>{if(day===0)return<td class="p-1.5 text-center"></td>;const d=monthDays[day-1];return<td class={`p-1.5 text-center ${d.isToday?'bg-teal-50 ring-1 ring-teal-300 ring-inset':''}`}><div class={`font-medium ${d.isToday?'text-[var(--accent)]':'text-[var(--text-primary)]'}`}>{day}</div><div class="text-[9px]">{d.moon.emoji}</div><div class={`text-[9px] latin ${d.isToday?'text-teal-700':'text-[var(--text-dim)]'}`}>{d.range>0?d.range.toFixed(0):'—'}</div></td>})}</tr>)})()}</tbody>
        </table></div>
      </section>

      <!-- Constituents -->
      <details class="mb-5 group"><summary class="flex items-center gap-2 cursor-pointer text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors select-none"><span class="text-[10px] transition-transform group-open:rotate-90">&#9654;</span>المركبات التوافقية (17)</summary>
        <div class="mt-2 overflow-x-auto rounded-lg border border-[var(--border-subtle)]"><table class="w-full text-xs"><thead class="bg-[var(--surface-elevated)] text-[var(--text-muted)]"><tr><th class="text-right px-3 py-1.5">المركبة</th><th class="text-right px-3 py-1.5 latin">السعة (سم)</th><th class="text-right px-3 py-1.5 latin">الطور (&deg;)</th></tr></thead><tbody class="divide-y divide-[var(--border-subtle)]">{Object.entries(constituents).map(([name,c]:[string,{amp:number;phase:number}])=><tr class="hover:bg-[var(--surface-elevated)]"><td class="px-3 py-1.5 font-medium latin">{name}</td><td class="px-3 py-1.5 text-[var(--text-secondary)] latin">{c.amp.toFixed(2)}</td><td class="px-3 py-1.5 text-[var(--text-secondary)] latin">{c.phase.toFixed(1)}</td></tr>)}</tbody></table></div>
      </details>

      <div class="border-t border-[var(--border-subtle)] pt-3 text-[10px] text-[var(--text-dim)] leading-relaxed">
        <p>⚠️ تقديرات فلكية. <a href={`${BASE}disclaimer`} class="text-[var(--accent)] hover:underline">إخلاء المسؤولية</a>. المصدر: {port.source}</p>
      </div>
    </main>
  </div>

  <!-- 7-day chart data embed -->
  <script is:inline define:vars={{ daysJSON }}>
    (function () {
      var days = JSON.parse(daysJSON), cur = 0;
      if (!days.length) return;

      function swDay(idx) {
        cur = idx; var d = days[idx];
        // pills
        document.querySelectorAll('.day-pill').forEach(function (btn, i) {
          btn.className = btn.className.replace(/bg-\[[^\]]+\]\s+text-\[^\s]+/g, '').replace(/\s+/g,' ');
          if (i === idx) { btn.className += ' bg-[var(--accent)] text-white font-medium'; }
          else { btn.className += ' bg-[var(--surface-elevated)] text-[var(--text-secondary)]'; }
        });
        // date label
        var cd = document.getElementById('chart-date'); if (cd) cd.textContent = d.dateLabel;
        // SVG — rebuild the chart
        var svg = document.getElementById('tide-svg'); if (!svg) return;
        var ns = 'http://www.w3.org/2000/svg';
        while (svg.firstChild) svg.removeChild(svg.firstChild);
        var W=720,H=200,PL=40,PR=10,PT=10,PB=22,pW=W-PL-PR,pH=H-PT-PB;
        // grid lines + Y axis labels
        [0,.25,.5,.75,1].forEach(function(f){
          var y=PT+pH*(1-f), val=Math.round(d.yMin+d.yRange*f);
          var line=document.createElementNS(ns,'line'); line.setAttribute('x1',PL); line.setAttribute('y1',y); line.setAttribute('x2',W-PR); line.setAttribute('y2',y); line.setAttribute('stroke','#e8ecf0'); line.setAttribute('stroke-width','0.5'); svg.appendChild(line);
          var text=document.createElementNS(ns,'text'); text.setAttribute('x',PL-4); text.setAttribute('y',y+4); text.setAttribute('text-anchor','end'); text.setAttribute('font-size','9'); text.setAttribute('fill','#94a3b8'); text.setAttribute('font-family','Inter,sans-serif'); text.textContent=val; svg.appendChild(text);
        });
        // X axis labels
        [0,3,6,9,12,15,18,21,24].forEach(function(h){
          var text=document.createElementNS(ns,'text');
          var x = PL + (h/24) * pW;
          text.setAttribute('x', x); text.setAttribute('y', H-4);
          text.setAttribute('text-anchor','middle'); text.setAttribute('font-size','9');
          text.setAttribute('fill','#94a3b8'); text.setAttribute('font-family','Inter,sans-serif');
          text.textContent=h+':00'; svg.appendChild(text);
        });
        // Zero line
        var zeroY = PT+pH-((0-d.yMin)/d.yRange)*pH;
        var zeroLine=document.createElementNS(ns,'line'); zeroLine.setAttribute('x1',PL); zeroLine.setAttribute('y1',zeroY); zeroLine.setAttribute('x2',W-PR); zeroLine.setAttribute('y2',zeroY); zeroLine.setAttribute('stroke','#cbd5e1'); zeroLine.setAttribute('stroke-width','0.5'); zeroLine.setAttribute('stroke-dasharray','4,3'); svg.appendChild(zeroLine);
        var curve=document.createElementNS(ns,'path'); curve.setAttribute('d',d.pathD); curve.setAttribute('fill','none'); curve.setAttribute('stroke','#0d9488'); curve.setAttribute('stroke-width','2'); curve.setAttribute('stroke-linejoin','round'); svg.appendChild(curve);
        var area=document.createElementNS(ns,'path'); area.setAttribute('d',d.pathD + ' L'+(PL+pW).toFixed(1)+','+(H-PB)+' L'+PL+','+(H-PB)+' Z'); area.setAttribute('fill','rgba(13,148,136,0.06)'); svg.appendChild(area);
        // Extreme markers
        d.extremes.slice(0,6).forEach(function(ex){
          // Reconstruct coordinates from pathD
          var pts = d.pathD.match(/[ML]([\d.]+),([\d.]+)/g);
          if (!pts) return;
          var hStart = ex.hours / 24; // fraction of day
          // Find nearest curve point
          var hFrac = ex.hours / 24;
          var cx = PL + hFrac * pW;
          var cy = PT+pH-((ex.height-d.yMin)/d.yRange)*pH;
          var circle=document.createElementNS(ns,'circle'); circle.setAttribute('cx',cx.toFixed(1)); circle.setAttribute('cy',cy.toFixed(1)); circle.setAttribute('r','3.5'); circle.setAttribute('fill',ex.type==='high'?'#0d9488':'#ef4444'); circle.setAttribute('stroke','white'); circle.setAttribute('stroke-width','1.5'); svg.appendChild(circle);
          var label=document.createElementNS(ns,'text'); label.setAttribute('x',cx.toFixed(1)); label.setAttribute('y',cy+(ex.type==='high'?-9:14)); label.setAttribute('text-anchor','middle'); label.setAttribute('font-size','8'); label.setAttribute('fill','#64748b'); label.setAttribute('font-family','Inter,sans-serif'); label.textContent=ex.timeStr; svg.appendChild(label);
        });
        // Quick stats
        var stats = document.getElementById('quick-stats');
        if (stats) {
          var cards = stats.querySelectorAll('.stat-card');
          // First 4 cards = high/low extremes
          var ex4 = d.highs.slice(0,2).map(function(h){ return {type:'high', timeStr:h.timeStr, height:h.height}; })
                    .concat(d.lows.slice(0,2).map(function(l){ return {type:'low', timeStr:l.timeStr, height:l.height}; }));
          for (var i=0; i<4 && i<cards.length; i++) {
            var card = cards[i], e = ex4[i];
            if (!e) { card.style.display='none'; continue; }
            card.style.display='';
            card.className = card.className.replace(/bg-teal-50 border-teal-200|bg-red-50 border-red-100/,'');
            card.className += ' ' + (e.type==='high'?'bg-teal-50 border-teal-200':'bg-red-50 border-red-100');
            var lines = card.querySelectorAll('div');
            if (lines[0]) { lines[0].className = (e.type==='high'?'text-teal-700':'text-red-600') + ' font-medium'; lines[0].textContent = e.type==='high'?'مد':'جزر'; }
            if (lines[1]) lines[1].textContent = e.timeStr;
            if (lines[2]) lines[2].textContent = e.height.toFixed(0) + ' سم';
          }
          // Moon card (5th): use explicit IDs
          var mp = document.getElementById('moon-pct'), ml = document.getElementById('moon-label');
          if (mp) mp.textContent = d.moonPct + '%';
          if (ml) ml.textContent = d.moonLabel;
        }
      }

      // Wire up pill clicks
      document.getElementById('day-pills').addEventListener('click', function (e) {
        var btn = e.target.closest('.day-pill');
        if (!btn) return;
        var idx = parseInt(btn.getAttribute('data-index'));
        if (!isNaN(idx) && idx >= 0 && idx < days.length) swDay(idx);
      });
    })();
  </script>

  <!-- Leaflet map (client-only, free OSM tiles, no API key) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      function initMap() {
        var el = document.getElementById('map');
        if (!el || typeof L === 'undefined') return;
        var lat = parseFloat(el.dataset.lat), lon = parseFloat(el.dataset.lon);
        var map = L.map(el, { scrollWheelZoom: false, attributionControl: false }).setView([lat, lon], 9);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; OpenStreetMap'
        }).addTo(map);
        L.circleMarker([lat, lon], {
          radius: 8, color: '#0d9488', fillColor: '#0d9488', fillOpacity: 0.6, weight: 2
        }).addTo(map).bindPopup(el.dataset.name);
        // enable scroll-zoom only after click, so page scroll isn't hijacked
        map.on('click', function () { map.scrollWheelZoom.enable(); });
        setTimeout(function () { map.invalidateSize(); }, 200);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMap);
      } else { initMap(); }
    })();
  </script>
</BaseLayout>