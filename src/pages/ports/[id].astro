---
import BaseLayout from '../../layouts/BaseLayout.astro';
import placesIndex from '../../data/places/places_index.json';
import {
  generateTideCurve, findExtremes, formatTime,
  classifyTide, getTimezoneOffset
} from '../../lib/tides';
import { moonPhase, sunTimes, moonTimes, solunarPeriods } from '../../lib/astronomy';
import { calculatePrayerTimes, gregorianToHijri } from '../../lib/prayer';

export function getStaticPaths() {
  return placesIndex.map((p: { id: string }) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');

const portModule = await import(`../../data/places/${id}.json`);
const port = portModule.default;

const countryNames: Record<string, string> = {
  AE: 'الإمارات', BH: 'البحرين', DJ: 'جيبوتي', DZ: 'الجزائر',
  EG: 'مصر', IQ: 'العراق', JO: 'الأردن', KM: 'جزر القمر',
  KW: 'الكويت', LB: 'لبنان', LY: 'ليبيا', MA: 'المغرب',
  MR: 'موريتانيا', OM: 'عُمان', PS: 'فلسطين', QA: 'قطر',
  SA: 'السعودية', SD: 'السودان', SO: 'الصومال', SY: 'سوريا',
  TN: 'تونس', YE: 'اليمن',
};

const constituents = port.constituents as Record<string, { amp: number; phase: number }>;

const today = new Date();
const tzOffset = getTimezoneOffset(port.timezone, today);
const curve = generateTideCurve(constituents, today, tzOffset);
const extremes = findExtremes(curve);
const tideClass = classifyTide(constituents);

const moon = moonPhase(today);
const sun = sunTimes(today, port.lat, port.lon, tzOffset);
const moonT = moonTimes(today, port.lat, port.lon, tzOffset);
const solunar = solunarPeriods(moonT.moonrise, moonT.moonset, moonT.lunarTransit, moon.phase, today);

const prayers = calculatePrayerTimes(today, port.lat, port.lon, tzOffset, 'UmmAlQura');
const hijri = gregorianToHijri(today);

// 7-day forecast — simple data, no per-day charts
const weekDays = ['الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
const forecast = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(today); d.setDate(d.getDate() + i);
  const c = generateTideCurve(constituents, d, tzOffset);
  const ex = findExtremes(c);
  const hs = ex.filter((e: { type: string }) => e.type === 'high').sort((a: { height: number }, b: { height: number }) => b.height - a.height);
  const ls = ex.filter((e: { type: string }) => e.type === 'low').sort((a: { height: number }, b: { height: number }) => a.height - b.height);
  const m = moonPhase(d);
  return {
    label: i===0?'اليوم':weekDays[d.getDay()],
    dateStr: d.toLocaleDateString('en-GB',{day:'numeric',month:'short'}),
    highs: hs.slice(0, 3), lows: ls.slice(0, 3),
    range: hs.length&&ls.length?(hs[0].height-ls[0].height).toFixed(0):'—',
    moon: m, moonPct: Math.round(m.illumination*100),
    isToday: i===0
  };
});

// Monthly calendar — with fish rating
const year = today.getFullYear(), month = today.getMonth();
const daysInMonth = new Date(year, month+1, 0).getDate();
const monthDaysRaw = Array.from({length: daysInMonth}, (_,i) => {
  const d = new Date(year, month, i+1);
  const c = generateTideCurve(constituents, d, tzOffset);
  const ex = findExtremes(c);
  const hs = ex.filter((e: { type: string }) => e.type==='high'), ls = ex.filter((e: { type: string }) => e.type==='low');
  const range = hs.length&&ls.length?Math.max(...hs.map((h: { height: number }) => h.height))-Math.min(...ls.map((l: { height: number }) => l.height)):0;
  const m = moonPhase(d);
  return { day: i+1, range, moon: m, isToday: i+1===today.getDate() };
});

// Fish rating: 1-5 scale.
// Moon score based on lunar age (days since new moon, 0-29.53). Narrow windows around new/full moon.
// Tide score based on daily range relative to month's max.
// Colors: 5=green, 4=teal, 3=amber, 2=orange, 1=red
const maxMonthRange = Math.max(...monthDaysRaw.map(d => d.range), 1);
const fishColors = ['', '#ef4444', '#f97316', '#f59e0b', '#0d9488', '#16a34a'];
const fishLabels = ['', 'ضعيف', 'دون المتوسط', 'متوسط', 'جيد', 'ممتاز'];
const fishAdvice = ['', 'يوم غير مناسب للصيد', 'صيد ضعيف — يفضل التأجيل', 'صيد متوسط — قد تحصل على شيء', 'يوم جيد للصيد', 'يوم ممتاز — أفضل وقت للصيد'];

// Moon score: narrow windows around new moon (age 0-1.5 or 28-29.5) and full moon (age 13.5-16)
const moonScoreFromAge = (age: number) => {
  // Normalize age to 0-29.53
  const a = ((age % 29.53) + 29.53) % 29.53;
  // New moon window: 0-2 or 28-29.53 → score 3
  if (a <= 2 || a >= 28.0) return 3;
  if (a <= 3.5 || a >= 27.0) return 2;
  if (a <= 5 || a >= 25.5) return 1;
  // Full moon window: 13.5-16.5
  if (a >= 13.5 && a <= 16.0) return 3;
  if (a >= 12.5 && a <= 17.0) return 2;
  if (a >= 11.5 && a <= 18.0) return 1;
  return 0;
};

const calcFish = (range: number, moonAge: number) => {
  const moonScore = moonScoreFromAge(moonAge);
  const pct = range / maxMonthRange;
  const tideScore = pct >= 0.8 ? 2 : pct >= 0.5 ? 1 : 0;
  // 1-5 scale
  return Math.max(1, Math.min(5, 1 + moonScore + tideScore));
};

const monthDays = monthDaysRaw.map(d => {
  const fishRating = calcFish(d.range, d.moon.age);
  const emptyFish = '🐟'.repeat(5 - fishRating);
  const fullFish = '🐟'.repeat(fishRating);
  return { ...d, fishRating, fullFish, emptyFish, fishColor: fishColors[fishRating], fishLabel: fishLabels[fishRating], fishAdvice: fishAdvice[fishRating] };
});

// Add fish rating to 7-day forecast
const forecastWithFish = forecast.map(d => {
  const fishRating = calcFish(parseFloat(String(d.range)), d.moon.age);
  const emptyFish = '🐟'.repeat(5 - fishRating);
  const fullFish = '🐟'.repeat(fishRating);
  return { ...d, fishRating, fullFish, emptyFish, fishColor: fishColors[fishRating], fishLabel: fishLabels[fishRating], fishAdvice: fishAdvice[fishRating] };
});

// Best fishing days this month for the conclusion
const bestDays = monthDays.filter(d => d.fishRating >= 4).slice(0, 6);
const worstDays = monthDays.filter(d => d.fishRating <= 2).slice(0, 3);

// Today's chart
const CHART_W=720,CHART_H=200,PAD_L=40,PAD_R=10,PAD_T=10,PAD_B=22,plotW=CHART_W-PAD_L-PAD_R,plotH=CHART_H-PAD_T-PAD_B;
const heights=curve.map((p: { height: number }) => p.height),hMin=Math.min(...heights),hMax=Math.max(...heights),hRange=hMax-hMin||1;
const yScale=(h:number)=>PAD_T+plotH-((h-hMin)/hRange)*plotH,xScale=(i:number)=>PAD_L+(i/(curve.length-1))*plotW;
const pathD=curve.map((p: { height: number },i: number)=>`${i===0?'M':'L'}${xScale(i).toFixed(1)},${yScale(p.height).toFixed(1)}`).join(' ');

const title=`${port.name_ar} — مواقيت المد والجزر`;
const monthNames=['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
---

<BaseLayout title={title} description={`مواقيت المد والجزر لـ${port.name_ar}`}>
  <div class="min-h-screen flex flex-col bg-[var(--surface-page)]">

    <header class="sticky top-0 z-10 backdrop-blur-md bg-white/95 border-b border-[var(--border-subtle)]" style="box-shadow:var(--shadow-sm)">
      <nav class="max-w-4xl mx-auto px-3 py-2 flex items-center gap-2" aria-label="التنقّل الرئيسي">
        <a href={BASE} class="text-[var(--text-muted)] hover:text-[var(--accent)] shrink-0 text-sm" aria-label="العودة إلى الصفحة الرئيسية">&larr;</a>
        <div class="min-w-0"><div class="text-sm font-semibold truncate display">{port.name_ar}</div><div class="text-[10px] text-[var(--text-dim)] latin" lang="en">{port.name_en}</div></div>
        <div class="flex-1"></div>
        <span class="text-sm" aria-hidden="true">{moon.emoji}</span>
        <span class="text-[10px] text-[var(--text-dim)] hidden sm:inline">{hijri.day} {hijri.monthAr}</span>
      </nav>
    </header>

    <main id="main" class="flex-1 max-w-4xl mx-auto px-3 py-4 w-full">

      <!-- Page title + location -->
      <div class="mb-5">
        <p class="text-xs text-[var(--text-muted)] mb-1">{countryNames[port.country] || port.country}</p>
        <h1 class="text-2xl font-bold display leading-tight">{port.name_ar}</h1>
        <p class="text-[11px] text-[var(--text-dim)] mt-1">
          <span class="latin" lang="en">{port.lat.toFixed(2)}°, {port.lon.toFixed(2)}°</span>
          <span class="mx-1">·</span>{port.timezone}
        </p>
      </div>

      <!-- Location map -->
      <section class="mb-5" aria-label="موقع الميناء على الخريطة">
        <div id="map" class="port-map w-full border border-[var(--border-subtle)]" data-lat={port.lat} data-lon={port.lon} data-name={port.name_ar}></div>
        <p class="text-[10px] text-[var(--text-dim)] mt-1.5 text-center">خريطة الموقع · بيانات &copy; <a href="https://www.openstreetmap.org/copyright" class="underline hover:text-[var(--accent)]" lang="en">OpenStreetMap</a></p>
      </section>

      <!-- Today's tide chart -->
      <section class="mb-5"><div class="flex items-center gap-2 mb-2">
        <h2 class="text-sm font-semibold">منحنى المد والجزر — اليوم</h2>
        <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-[var(--accent-muted)] text-[var(--accent)]">{tideClass.typeAr}</span>
        <div class="flex-1"></div><span class="text-[10px] text-[var(--text-dim)] latin">{today.toLocaleDateString('en-GB')}</span>
      </div>
      <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-3 overflow-x-auto" style="box-shadow:var(--shadow-sm)"><div class="chart-ltr">
        <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="w-full h-auto" role="img" aria-label={`منحنى المد والجزر لـ${port.name_ar}`}>
          {[0,.25,.5,.75,1].map(f=>{const y=PAD_T+plotH*(1-f);return(<><line x1={PAD_L} y1={y} x2={CHART_W-PAD_R} y2={y} stroke="#e8ecf0" stroke-width=".5"/><text x={PAD_L-4} y={y+4} text-anchor="end" font-size="9" fill="#94a3b8" font-family="Inter,sans-serif">{(hMin+hRange*f).toFixed(0)}</text></>);})}
          {[0,3,6,9,12,15,18,21,24].map((h: number)=><text x={xScale(Math.round(h*curve.length/24))} y={CHART_H-4} text-anchor="middle" font-size="9" fill="#94a3b8" font-family="Inter,sans-serif">{h}:00</text>)}
          <line x1={PAD_L} y1={yScale(0)} x2={CHART_W-PAD_R} y2={yScale(0)} stroke="#cbd5e1" stroke-width=".5" stroke-dasharray="4,3"/>
          <path d={pathD} fill="none" stroke="#0d9488" stroke-width="2" stroke-linejoin="round"/>
          <path d={`${pathD} L${xScale(curve.length-1).toFixed(1)},${CHART_H-PAD_B} L${xScale(0).toFixed(1)},${CHART_H-PAD_B} Z`} fill="rgba(13,148,136,0.06)"/>
          {extremes.slice(0,4).map((ex: { type: string, hours: number, height: number, time: Date })=>{const idx=curve.findIndex((p: { hours: number })=>Math.abs(p.hours-ex.hours)<.01);const cx=xScale(idx>=0?idx:0).toFixed(1),cy=yScale(ex.height).toFixed(1);return(<><circle cx={cx} cy={cy} r="3.5" fill={ex.type==='high'?'#0d9488':'#ef4444'} stroke="white" stroke-width="1.5"/><text x={cx} y={parseFloat(cy)+(ex.type==='high'?-9:14)} text-anchor="middle" font-size="8" fill="#64748b" font-family="Inter,sans-serif">{formatTime(ex.time,tzOffset)}</text></>);})}
        </svg>
      </div></div></section>

      <!-- Quick stats -->
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mb-5 text-center">
        {extremes.slice(0,4).map((ex: { type: string, time: Date, height: number })=><div class={`p-2 rounded-lg border text-xs ${ex.type==='high'?'bg-teal-50 border-teal-200':'bg-red-50 border-red-100'}`}><div class={`${ex.type==='high'?'text-teal-700':'text-red-600'} font-medium`}>{ex.type==='high'?'مد':'جزر'}</div><div class="font-bold latin">{formatTime(ex.time,tzOffset)}</div><div class="text-[10px] text-[var(--text-dim)] latin">{ex.height.toFixed(0)} سم</div></div>)}
        <div class="p-2 rounded-lg border border-[var(--border-subtle)] text-xs"><div class="text-[var(--text-dim)]">🌙</div><div class="font-bold">{Math.round(moon.illumination*100)}%</div><div class="text-[10px] text-[var(--text-dim)]">{moon.phaseNameAr}</div></div>
        <div class="p-2 rounded-lg border border-[var(--border-subtle)] text-xs"><div class="text-[var(--text-dim)]">🎣</div><div class="font-bold">{solunar.ratingAr}</div><div class="text-[10px] text-[var(--text-dim)]">الصيد</div></div>
      </div>

      <!-- Sun/Moon + Solunar -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
        <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-3"><h3 class="text-xs font-semibold text-[var(--text-muted)] mb-2">☀️🌙 الشمس والقمر</h3>
          <div class="grid grid-cols-2 gap-1.5 text-[11px]">
            <div class="flex justify-between p-1.5 rounded bg-[var(--surface-elevated)]"><span class="text-[var(--text-dim)]">الشروق</span><span class="font-medium latin">{sun.sunrise||'—'}</span></div>
            <div class="flex justify-between p-1.5 rounded bg-[var(--surface-elevated)]"><span class="text-[var(--text-dim)]">الغروب</span><span class="font-medium latin">{sun.sunset||'—'}</span></div>
            <div class="flex justify-between p-1.5 rounded bg-[var(--surface-elevated)]"><span class="text-[var(--text-dim)]">شروق القمر</span><span class="font-medium latin">{moonT.moonrise||'—'}</span></div>
            <div class="flex justify-between p-1.5 rounded bg-[var(--surface-elevated)]"><span class="text-[var(--text-dim)]">غروب القمر</span><span class="font-medium latin">{moonT.moonset||'—'}</span></div>
          </div></div>
        <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-3"><h3 class="text-xs font-semibold text-[var(--text-muted)] mb-2">🎣 أوقات الصيد</h3>
          {solunar.periods.slice(0,4).map((p: { type: string, typeAr: string, quality: string, start: string, end: string })=><div class={`flex items-center gap-2 p-1.5 rounded text-[11px] ${p.type==='major'?'bg-teal-50':''}`}><span class={`w-1.5 h-1.5 rounded-full shrink-0 ${p.quality==='excellent'?'bg-green-500':p.quality==='good'?'bg-teal-500':'bg-amber-400'}`}></span><span class="font-medium">{p.typeAr}</span><span class="text-[var(--text-dim)] latin ml-auto">{p.start} — {p.end}</span></div>)}
          {solunar.periods.length===0&&<p class="text-[11px] text-[var(--text-dim)]">لا توجد بيانات</p>}
        </div>
      </div>

      <!-- Ad zone -->
      <div class="mb-5 p-4 rounded-xl bg-[var(--surface-elevated)] border border-dashed border-[var(--border-standard)] text-center"><p class="text-[10px] text-[var(--text-dim)] tracking-wide">مساحة إعلانية</p></div>

      <!-- Prayer + Hijri -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
        <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-3"><h3 class="text-xs font-semibold text-[var(--text-muted)] mb-2">🕌 أوقات الصلاة</h3>
          <div class="grid grid-cols-3 gap-1 text-[11px]">
            {Object.entries(prayers).map(([name,time])=>{const labels:Record<string,string>={fajr:'الفجر',sunrise:'الشروق',dhuhr:'الظهر',asr:'العصر',maghrib:'المغرب',isha:'العشاء'};return<div class="p-1.5 rounded bg-[var(--surface-elevated)] text-center"><div class="text-[10px] text-[var(--text-dim)]">{labels[name]}</div><div class="font-medium latin">{time}</div></div>;})}
          </div></div>
        <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-3 flex items-center justify-center gap-4"><div class="text-3xl">📅</div><div class="text-center"><div class="text-lg font-bold">{hijri.day} {hijri.monthAr} {hijri.year} هـ</div><div class="text-[10px] text-[var(--text-dim)] mt-1">تقديري — قد يختلف بيوم</div></div></div>
      </div>

      <!-- 7-day forecast — main feature for fishermen -->
      <section class="mb-5">
        <h2 class="text-sm font-semibold mb-2">📊 توقعات ٧ أيام للمد والجزر</h2>
        <p class="text-[10px] text-[var(--text-dim)] mb-2">جميع الأوقات محلية. المد = ارتفاع الماء، الجزر = انخفاضه.</p>
        <div class="space-y-3">
          {forecastWithFish.map((day, i) => (
            <div id={`day-${i}`} class={`rounded-xl bg-white border p-3 ${day.isToday?'border-[var(--accent-border)]':'border-[var(--border-subtle)]'}`} style={day.isToday?'box-shadow:var(--shadow-md)':''}>
              <div class="flex items-center gap-3 mb-2">
                <span class="text-lg">{day.moon.emoji}</span>
                <div>
                  <div class="text-sm font-semibold">{day.label} <span class="text-[10px] text-[var(--text-dim)] font-normal">{day.moon.phaseNameAr}</span></div>
                  <div class="text-[10px] text-[var(--text-dim)] latin">{day.dateStr} · {day.moonPct}%</div>
                </div>
                <div class="mr-auto text-right">
                  <div class="text-xs"><span style={`color:${day.fishColor}`}>{day.fullFish}</span><span class="opacity-20">{day.emptyFish}</span></div>
                  <div class="text-[9px] font-medium" style={`color:${day.fishColor}`}>{day.fishLabel}</div>
                  <div class="text-[10px] text-[var(--text-dim)] latin">المدى {day.range} سم</div>
                </div>
              </div>
              <div class="text-[10px] mb-2 px-2 py-1 rounded" style={`background:${day.fishColor}14;color:${day.fishColor}`}>{day.fishAdvice}</div>
              <div class="grid grid-cols-2 gap-2 text-[11px]">
                <div>
                  <div class="text-teal-700 font-medium text-[10px] mb-1">🔼 مد (ارتفاع)</div>
                  {day.highs.length > 0 ? day.highs.map((h: { time: Date, height: number })=><div class="flex justify-between py-0.5 px-1.5 rounded bg-teal-50/70 mb-0.5"><span class="latin font-medium">{formatTime(h.time,tzOffset)}</span><span class="latin text-[var(--text-dim)]">{h.height.toFixed(0)} سم</span></div>) : <div class="text-[var(--text-dim)] text-[10px]">—</div>}
                </div>
                <div>
                  <div class="text-red-600 font-medium text-[10px] mb-1">🔽 جزر (انخفاض)</div>
                  {day.lows.length > 0 ? day.lows.map((l: { time: Date, height: number })=><div class="flex justify-between py-0.5 px-1.5 rounded bg-red-50/70 mb-0.5"><span class="latin font-medium">{formatTime(l.time,tzOffset)}</span><span class="latin text-[var(--text-dim)]">{l.height.toFixed(0)} سم</span></div>) : <div class="text-[var(--text-dim)] text-[10px]">—</div>}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Share -->
      <div class="flex flex-wrap items-center gap-2 mb-5 text-xs">
        <button onclick="window.print()" class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-[var(--border-standard)] text-[var(--text-secondary)] hover:bg-[var(--surface-elevated)] transition-colors">🖨️ طباعة</button>
        <a href={`https://wa.me/?text=${encodeURIComponent(`مواقيت المد والجزر — ${port.name_ar}`)}%20${encodeURIComponent(`https://prompt-tempest-on6uicu.vercel.app/ports/${port.id}`)}`} target="_blank" rel="noopener" class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-[var(--border-standard)] text-[var(--text-secondary)] hover:bg-[var(--surface-elevated)] transition-colors">💬 واتساب</a>
        <a href={`${BASE}methodology`} class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-[var(--border-standard)] text-[var(--text-secondary)] hover:bg-[var(--surface-elevated)] transition-colors mr-auto">📖 كيف تعمل الحسابات؟</a>
      </div>

      <!-- Ad zone 2 -->
      <div class="mb-5 p-4 rounded-xl bg-[var(--surface-elevated)] border border-dashed border-[var(--border-standard)] text-center"><p class="text-[10px] text-[var(--text-dim)] tracking-wide">مساحة إعلانية</p></div>

      <!-- Monthly calendar -->
      <section class="mb-5"><h2 class="text-sm font-semibold mb-2">📅 تقويم {monthNames[month]} {year}</h2>
        <div class="overflow-x-auto rounded-xl border border-[var(--border-subtle)]"><table class="w-full text-[10px]">
          <thead><tr class="bg-[var(--surface-elevated)] text-[var(--text-muted)]"><th class="p-1">السبت</th><th class="p-1">الجمعة</th><th class="p-1">الخميس</th><th class="p-1">الأربعاء</th><th class="p-1">الثلاثاء</th><th class="p-1">الإثنين</th><th class="p-1">الأحد</th></tr></thead>
          <tbody>{(()=>{const fd=new Date(year,month,1).getDay();const off=(6-fd)%7;const wks:number[][]=[];let wk:number[]=Array(off).fill(0);for(let d=1;d<=daysInMonth;d++){wk.push(d);if(wk.length===7||d===daysInMonth){while(wk.length<7)wk.push(0);wks.push(wk);wk=[]}}return wks.map(w=><tr class="divide-x divide-[var(--border-subtle)] border-t border-[var(--border-subtle)]">{w.map(day=>{if(day===0)return<td class="p-1.5 text-center"></td>;const d=monthDays[day-1];return<td class={`p-1.5 text-center ${d.isToday?'bg-teal-50 ring-1 ring-teal-300 ring-inset':''}`}><div class={`font-medium ${d.isToday?'text-[var(--accent)]':'text-[var(--text-primary)]'}`}>{day}</div><div class="text-[9px]">{d.moon.emoji}</div><div class="text-[7px] leading-tight"><span style={`color:${d.fishColor}`}>{d.fullFish}</span><span class="opacity-15">{d.emptyFish}</span></div></td>})}</tr>)})()}</tbody>
        </table></div>
      </section>

      <!-- Fishing conclusion -->
      <section class="mb-5">
        <h2 class="text-sm font-semibold mb-2">🎣 خلاصة الصيد لهذا الشهر</h2>
        <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-4" style="box-shadow:var(--shadow-sm)">
          {bestDays.length > 0 ? (
            <div class="mb-3">
              <div class="text-xs font-semibold text-[var(--text-primary)] mb-1.5">✅ أفضل أيام الصيد</div>
              <div class="flex flex-wrap gap-2">
                {bestDays.map(d => (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium" style={`background:${d.fishColor}1a;color:${d.fishColor};border:1px solid ${d.fishColor}40`}>
                    {monthNames[month]} {d.day}
                    <span class="text-[10px]">{d.fullFish}</span>
                  </span>
                ))}
              </div>
            </div>
          ) : null}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-[11px]">
            <div class="p-2.5 rounded-lg bg-[var(--surface-elevated)]">
              <div class="font-semibold text-[var(--text-primary)] mb-1">📖 التفسير</div>
              <p class="text-[var(--text-dim)] leading-relaxed">أفضل الصيد عند اكتمال القمر (بدر) وميلاده (محاق) — قوى الجذب ترفع المد وتحرّك الماء، فتنشط الأسماك على التغذي. الأيام البعيدة عن هذه الفترات يكون الصيد فيها أضعف.</p>
            </div>
            <div class="p-2.5 rounded-lg bg-[var(--surface-elevated)]">
              <div class="font-semibold text-[var(--text-primary)] mb-1">🎯 القاعدة العملية</div>
              <p class="text-[var(--text-dim)] leading-relaxed">انطلق قبل ساعتين من ذروة المد أو بعدها مباشرة. أثناء الجزر المنخفض تتركز الأسماك في القنوات العميقة.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Constituents -->
      <details class="mb-5 group"><summary class="flex items-center gap-2 cursor-pointer text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors select-none"><span class="text-[10px] transition-transform group-open:rotate-90">&#9654;</span>المركبات التوافقية (17)</summary>
        <div class="mt-2 overflow-x-auto rounded-lg border border-[var(--border-subtle)]"><table class="w-full text-xs"><thead class="bg-[var(--surface-elevated)] text-[var(--text-muted)]"><tr><th class="text-right px-3 py-1.5">المركبة</th><th class="text-right px-3 py-1.5 latin">السعة (سم)</th><th class="text-right px-3 py-1.5 latin">الطور (&deg;)</th></tr></thead><tbody class="divide-y divide-[var(--border-subtle)]">{Object.entries(constituents).map(([name,c]: [string, { amp: number, phase: number }])=><tr class="hover:bg-[var(--surface-elevated)]"><td class="px-3 py-1.5 font-medium latin">{name}</td><td class="px-3 py-1.5 text-[var(--text-secondary)] latin">{c.amp.toFixed(2)}</td><td class="px-3 py-1.5 text-[var(--text-secondary)] latin">{c.phase.toFixed(1)}</td></tr>)}</tbody></table></div>
      </details>

      <div class="border-t border-[var(--border-subtle)] pt-3 text-[10px] text-[var(--text-dim)] leading-relaxed">
        <p>⚠️ تقديرات فلكية. <a href={`${BASE}disclaimer`} class="text-[var(--accent)] hover:underline">إخلاء المسؤولية</a>. المصدر: {port.source}</p>
      </div>
    </main>
  </div>

  <!-- Leaflet map -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      function initMap() {
        var el = document.getElementById('map');
        if (!el || typeof L === 'undefined') return;
        var lat = parseFloat(el.dataset.lat), lon = parseFloat(el.dataset.lon);
        var map = L.map(el, { scrollWheelZoom: false, attributionControl: false }).setView([lat, lon], 9);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18, attribution: '&copy; OpenStreetMap'
        }).addTo(map);
        L.circleMarker([lat, lon], {
          radius: 8, color: '#0d9488', fillColor: '#0d9488', fillOpacity: 0.6, weight: 2
        }).addTo(map).bindPopup(el.dataset.name);
        map.on('click', function () { map.scrollWheelZoom.enable(); });
        setTimeout(function () { map.invalidateSize(); }, 200);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMap);
      } else { initMap(); }
    })();
  </script>
</BaseLayout>