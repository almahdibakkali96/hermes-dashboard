---
import BaseLayout from '../layouts/BaseLayout.astro';
import placesIndex from '../data/places/places_index.json';

const countries = [...new Set(placesIndex.map((p: { country: string }) => p.country))].sort();

const countryNames: Record<string, string> = {
  AE: 'الإمارات', BH: 'البحرين', DJ: 'جيبوتي', DZ: 'الجزائر',
  EG: 'مصر', IQ: 'العراق', JO: 'الأردن', KM: 'جزر القمر',
  KW: 'الكويت', LB: 'لبنان', LY: 'ليبيا', MA: 'المغرب',
  MR: 'موريتانيا', OM: 'عُمان', PS: 'فلسطين', QA: 'قطر',
  SA: 'السعودية', SD: 'السودان', SO: 'الصومال', SY: 'سوريا',
  TN: 'تونس', YE: 'اليمن',
};
---

<BaseLayout
  title="المد والجزر العربي"
  description="مواقيت المد والجزر، أوقات الصلاة، التاريخ الهجري، والحسابات الفلكية للموانئ العربية"
>
  <div class="min-h-screen flex flex-col">

    <!-- Top bar: brand + search (Monitor surface: no hero, just tools) -->
    <header class="sticky top-0 z-10 backdrop-blur-md bg-[#0a0f16]/90 border-b border-[rgba(255,255,255,0.06)]">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-4">
        <!-- Brand -->
        <a href="/" class="flex items-center gap-2 shrink-0">
          <span class="text-lg font-semibold text-[var(--text-primary)] tracking-tight">ArabTides</span>
          <span class="text-[var(--text-muted)] text-sm hidden sm:inline">المد والجزر العربي</span>
        </a>

        <!-- Search (fills remaining space) -->
        <div class="flex-1 max-w-sm">
          <input
            type="search"
            id="port-search"
            placeholder="ابحث عن ميناء..."
            autocomplete="off"
            class="w-full px-4 py-2 text-sm rounded-[var(--radius-md)]
                   bg-[var(--surface-input)]
                   border border-[var(--border-standard)]
                   text-[var(--text-primary)]
                   placeholder:text-[var(--text-dim)]
                   focus:outline-none focus:border-[var(--accent)]
                   transition-colors"
          />
        </div>

        <!-- Port count -->
        <span class="text-xs text-[var(--text-dim)] hidden sm:block shrink-0">
          {placesIndex.length} ميناء
        </span>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">

      <!-- Countries: dense grid (Monitor = glanceable) -->
      <section class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <h2 class="text-sm font-medium text-[var(--text-muted)] tracking-wide">الدول</h2>
          <div class="flex-1 h-px bg-[var(--border-subtle)]"></div>
        </div>
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-2">
          {countries.map((code: string) => {
            const count = placesIndex.filter((p: { country: string }) => p.country === code).length;
            return (
              <a
                href={`/country/${code}`}
                class="group block p-3 rounded-[var(--radius-lg)]
                       bg-[var(--surface-card)]
                       border border-[var(--border-subtle)]
                       hover:border-[var(--accent-border)]
                       hover:bg-[var(--surface-elevated)]
                       transition-all duration-150"
              >
                <div class="text-white text-sm font-medium group-hover:text-[var(--accent)] transition-colors">
                  {countryNames[code] || code}
                </div>
                <div class="text-xs text-[var(--text-dim)] mt-1">{count}</div>
              </a>
            );
          })}
        </div>
      </section>

      <!-- All ports: dense table (Monitor = scan, not browse) -->
      <section>
        <div class="flex items-center gap-2 mb-4">
          <h2 class="text-sm font-medium text-[var(--text-muted)] tracking-wide">جميع الموانئ</h2>
          <div class="flex-1 h-px bg-[var(--border-subtle)]"></div>
        </div>

        <div id="ports-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-1.5">
          {placesIndex.map((port: { id: string; name_ar: string; name_en: string; country: string }) => (
            <a
              href={`/ports/${port.id}`}
              data-search={port.name_ar + ' ' + port.name_en + ' ' + (countryNames[port.country] || '')}
              class="flex items-center gap-3 px-4 py-2.5 rounded-[var(--radius-md)]
                     hover:bg-[var(--surface-card)]
                     border border-transparent
                     hover:border-[var(--border-subtle)]
                     transition-all duration-150
                     text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            >
              <span class="text-[var(--accent)] text-xs opacity-60">⚓</span>
              <span class="text-sm font-medium truncate">{port.name_ar}</span>
              <span class="text-xs text-[var(--text-dim)] latin ml-auto truncate hidden sm:inline">{port.name_en}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Empty state when search yields nothing -->
      <div id="no-results" class="hidden text-center py-16 text-[var(--text-dim)]">
        لا توجد نتائج
      </div>

    </main>

    <!-- Footer: minimal, border-defined -->
    <footer class="border-t border-[var(--border-subtle)] mt-12">
      <div class="max-w-6xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[var(--text-dim)]">
        <span>&copy; ArabTides — حسابات فلكية تقديرية</span>
        <span class="latin">EOT20 CC BY 4.0</span>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  const search = document.getElementById('port-search') as HTMLInputElement;
  const list = document.getElementById('ports-list')!;
  const noResults = document.getElementById('no-results')!;
  let visible = 0;

  search?.addEventListener('input', () => {
    const q = search.value.toLowerCase();
    visible = 0;
    list.querySelectorAll<HTMLAnchorElement>('a').forEach(el => {
      const text = (el.dataset.search || '').toLowerCase();
      const match = text.includes(q);
      (el as HTMLElement).style.display = match ? '' : 'none';
      if (match) visible++;
    });
    noResults.classList.toggle('hidden', visible > 0);
  });
</script>