---
import BaseLayout from '../layouts/BaseLayout.astro';
import placesIndex from '../data/places/places_index.json';

const countries = [...new Set(placesIndex.map((p: { country: string }) => p.country))].sort();
---

<BaseLayout
  title="المد والجزر العربي"
  description="مواقيت المد والجزر، أوقات الصلاة، التاريخ الهجري، والحسابات الفلكية للموانئ العربية"
>
  <main class="min-h-screen px-4 py-12 max-w-4xl mx-auto">
    <!-- Header -->
    <header class="text-center mb-16">
      <h1 class="text-4xl font-bold text-white mb-3">🌊 المد والجزر العربي</h1>
      <p class="text-slate-400 text-lg">ArabTides</p>
      <p class="text-slate-500 mt-2 max-w-xl mx-auto">
        مواقيت المد والجزر، أوقات الصلاة، والتاريخ الهجري للموانئ العربية
      </p>
    </header>

    <!-- Search -->
    <div class="mb-12 max-w-md mx-auto">
      <input
        type="search"
        id="port-search"
        placeholder="ابحث عن ميناء..."
        class="w-full px-5 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-500 focus:outline-none focus:border-teal-600 transition"
      />
    </div>

    <!-- Country grid -->
    <section>
      <h2 class="text-xl font-semibold text-white mb-6">تصفح حسب الدولة</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {
          countries.map((code: string) => {
            const ports = placesIndex.filter((p: { country: string }) => p.country === code);
            const countryNames: Record<string, string> = {
              AE: 'الإمارات', BH: 'البحرين', DJ: 'جيبوتي', DZ: 'الجزائر',
              EG: 'مصر', IQ: 'العراق', JO: 'الأردن', KM: 'جزر القمر',
              KW: 'الكويت', LB: 'لبنان', LY: 'ليبيا', MA: 'المغرب',
              MR: 'موريتانيا', OM: 'عُمان', PS: 'فلسطين', QA: 'قطر',
              SA: 'السعودية', SD: 'السودان', SO: 'الصومال', SY: 'سوريا',
              TN: 'تونس', YE: 'اليمن',
            };
            return (
              <a
                href={`/country/${code}`}
                class="block p-4 rounded-xl bg-slate-900 border border-slate-800 hover:border-teal-700 transition text-center"
              >
                <span class="block text-white font-medium">{countryNames[code] || code}</span>
                <span class="block text-slate-500 text-sm mt-1">{ports.length} ميناء</span>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- All ports -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold text-white mb-6">جميع الموانئ</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
        {
          placesIndex.map((port: { id: string; name_ar: string; name_en: string; country: string }) => (
            <a
              href={`/ports/${port.id}`}
              class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-900 transition text-slate-300 hover:text-white"
            >
              <span class="text-teal-500">⚓</span>
              <span>{port.name_ar}</span>
              <span class="text-slate-600 text-sm ltr mr-auto">{port.name_en}</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Footer -->
    <footer class="mt-20 pt-8 border-t border-slate-800 text-center text-slate-600 text-sm">
      <p>ArabTides — حسابات فلكية تقديرية. قد تختلف عن القيم الرسمية.</p>
      <p class="mt-1">البيانات من نموذج EOT20 للمحيطات (CC BY 4.0)</p>
    </footer>
  </main>
</BaseLayout>

<script>
  const search = document.getElementById('port-search') as HTMLInputElement;
  search?.addEventListener('input', () => {
    const q = search.value.toLowerCase();
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/ports/"]').forEach(el => {
      const text = el.textContent?.toLowerCase() || '';
      (el.parentElement as HTMLElement).style.display = text.includes(q) ? '' : 'none';
    });
  });
</script>