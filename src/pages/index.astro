---
import BaseLayout from '../layouts/BaseLayout.astro';
// Arab ports drive the homepage lists and counts; world places get their own section (src/lib/regions.ts)
import { arabPlaces as placesIndex, allPlaces, worldPlaces, zoneOf, zoneNames, type Zone } from '../lib/regions';
import { moonIcon, moonPhase } from '../lib/astronomy';
import Icon, { type IconName } from '../components/Icon.astro';
import { BOARD, boardShape, localDayStart, type Ex } from '../lib/heroBoard';
import { countryName } from '../lib/countries';
import { altNamesAr, frenchName } from '../lib/portNames';
import { articles } from '../lib/articles';
import CalendarPromo from '../components/CalendarPromo.astro';
import LiveTides from '../components/LiveTides.astro';
import Flag from '../components/Flag.astro';
import RatingBadge from '../components/RatingBadge.astro';
import WeekRatings from '../components/WeekRatings.astro';
import PortsMap from '../components/PortsMap.astro';
import { ratingsFrom } from '../lib/fishing';
import { fish, fishLabel } from '../lib/fish';
import {
  generateTideCurve, dayExtremes, formatTime,
  getTimezoneOffset, portDay
} from '../lib/tides';

const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const zones: Zone[] = ['europe', 'africa', 'asia', 'americas', 'oceania'];
const worldCountries = [...new Set(worldPlaces.map(p => p.country))].sort((a, b) => countryName(a).localeCompare(countryName(b), 'ar'));
const countries = [...new Set(placesIndex.map((p: { country: string }) => p.country))]
  .sort((a, b) => countryName(a).localeCompare(countryName(b), 'ar'));

// Featured ports — popular destinations
const featuredIds = ['dubai', 'jeddah', 'casablanca', 'alexandria', 'muscat', 'tunis'];
const featuredPorts = await Promise.all(
  featuredIds.map(async (pid) => {
    const m = await import(`../data/places/${pid}.json`);
    const p = m.default;
    const constituents = p.constituents as Record<string, { amp: number; phase: number }>;
    const now = new Date();
    const tz = getTimezoneOffset(p.timezone, now);
    const today = portDay(now, tz);
    const curve = generateTideCurve(constituents, today, tz);
    const extremes = dayExtremes(constituents, today, tz);
    const nextHigh = extremes.find(e => e.type === 'high' && e.time > now) || extremes.find(e => e.type === 'high');
    const nextLow = extremes.find(e => e.type === 'low' && e.time > now) || extremes.find(e => e.type === 'low');
    // Today's and tomorrow's tides for the live "next" pick (see LiveTides)
    const tomorrow = new Date(today.getTime() + 86400000);
    const liveTides = JSON.stringify([...extremes, ...dayExtremes(constituents, tomorrow, tz)]
      .map(e => [e.type === 'high' ? 'h' : 'l', e.time.getTime(), formatTime(e.time, tz), Math.round(e.height)]));
    // Sparkline of today's curve (120×32 viewBox)
    const hs = curve.map((c: { height: number }) => c.height);
    const lo = Math.min(...hs), hi = Math.max(...hs), span = hi - lo || 1;
    const spark = curve.map((c: { height: number }, i: number) =>
      `${i === 0 ? 'M' : 'L'}${(i / (curve.length - 1) * 120).toFixed(1)},${(30 - (c.height - lo) / span * 28).toFixed(1)}`).join(' ');
    const rating = ratingsFrom(constituents, today, 1, tz)[0].rating;
    return { ...p, nextHigh, nextLow, liveTides, tz, spark, rating, countryName: countryName(p.country) };
  })
);

// This week's fishing days at one well-known port per sea: the moon is shared, the tide range differs
const weekStart = portDay(new Date(), 180); // Makkah date, as the headline
const seaPorts = [
  ['الخليج العربي', 'dubai'], ['بحر العرب', 'muscat'], ['البحر الأحمر', 'jeddah'],
  ['المتوسط', 'alexandria'], ['الأطلسي', 'casablanca'],
];
const weekRows = await Promise.all(seaPorts.map(async ([sea, pid]) => {
  const p = (await import(`../data/places/${pid}.json`)).default;
  const tz = getTimezoneOffset(p.timezone, weekStart);
  return { name: sea, sub: p.name_ar, href: `${BASE}ports/${pid}`, ratings: ratingsFrom(p.constituents, weekStart, 7, tz).map(r => r.rating) };
}));

const moon = moonPhase(new Date());

// Hero tide board: the default port (the visitor's saved port replaces it in the browser, src/scripts/hero-board.ts)
const BOARD_PORT = 'dubai';
const boardData = await (async () => {
  const p = (await import(`../data/places/${BOARD_PORT}.json`)).default;
  const now = new Date(), tz = getTimezoneOffset(p.timezone, now), day = portDay(now, tz);
  const ex: Ex[] = [-1, 0, 1, 2].flatMap(k => dayExtremes(p.constituents, new Date(day.getTime() + k * 86400000), tz))
    .map(e => [e.time.getTime(), e.type === 'high' ? 1 : 0, formatTime(e.time, tz), Math.round(e.height)] as Ex);
  return { id: p.id, name: p.name_ar, country: countryName(p.country), offset: tz, ex };
})();
const board0 = boardShape(boardData.ex, localDayStart(Date.now(), boardData.offset));
// Headline date in Makkah time (UTC+3), the middle of the ports' UTC+0…+4 span
const todayAr = new Date().toLocaleDateString('ar-EG-u-nu-latn', { timeZone: 'Asia/Riyadh', weekday: 'long', day: 'numeric', month: 'long' });

// Full port list for the search dropdown (client-side)
// (alt: other spellings and French names, so «مارتيل», «هرهورة» or «Tanger» find their port)
const searchPorts = allPlaces.map((p: { id: string; name_ar: string; name_en: string; country: string; lat: number; lon: number }) => ({
  id: p.id, name_ar: p.name_ar, name_en: p.name_en, countryName: countryName(p.country), lat: p.lat, lon: p.lon,
  alt: [...altNamesAr(p.id, p.name_ar), frenchName(p.id) || ''].filter(Boolean).join(' '),
}));
const searchPortsJSON = JSON.stringify(searchPorts);

const features: { icon: IconName; title: string; text: string }[] = [
  { icon: 'waves', title: 'منحنى المد والجزر', text: 'ارتفاع الماء ساعة بساعة، وأوقات المد العالي والجزر المنخفض لسبعة أيام وأي يوم من هذا الشهر والشهر القادم' },
  { icon: 'fish', title: 'أوقات الصيد', text: 'تقييم كل يوم من 1 إلى 5، والفترات الرئيسية والثانوية (السولونار)، وتقويم الشهر بأفضل أيامه' },
  { icon: 'moon', title: 'الشمس والقمر', text: 'الشروق والغروب، وشروق القمر وغروبه، وطوره ونسبة إضاءته' },
  { icon: 'clock', title: 'الصلاة والتاريخ الهجري', text: 'مواقيت الصلاة بطريقة أم القرى، والتاريخ الهجري التقديري' },
];
---

<BaseLayout
  title="جدول المد والجزر اليوم وأوقات الصيد في الموانئ العربية"
  description={`جدول المد والجزر اليوم في ${placesIndex.length} ميناءً وشاطئاً من المغرب إلى الخليج، و${worldPlaces.length} مكاناً حول العالم بالعربية: أوقات المد العالي والجزر المنخفض، وأفضل أوقات الصيد، وأطوار القمر ومواقيت الصلاة.`}
>
  <!-- Hero -->
  <section class="hero">
    <div class="max-w-6xl mx-auto px-4 pt-12 pb-24 sm:pt-16 sm:pb-28 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,25rem)] gap-x-12 gap-y-8 items-center">
      <div class="min-w-0">
      <p class="inline-flex items-center gap-2 text-xs text-teal-100 bg-white/10 border border-white/15 rounded-full px-3 py-1">
        <span class="inline-flex" aria-hidden="true" set:html={moonIcon(moon.phase, 14)} />
        <span>{todayAr}</span>
        <span class="opacity-50">·</span>
        <span>{moon.phaseNameAr} <span class="latin">{Math.round(moon.illumination * 100)}%</span></span>
      </p>
      <!-- One unbreakable line each, sized to the screen: the fallback font must not wrap differently, or the hero shifts when the web font arrives -->
      <h1 class="mt-5 text-[clamp(1.6rem,8.6vw,2.25rem)] sm:text-5xl leading-tight display display-heavy max-w-2xl">
        <span class="block whitespace-nowrap">مواقيت المد والجزر</span>
        <span class="block whitespace-nowrap text-teal-300">للموانئ العربية</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-xl leading-relaxed">
        توقعات المد والجزر، أفضل أوقات الصيد، أطوار القمر وأوقات الصلاة لـ<span class="latin">{placesIndex.length}</span> ميناءً وشاطئاً من المحيط الأطلسي إلى الخليج العربي، و<span class="latin">{worldPlaces.length}</span> مكاناً حول العالم.
      </p>

      <!-- Search -->
      <div class="mt-8 max-w-xl relative">
        <label for="port-search" class="sr-only">ابحث عن ميناء</label>
        <input
          type="search"
          id="port-search"
          placeholder="ابحث عن ميناء أو شاطئ أو دولة… مرتيل، جدة، إسطنبول"
          autocomplete="off"
          role="combobox"
          aria-autocomplete="list"
          aria-controls="search-results"
          aria-expanded="false"
          class="w-full ps-5 pe-12 py-4 text-base rounded-2xl
                 bg-white text-[var(--text-primary)]
                 placeholder:text-[var(--text-dim)]
                 focus:outline-none focus:ring-4 focus:ring-teal-300/40
                 shadow-xl shadow-black/20"
        />
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[var(--text-dim)] pointer-events-none" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <div id="search-results" class="absolute z-40 top-full mt-2 w-full hidden rounded-xl bg-white border border-[var(--border-subtle)] shadow-2xl max-h-80 overflow-y-auto text-[var(--text-primary)]"></div>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
        <!-- The visitor's location stays in the browser: it only picks the nearest ports from the list below -->
        <button type="button" id="near-me" class="near-me-btn"><Icon name="locate" size={14} /> <span data-l>أقرب ميناء إليّ</span></button>
        <!-- Returning visitors see the ports they opened last instead (filled from localStorage) -->
        <span class="text-slate-400 text-xs" id="quick-label">الأكثر بحثاً:</span>
        <span id="quick-chips" class="contents">
          {featuredPorts.slice(0, 4).map(p => (
            <a href={`${BASE}ports/${p.id}`} class="quick-chip">{p.name_ar}</a>
          ))}
        </span>
      </div>

      </div>

      <!-- Tide board: the water at one port right now (the visitor's saved port, else the default), drawn by
           src/scripts/hero-board.ts; the build draws the default port so the hero never jumps -->
      <div class="tide-board" data-hero-board data-base={BASE}>
        <div class="tb-head">
          <div class="min-w-0">
            <p class="tb-label" data-label>الآن في</p>
            <a class="tb-name display" data-name href={`${BASE}ports/${boardData.id}`}>{boardData.name}</a>
          </div>
          <span class="tb-country" data-country>{boardData.country}</span>
        </div>
        <p class="tb-now" data-now>&nbsp;</p>
        <svg class="tb-chart" data-chart viewBox={`0 0 ${BOARD.W} ${BOARD.H}`} preserveAspectRatio="none" role="img" aria-label="منحنى ارتفاع الماء اليوم">
          <path class="tb-area" d={board0.area} /><path class="tb-line" d={board0.line} />
          {board0.marks.map(k => <g class={k.high ? 'tb-hi' : 'tb-lo'}><circle cx={k.x} cy={k.y} r="3.5" /><text x={Math.min(BOARD.W - 18, Math.max(18, k.x))} y={k.high ? k.y - 9 : k.y + 17} text-anchor="middle">{k.time}</text></g>)}
        </svg>
        <div class="tb-axis latin" aria-hidden="true"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span></div>
        <a class="tb-go" data-go href={`${BASE}ports/${boardData.id}`}>جدول {boardData.name} كاملاً ←</a>
        <script type="application/json" set:html={JSON.stringify(boardData)} />
      </div>
    </div>
    <svg class="hero-waves" viewBox="0 0 1440 72" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 40c120-20 240-30 360-18s240 40 360 36 240-34 360-38 240 18 360 26v26H0z" fill="currentColor" />
    </svg>
  </section>

  <main id="main" class="max-w-6xl mx-auto px-4 w-full">

    <!-- Live map: every port, rising or falling right now, or today's fishing rating -->
    <section class="mt-6 mb-14" aria-labelledby="map-title">
      <div class="section-title">
        <h2 id="map-title">خريطة الموانئ الآن</h2>
        <p>هل يرتفع الماء أم ينخفض الآن في <span class="latin">{allPlaces.length}</span> مكاناً، بالتوقيت المحلي</p>
      </div>
      <PortsMap />
    </section>

    <!-- This week's best fishing days, one port per sea -->
    <section class="mb-14" aria-labelledby="week-title">
      <div class="section-title">
        <h2 id="week-title">أفضل أيام الصيد هذا الأسبوع</h2>
        <p>تقييم الصيد من <span class="latin">1</span> إلى <span class="latin">5</span> لكل يوم: طور القمر وقوة المد</p>
      </div>
      <div class="card p-4 sm:p-5">
        <WeekRatings start={weekStart} rows={weekRows} />
        <p class="mt-3 text-xs text-[var(--text-muted)] leading-relaxed">التقييم لميناء واحد في كل بحر. يختلف قليلاً بين الموانئ بحسب قوة المد، فافتح صفحة ميناءك أو <a href={`${BASE}#countries`} class="text-[var(--accent-text)] underline">صفحة بلدك</a> لترى أيامه.</p>
      </div>
    </section>

    <!-- Featured ports -->
    <section class="mb-14" aria-labelledby="featured-title">
      <div class="section-title">
        <h2 id="featured-title">موانئ مميزة</h2>
        <p>المد والجزر القادم بالتوقيت المحلي، وتقييم الصيد اليوم</p>
      </div>
      <!-- Two columns on phones: name, today's curve, next high and low -->
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {featuredPorts.map(port => (
          <a href={`${BASE}ports/${port.id}`} class="card port-tile group">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <div class="text-base sm:text-lg display leading-snug truncate group-hover:text-[var(--accent-text)] transition-colors">{port.name_ar}</div>
                <div class="text-[11px] sm:text-xs text-[var(--text-muted)] truncate">{port.countryName}<span class="hidden sm:inline"> · <span class="latin" lang="en">{port.name_en}</span></span></div>
              </div>
              <RatingBadge rating={port.rating} size="sm" label={false} />
            </div>
            <svg viewBox="0 0 120 32" preserveAspectRatio="none" class="port-tile-spark chart-ltr" aria-hidden="true">
              <path d={`${port.spark} L120,32 L0,32 Z`} class="fill" />
              <path d={port.spark} class="line" />
            </svg>
            <div class="flex items-end justify-between gap-2 text-[11px] sm:text-xs" data-tides={port.liveTides} data-tz={port.tz}>
              {port.nextHigh && (
                <div>
                  <div class="text-[var(--text-muted)]">▲ المد</div>
                  <div class="text-base sm:text-xl font-bold text-teal-700 latin leading-tight" data-next="h">{formatTime(port.nextHigh.time, port.tz)}</div>
                </div>
              )}
              {port.nextLow && (
                <div class="text-end">
                  <div class="text-[var(--text-muted)]">▼ الجزر</div>
                  <div class="text-base sm:text-xl font-bold text-rose-600 latin leading-tight" data-next="l">{formatTime(port.nextLow.time, port.tz)}</div>
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Product: the 2027 calendar -->
    <div class="mb-14"><CalendarPromo variant="banner" /></div>

    <!-- Fish guide teaser -->
    <section class="mb-14" aria-labelledby="fish-title">
      <div class="section-title">
        <h2 id="fish-title">دليل الأسماك</h2>
        <p><span class="latin">{fish.length}</span> نوعاً بأسمائها المحلية في كل بلد</p>
        <a href={`${BASE}fish`} class="ms-auto text-sm text-[var(--accent-text)] hover:underline">كل الأسماك ←</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {['hamour', 'kanad', 'sheri', 'dorade', 'seabass', 'coraltrout'].map(fid => {
          const f = fish.find(x => x.id === fid)!;
          return (
            <a href={`${BASE}fish/${f.id}`} class="card overflow-hidden group block">
              <img src={`${BASE}fish/sm/${f.id}.webp`} alt={fishLabel(f)} width="480" height="360" loading="lazy" decoding="async" class="fish-thumb" />
              <span class="block px-3 py-2">
                <span class="block font-semibold text-sm group-hover:text-[var(--accent-text)] transition-colors">{f.ar}</span>
                <span class="block text-xs text-[var(--text-muted)] truncate">{f.local.map(l => l.name).filter(n => n !== f.ar).slice(0, 2).join('، ') || f.en}</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- What each port page offers -->
    <section class="mb-14" aria-labelledby="features-title">
      <div class="section-title">
        <h2 id="features-title">ماذا تجد في صفحة كل ميناء؟</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        {features.map(f => (
          <div class="card p-4 flex gap-3 items-start">
            <div class="w-9 h-9 shrink-0 rounded-lg bg-[var(--accent-muted)] text-[var(--accent-text)] flex items-center justify-center"><Icon name={f.icon} size={18} /></div>
            <div>
              <h3 class="font-semibold">{f.title}</h3>
              <p class="mt-0.5 text-sm text-[var(--text-secondary)] leading-relaxed">{f.text}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="card p-5 mt-4 flex flex-col sm:flex-row sm:items-center gap-3 text-sm">
        <span class="font-semibold shrink-0">مقياس جودة الصيد:</span>
        <div class="flex flex-wrap gap-2">
          {[5, 4, 3, 2, 1].map(r => <RatingBadge rating={r} size="sm" />)}
        </div>
        <a href={`${BASE}methodology`} class="sm:ms-auto text-xs text-[var(--accent-text)] hover:underline shrink-0">كيف نحسبه؟</a>
      </div>
    </section>

    <!-- Articles -->
    <section class="mb-14" aria-labelledby="articles-title">
      <div class="section-title">
        <h2 id="articles-title">مقالات</h2>
        <p>أدلة وأرقام من بياناتنا</p>
        <a href={`${BASE}articles`} class="ms-auto text-sm text-[var(--accent-text)] hover:underline">كل المقالات ←</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {articles.slice(0, 6).map((a, i) => (
          <a href={`${BASE}articles/${a.slug}`} class:list={['card p-5 gap-4 items-start group', i < 4 ? 'flex' : 'hidden md:flex']}>
            <span>
              <span class="block font-semibold leading-snug group-hover:text-[var(--accent-text)] transition-colors">{a.title}</span>
              <span class="block text-sm text-[var(--text-muted)] mt-1 leading-relaxed">{a.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Countries -->
    <section id="countries" class="mb-14 scroll-mt-20" aria-labelledby="countries-title">
      <div class="section-title">
        <h2 id="countries-title">تصفح حسب الدولة</h2>
        <p><span class="latin">{countries.length}</span> دولة</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {countries.map((code: string) => {
          const count = placesIndex.filter((p: { country: string }) => p.country === code).length;
          return (
            <a href={`${BASE}country/${code}`} class="card px-4 py-3 flex items-center justify-between gap-2 group">
              <span class="flex items-center gap-2.5 min-w-0">
                <Flag code={code} size={28} />
                <span class="font-medium group-hover:text-[var(--accent-text)] transition-colors">{countryName(code)}</span>
              </span>
              <span class="text-xs text-[var(--text-muted)] bg-[var(--surface-elevated)] rounded-full px-2 py-0.5 latin">{count}</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Worldwide, in Arabic: places Arab travellers and residents fish from -->
    <section id="world" class="mb-14 scroll-mt-20" aria-labelledby="world-title">
      <div class="section-title">
        <h2 id="world-title">حول العالم بالعربية</h2>
        <p><span class="latin">{worldPlaces.length}</span> مكاناً في <span class="latin">{worldCountries.length}</span> دولة: المد والجزر وأوقات الصيد بالعربية حيث يسافر العرب أو يعيشون</p>
      </div>
      <!-- One block per continent: its countries (flag, name, number of places) link to the country pages -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
        {zones.map(z => (
          <div class="card p-4">
            <h3 class="font-semibold display">{zoneNames[z]} <span class="text-xs font-normal text-[var(--text-muted)] latin">{worldPlaces.filter(p => zoneOf(p) === z).length}</span></h3>
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {worldCountries.filter(c => zoneOf(worldPlaces.find(p => p.country === c)!) === z).map(code => (
                <a href={`${BASE}country/${code}`} class="world-chip inline-flex items-center gap-1.5"><Flag code={code} size={16} />{countryName(code)} <span class="latin text-[var(--text-muted)]">{worldPlaces.filter(p => p.country === code).length}</span></a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- All ports, grouped by country -->
    <section id="ports" class="mb-8 scroll-mt-20" aria-labelledby="ports-title">
      <div class="section-title">
        <h2 id="ports-title">جميع الموانئ</h2>
        <p><span class="latin">{placesIndex.length}</span> ميناءً وشاطئاً عربياً</p>
      </div>
      <details class="all-ports card" id="all-ports">
        <summary class="all-ports-toggle"><span>عرض الموانئ الـ<span class="latin">{placesIndex.length}</span> حسب الدولة</span></summary>
        <div class="p-5 sm:p-6 columns-1 sm:columns-2 lg:columns-3 gap-8">
        {countries.map((code: string) => (
          <div class="break-inside-avoid mb-5">
            <a href={`${BASE}country/${code}`} class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--accent-text)]"><Flag code={code} size={18} />{countryName(code)}</a>
            <ul class="mt-1.5 space-y-0.5">
              {placesIndex.filter((p: { country: string }) => p.country === code).map((port: { id: string; name_ar: string; name_en: string }) => (
                <li>
                  <a href={`${BASE}ports/${port.id}`} class="flex items-baseline gap-2 py-1 text-sm hover:text-[var(--accent-text)] transition-colors">
                    <span>{port.name_ar}</span>
                    <span class="text-[11px] text-[var(--text-muted)] latin" lang="en">{port.name_en}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        </div>
      </details>
    </section>
  </main>
</BaseLayout>


<LiveTides />

<script>
  import '../scripts/hero-board';
</script>

<script is:inline define:vars={{ base: BASE }}>
  (function () {
    // Wide screens show the full port list open; a link to #ports opens it on phones too
    var all = document.getElementById('all-ports');
    function openList() { if (all && location.hash === '#ports') all.open = true; }
    if (all && window.matchMedia('(min-width: 640px)').matches) all.open = true;
    openList(); window.addEventListener('hashchange', openList);

    // The visitor's saved port is shown on the hero's tide board (src/scripts/hero-board.ts)
  })();
</script>

<script type="application/json" id="search-data" set:html={searchPortsJSON}></script>
<script is:inline define:vars={{ base: BASE }}>
  var portsData = [];
  // Search ignores hamza forms, ة/ه, ى/ي, tatweel, harakat and Latin accents (Béjaïa = bejaia)
  function norm(s) {
    // NFD splits أ إ آ ؤ ئ into a letter plus a hamza or madda mark (U+0653…U+0655), removed with the harakat
    return s.toLowerCase().normalize('NFD').replace(/[̀-ًͯ-ٕـ]/g, '')
      .replace(/[أإآٱ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي').replace(/ؤ/g, 'و').replace(/ئ/g, 'ي');
  }
  var searchEl = document.getElementById('port-search');
  var dropdown = document.getElementById('search-results');

  try {
    var raw = document.getElementById('search-data');
    if (raw) portsData = JSON.parse(raw.textContent || '[]');
  } catch(e) {}

  searchEl?.addEventListener('input', function () {
    var q = norm(this.value.trim());
    if (!dropdown) return;
    dropdown.innerHTML = '';
    if (!q || !portsData.length) { dropdown.classList.add('hidden'); this.setAttribute('aria-expanded','false'); return; }
    var matches = [];
    for (var i=0; i<portsData.length; i++) {
      var p = portsData[i];
      var txt = p.txt || (p.txt = norm(p.name_ar + ' ' + p.name_en + ' ' + p.countryName + ' ' + (p.alt || '')));
      if (txt.indexOf(q) !== -1) matches.push(p);
    }
    if (!matches.length) {
      dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-[var(--text-muted)]">لا توجد نتائج</div>';
    } else {
      var html = '';
      for (var j=0; j<Math.min(matches.length, 8); j++) {
        var m = matches[j];
        html += '<a href="' + base + 'ports/' + m.id + '" class="flex items-center gap-3 px-4 py-3 hover:bg-[var(--surface-elevated)] transition-colors text-sm border-b border-[var(--border-subtle)] last:border-0"><span class="font-medium">' + m.name_ar + '</span><span class="text-xs text-[var(--text-muted)]">' + m.countryName + '</span><span class="text-xs text-[var(--text-muted)] latin ms-auto">' + m.name_en + '</span></a>';
      }
      if (matches.length > 8) html += '<div class="px-4 py-2 text-xs text-[var(--text-muted)]">و ' + (matches.length - 8) + ' نتيجة أخرى، اكتب أكثر لتضييق البحث</div>';
      dropdown.innerHTML = html;
    }
    dropdown.classList.remove('hidden');
    this.setAttribute('aria-expanded','true');
  });

  searchEl?.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && dropdown) {
      var first = dropdown.querySelector('a');
      if (first) { e.preventDefault(); window.location.href = first.getAttribute('href'); }
    }
  });
  searchEl?.addEventListener('blur', function () {
    setTimeout(function () { if (dropdown) dropdown.classList.add('hidden'); if (searchEl) searchEl.setAttribute('aria-expanded','false'); }, 200);
  });
  searchEl?.addEventListener('focus', function () {
    if (dropdown && dropdown.children.length) { dropdown.classList.remove('hidden'); this.setAttribute('aria-expanded','true'); }
  });

  // "Nearest port to me": the browser's position, used here only, picks the four nearest ports; the list opens
  // in the search dropdown (absolutely placed, so the page doesn't move)
  (function () {
    var btn = document.getElementById('near-me');
    if (!btn || !dropdown) return;
    var label = btn.querySelector('[data-l]'), idle = label.textContent;
    function rad(x) { return x * Math.PI / 180; }
    function km(aLat, aLon, bLat, bLon) {
      var s = Math.pow(Math.sin(rad(bLat - aLat) / 2), 2) + Math.cos(rad(aLat)) * Math.cos(rad(bLat)) * Math.pow(Math.sin(rad(bLon - aLon) / 2), 2);
      return 2 * 6371 * Math.asin(Math.sqrt(s));
    }
    function open(html) { dropdown.innerHTML = html; dropdown.classList.remove('hidden'); }
    function done() { btn.disabled = false; label.textContent = idle; }
    var fail = '<div class="px-4 py-3 text-sm text-[var(--text-muted)]">لم نتمكن من تحديد موقعك. اكتب اسم ميناءك أو مدينتك في البحث.</div>';
    btn.addEventListener('click', function () {
      if (!navigator.geolocation || !portsData.length) { open(fail); return; }
      btn.disabled = true; label.textContent = 'نحدد موقعك…';
      navigator.geolocation.getCurrentPosition(function (pos) {
        var lat = pos.coords.latitude, lon = pos.coords.longitude;
        var list = portsData.map(function (p) { return { p: p, d: km(lat, lon, p.lat, p.lon) }; })
          .sort(function (a, b) { return a.d - b.d; }).slice(0, 4);
        var html = '<div class="px-4 pt-3 pb-1 text-xs font-semibold text-[var(--text-muted)]">أقرب الموانئ إليك</div>';
        list.forEach(function (x, i) {
          html += '<a href="' + base + 'ports/' + x.p.id + '" class="flex items-center gap-3 px-4 py-3 hover:bg-[var(--surface-elevated)] transition-colors text-sm border-b border-[var(--border-subtle)] last:border-0' + (i === 0 ? ' font-semibold' : '') + '"><span>' + x.p.name_ar + '</span><span class="text-xs text-[var(--text-muted)]">' + x.p.countryName + '</span><span class="text-xs text-[var(--text-muted)] ms-auto"><span class="latin">' + Math.round(x.d) + '</span> كم</span></a>';
        });
        open(html);
        try { if (window.va) window.va('event', { name: 'near_me', data: { port: list[0].p.id, km: Math.round(list[0].d) } }); } catch (e) {}
        try { if (window.gtag) window.gtag('event', 'near_me', { port: list[0].p.id }); } catch (e) {}
        done();
      }, function () { open(fail); done(); }, { timeout: 12000, maximumAge: 600000 });
    });
    // Close the list on a tap outside the search box and the button
    document.addEventListener('click', function (e) {
      if (!dropdown.classList.contains('hidden') && !dropdown.contains(e.target) && e.target !== searchEl && !btn.contains(e.target)) dropdown.classList.add('hidden');
    });
  })();

  // Returning visitors: the ports they opened last replace "most searched" (saved by port pages)
  (function () {
    var recent = [];
    try { recent = JSON.parse(localStorage.getItem('arabtides.recent') || '[]'); } catch (e) {}
    if (!Array.isArray(recent)) return;
    recent = recent.filter(function (x) { return x && /^[a-z0-9-]+$/.test(x.id || '') && typeof x.name === 'string'; }).slice(0, 4);
    var box = document.getElementById('quick-chips'), lbl = document.getElementById('quick-label');
    if (!recent.length || !box || !lbl) return;
    box.textContent = '';
    recent.forEach(function (x) {
      var a = document.createElement('a');
      a.href = base + 'ports/' + x.id; a.className = 'quick-chip'; a.textContent = x.name;
      box.appendChild(a);
    });
    lbl.textContent = 'زرتها مؤخراً:';
  })();
</script>
