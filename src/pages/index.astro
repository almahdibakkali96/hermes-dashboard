---
import BaseLayout from '../layouts/BaseLayout.astro';
import placesIndex from '../data/places/places_index.json';
import buildInfo from '../build.json';
import { moonPhase } from '../lib/astronomy';
import {
  generateTideCurve, findExtremes, formatTime,
  getTimezoneOffset, classifyTide
} from '../lib/tides';

const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const countries = [...new Set(placesIndex.map((p: { country: string }) => p.country))].sort();
const buildNum = String(buildInfo.build).padStart(3, '0');
const buildTime = new Date().toISOString().replace('T', ' ').slice(0, 19) + ' UTC';

const countryNames: Record<string, string> = {
  AE: 'الإمارات', BH: 'البحرين', DJ: 'جيبوتي', DZ: 'الجزائر',
  EG: 'مصر', IQ: 'العراق', JO: 'الأردن', KM: 'جزر القمر',
  KW: 'الكويت', LB: 'لبنان', LY: 'ليبيا', MA: 'المغرب',
  MR: 'موريتانيا', OM: 'عُمان', PS: 'فلسطين', QA: 'قطر',
  SA: 'السعودية', SD: 'السودان', SO: 'الصومال', SY: 'سوريا',
  TN: 'تونس', YE: 'اليمن',
};

// Featured ports — popular destinations
const featuredIds = ['dubai', 'jeddah', 'casablanca', 'alexandria', 'muscat', 'tunis'];
const featuredPorts = await Promise.all(
  featuredIds.map(async (pid) => {
    const m = await import(`../data/places/${pid}.json`);
    const p = m.default;
    const constituents = p.constituents as Record<string, { amp: number; phase: number }>;
    const today = new Date();
    const tz = getTimezoneOffset(p.timezone, today);
    const curve = generateTideCurve(constituents, today, tz);
    const extremes = findExtremes(curve);
    const nextHigh = extremes.find(e => e.type === 'high' && e.hours > today.getHours() + today.getMinutes() / 60) || extremes.find(e => e.type === 'high');
    const nextLow = extremes.find(e => e.type === 'low' && e.hours > today.getHours() + today.getMinutes() / 60) || extremes.find(e => e.type === 'low');
    return { ...p, nextHigh, nextLow, tz, countryName: countryNames[p.country] || p.country };
  })
);

const moon = moonPhase(new Date());

// Lightweight port list for the overview map (client-side)
const mapPorts = placesIndex.map((p: { id: string; name_ar: string; lat: number; lon: number }) => ({
  id: p.id, name: p.name_ar, lat: p.lat, lon: p.lon
}));

// Full port list for the search dropdown (client-side)
const searchPorts = placesIndex.map((p: { id: string; name_ar: string; name_en: string; country: string }) => ({
  id: p.id, name_ar: p.name_ar, name_en: p.name_en, countryName: countryNames[p.country] || p.country
}));
const searchPortsJSON = JSON.stringify(searchPorts);
---

<BaseLayout
  title="المد والجزر العربي"
  description="مواقيت المد والجزر، أوقات الصيد، التاريخ الهجري للموانئ العربية"
>
  <div class="min-h-screen flex flex-col">

    <!-- Hero area -->
    <header class="border-b border-[var(--border-subtle)] bg-gradient-to-b from-teal-50/50 to-white">
      <div class="max-w-6xl mx-auto px-4 py-12 sm:py-18">
        <!-- Top nav -->
        <nav class="flex items-center gap-4 mb-10" aria-label="التنقّل الرئيسي">
          <a href={BASE} class="flex items-center gap-2 shrink-0" aria-label="ArabTides — الصفحة الرئيسية">
            <span class="text-xl font-bold text-[var(--text-primary)] display">ArabTides</span>
          </a>
          <span class="text-xs text-[var(--text-dim)] hidden sm:inline">المد والجزر العربي</span>
          <div class="flex-1"></div>
          <span class="text-xs text-[var(--text-dim)]">{placesIndex.length} ميناء عربي</span>
        </nav>

        <!-- Hero content -->
        <div class="max-w-2xl">
          <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] leading-tight display">
            مواقيت المد والجزر<br/>للموانئ العربية
          </h1>
          <p class="text-[var(--text-secondary)] mt-3 max-w-lg leading-relaxed">
            حسابات فلكية دقيقة للمد والجزر، أوقات الصيد، أطوار القمر، وشروق وغروب الشمس لـ ٣٦ ميناءً عربياً
          </p>
        </div>

        <!-- Search -->
        <div class="mt-6 max-w-md relative">
          <label for="port-search" class="sr-only">ابحث عن ميناء</label>
          <input
            type="search"
            id="port-search"
            placeholder="ابحث عن ميناء... دبي، جدة، الإسكندرية..."
            autocomplete="off"
            aria-controls="search-results"
            aria-expanded="false"
            class="w-full px-5 py-3.5 text-sm rounded-xl
                   bg-white border border-[var(--border-standard)]
                   text-[var(--text-primary)]
                   placeholder:text-[var(--text-dim)]
                   focus:outline-none focus:border-[var(--accent)] focus:ring-3 focus:ring-teal-100
                   shadow-sm transition-all"
          />
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[var(--text-dim)] text-sm" aria-hidden="true">🔍</span>
          <div id="search-results" class="absolute z-20 top-full mt-1 w-full hidden rounded-xl bg-white border border-[var(--border-subtle)] shadow-lg max-h-80 overflow-y-auto"></div>
        </div>

        <!-- Moon widget -->
        <div class="mt-4 flex items-center gap-2 text-xs text-[var(--text-dim)]">
          <span aria-hidden="true">{moon.emoji}</span>
          <span>{moon.phaseNameAr}</span>
          <span class="latin">{Math.round(moon.illumination * 100)}%</span>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">

      <!-- Fishing conclusion — prominent -->
      <section class="mb-12">
        <div class="flex items-center gap-2 mb-5">
          <h2 class="text-base font-semibold text-[var(--text-primary)]">🎣 توقعات الصيد</h2>
          <div class="flex-1 h-px bg-[var(--border-subtle)]"></div>
        </div>
        <div class="rounded-xl bg-white border border-[var(--border-subtle)] p-5 text-sm leading-relaxed" style="box-shadow:var(--shadow-sm)">
          <p class="text-[var(--text-secondary)] mb-4">
            يعتمد تقييم جودة الصيد (🐟 من ١ إلى ٥) على عاملين رئيسيين يؤثران على نشاط الأسماك:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="p-3 rounded-lg bg-[var(--surface-elevated)]">
              <div class="font-semibold text-[var(--text-primary)] mb-1">🌙 طور القمر</div>
              <p class="text-[var(--text-dim)]">يكون الصيد في أفضل حالاته عند اكتمال القمر (بدر) أو ميلاده (محاق)، حيث تكون قوى الجذب في أقصاها ويتحرك الماء بقوة أكبر، مما يحفز الأسماك على التغذي.</p>
            </div>
            <div class="p-3 rounded-lg bg-[var(--surface-elevated)]">
              <div class="font-semibold text-[var(--text-primary)] mb-1">📏 مدى المد والجزر</div>
              <p class="text-[var(--text-dim)]">كلما زاد الفرق بين أعلى مد وأدنى جزر في اليوم، زادت حركة المياه وجرفت معها الغذاء، مما ينشط الأسماك.</p>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap gap-3 text-xs items-center">
            <span class="text-[var(--text-dim)]">المقياس:</span>
            <span style="color:#16a34a">🐟🐟🐟🐟🐟 ممتاز</span>
            <span style="color:#0d9488">🐟🐟🐟🐟 جيد</span>
            <span style="color:#f59e0b">🐟🐟🐟 متوسط</span>
            <span style="color:#f97316">🐟🐟 دون المتوسط</span>
            <span style="color:#ef4444">🐟 ضعيف</span>
          </div>
        </div>
      </section>

      <!-- Featured ports -->
      <section class="mb-12">
        <div class="flex items-center gap-2 mb-5">
          <h2 class="text-base font-semibold text-[var(--text-primary)]">موانئ مميزة</h2>
          <div class="flex-1 h-px bg-[var(--border-subtle)]"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {featuredPorts.map(port => (
            <a href={`${BASE}ports/${port.id}`}
               class="group block rounded-xl bg-white border border-[var(--border-subtle)]
                      hover:border-[var(--accent-border)] hover:shadow-md
                      transition-all duration-200 overflow-hidden">
              <div class="p-4">
                <div class="flex items-start justify-between">
                  <div>
                    <div class="text-[10px] text-[var(--text-dim)] tracking-wide uppercase">{port.countryName}</div>
                    <div class="text-base font-semibold text-[var(--text-primary)] mt-0.5 group-hover:text-[var(--accent)] transition-colors">
                      {port.name_ar}
                    </div>
                    <div class="text-xs text-[var(--text-dim)] latin mt-0.5">{port.name_en}</div>
                  </div>
                  <span class="text-[var(--accent)] opacity-0 group-hover:opacity-100 transition-opacity text-lg">&larr;</span>
                </div>
                <!-- Mini tide info -->
                <div class="flex gap-4 mt-3 pt-3 border-t border-[var(--border-subtle)] text-xs">
                  {port.nextHigh && (
                    <div>
                      <div class="text-[10px] text-[var(--text-dim)]">المد القادم</div>
                      <div class="font-semibold text-[var(--accent)] latin">{formatTime(port.nextHigh.time, port.tz)}</div>
                      <div class="text-[var(--text-dim)] latin">{port.nextHigh.height.toFixed(0)} سم</div>
                    </div>
                  )}
                  {port.nextLow && (
                    <div>
                      <div class="text-[10px] text-[var(--text-dim)]">الجزر القادم</div>
                      <div class="font-semibold text-red-500 latin">{formatTime(port.nextLow.time, port.tz)}</div>
                      <div class="text-[var(--text-dim)] latin">{port.nextLow.height.toFixed(0)} سم</div>
                    </div>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Quick country jump -->
      <section class="mb-12">
        <div class="flex items-center gap-2 mb-4">
          <h2 class="text-base font-semibold text-[var(--text-primary)]">تصفح حسب الدولة</h2>
          <div class="flex-1 h-px bg-[var(--border-subtle)]"></div>
        </div>
        <div class="flex flex-wrap gap-2">
          {countries.map((code: string) => {
            const count = placesIndex.filter((p: { country: string }) => p.country === code).length;
            return (
              <a href={`${BASE}country/${code}`}
                 class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm
                        bg-white border border-[var(--border-standard)]
                        hover:border-[var(--accent-border)] hover:bg-teal-50
                        text-[var(--text-secondary)] hover:text-[var(--accent)]
                        transition-all duration-150">
                <span>{countryNames[code] || code}</span>
                <span class="text-[10px] text-[var(--text-dim)] bg-[var(--surface-elevated)] px-1.5 py-0.5 rounded-full">{count}</span>
              </a>
            );
          })}
        </div>
      </section>

      <!-- All ports — full list -->
      <section class="mb-12">
        <div class="flex items-center gap-2 mb-4">
          <h2 class="text-base font-semibold text-[var(--text-primary)]">جميع الموانئ</h2>
          <span class="text-xs text-[var(--text-dim)]">{placesIndex.length}</span>
          <div class="flex-1 h-px bg-[var(--border-subtle)]"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-1">
          {placesIndex.map((port: { id: string; name_ar: string; name_en: string; country: string }) => (
            <a
              href={`${BASE}ports/${port.id}`}
              class="flex items-center gap-3 px-3 py-2 rounded-lg
                     hover:bg-white hover:shadow-sm
                     border border-transparent hover:border-[var(--border-subtle)]
                     transition-all duration-150
                     text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            >
              <span class="text-[var(--accent)] text-xs">⚓</span>
              <span class="text-sm truncate">{port.name_ar}</span>
              <span class="text-[10px] text-[var(--text-dim)] latin ml-auto truncate hidden sm:inline">{port.name_en}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Ports overview map — bottom -->
      <section class="mb-12" aria-label="خريطة الموانئ">
        <div class="flex items-center gap-2 mb-5">
          <h2 class="text-base font-semibold text-[var(--text-primary)]">خريطة الموانئ</h2>
          <div class="flex-1 h-px bg-[var(--border-subtle)]"></div>
        </div>
        <div id="ports-map" class="port-map w-full border border-[var(--border-subtle)]" style="height:360px"></div>
        <p class="text-[10px] text-[var(--text-dim)] mt-1.5 text-center">بيانات الخريطة &copy; <a href="https://www.openstreetmap.org/copyright" class="underline hover:text-[var(--accent)]" lang="en">OpenStreetMap</a></p>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--border-subtle)] mt-12">
      <div class="max-w-6xl mx-auto px-4 py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-[var(--text-dim)]">
        <span>&copy; ArabTides — حسابات فلكية تقديرية</span>
        <div class="flex items-center gap-3">
          <span class="latin">EOT20 CC BY 4.0</span>
          <span class="px-2 py-0.5 rounded bg-[var(--accent-muted)] text-[var(--accent)] text-[10px] font-mono tracking-wider">
            #{buildNum}
          </span>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<!-- Leaflet overview map (client-only, free OSM tiles) -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline define:vars={{ ports: mapPorts, base: BASE }}>
  (function () {
    function initMap() {
      var el = document.getElementById('ports-map');
      if (!el || typeof L === 'undefined' || !ports.length) return;
      var map = L.map(el, { scrollWheelZoom: false, attributionControl: false });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18, attribution: '&copy; OpenStreetMap'
      }).addTo(map);
      var pts = [];
      ports.forEach(function (p) {
        var m = L.circleMarker([p.lat, p.lon], {
          radius: 5, color: '#0d9488', fillColor: '#0d9488', fillOpacity: 0.65, weight: 1.5
        }).addTo(map);
        m.bindPopup('<a href="' + base + 'ports/' + p.id + '" style="color:#0d9488;font-weight:600">' + p.name + '</a>');
        pts.push([p.lat, p.lon]);
      });
      map.fitBounds(pts, { padding: [30, 30] });
      map.on('click', function () { map.scrollWheelZoom.enable(); });
      setTimeout(function () { map.invalidateSize(); }, 200);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMap);
    } else { initMap(); }
  })();
</script>

<script type="application/json" id="search-data" set:html={searchPortsJSON}></script>
<script is:inline define:vars={{ base: BASE }}>
  var portsData = [];
  var searchEl = document.getElementById('port-search');
  var dropdown = document.getElementById('search-results');

  try {
    var raw = document.getElementById('search-data');
    if (raw) portsData = JSON.parse(raw.textContent || '[]');
  } catch(e) {}

  searchEl?.addEventListener('input', function () {
    var q = this.value.trim().toLowerCase();
    if (!dropdown) return;
    dropdown.innerHTML = '';
    if (!q || !portsData.length) { dropdown.classList.add('hidden'); this.setAttribute('aria-expanded','false'); return; }
    var matches = [];
    for (var i=0; i<portsData.length; i++) {
      var p = portsData[i];
      var txt = (p.name_ar + ' ' + p.name_en + ' ' + p.countryName).toLowerCase();
      if (txt.indexOf(q) !== -1) matches.push(p);
    }
    if (!matches.length) {
      dropdown.innerHTML = '<div class="px-4 py-3 text-xs text-[var(--text-dim)]">لا توجد نتائج</div>';
    } else {
      var html = '';
      for (var j=0; j<Math.min(matches.length, 8); j++) {
        var m = matches[j];
        html += '<a href="' + base + 'ports/' + m.id + '" class="flex items-center gap-3 px-4 py-2.5 hover:bg-[var(--surface-elevated)] transition-colors text-sm"><span class="text-[var(--accent)] text-xs">⚓</span><span>' + m.name_ar + '</span><span class="text-[10px] text-[var(--text-dim)] latin ml-auto">' + m.name_en + '</span><span class="text-[10px] text-[var(--text-dim)]">' + m.countryName + '</span></a>';
      }
      if (matches.length > 8) html += '<div class="px-4 py-2 text-[10px] text-[var(--text-dim)]">و ' + (matches.length - 8) + ' ميناء آخر...</div>';
      dropdown.innerHTML = html;
    }
    dropdown.classList.remove('hidden');
    this.setAttribute('aria-expanded','true');
  });

  searchEl?.addEventListener('blur', function () {
    setTimeout(function () { if (dropdown) dropdown.classList.add('hidden'); if (searchEl) searchEl.setAttribute('aria-expanded','false'); }, 200);
  });
  searchEl?.addEventListener('focus', function () {
    if (dropdown && dropdown.children.length) { dropdown.classList.remove('hidden'); this.setAttribute('aria-expanded','true'); }
  });
</script>