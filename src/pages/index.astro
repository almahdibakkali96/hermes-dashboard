---
import BaseLayout from '../layouts/BaseLayout.astro';
import placesIndex from '../data/places/places_index.json';
import { moonPhase } from '../lib/astronomy';
import { countryName } from '../lib/countries';
import { articles } from '../lib/articles';
import GuidePromo from '../components/GuidePromo.astro';
import Flag from '../components/Flag.astro';
import { fish } from '../lib/fish';
import {
  generateTideCurve, dayExtremes, formatTime,
  getTimezoneOffset
} from '../lib/tides';

const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const countries = [...new Set(placesIndex.map((p: { country: string }) => p.country))]
  .sort((a, b) => countryName(a).localeCompare(countryName(b), 'ar'));

// Featured ports — popular destinations
const featuredIds = ['dubai', 'jeddah', 'casablanca', 'alexandria', 'muscat', 'tunis'];
const featuredPorts = await Promise.all(
  featuredIds.map(async (pid) => {
    const m = await import(`../data/places/${pid}.json`);
    const p = m.default;
    const constituents = p.constituents as Record<string, { amp: number; phase: number }>;
    const today = new Date();
    const tz = getTimezoneOffset(p.timezone, today);
    const curve = generateTideCurve(constituents, today, tz);
    const extremes = dayExtremes(constituents, today, tz);
    const nextHigh = extremes.find(e => e.type === 'high' && e.time > today) || extremes.find(e => e.type === 'high');
    const nextLow = extremes.find(e => e.type === 'low' && e.time > today) || extremes.find(e => e.type === 'low');
    // Sparkline of today's curve (120×32 viewBox)
    const hs = curve.map((c: { height: number }) => c.height);
    const lo = Math.min(...hs), hi = Math.max(...hs), span = hi - lo || 1;
    const spark = curve.map((c: { height: number }, i: number) =>
      `${i === 0 ? 'M' : 'L'}${(i / (curve.length - 1) * 120).toFixed(1)},${(30 - (c.height - lo) / span * 28).toFixed(1)}`).join(' ');
    return { ...p, nextHigh, nextLow, tz, spark, range: Math.round(span), countryName: countryName(p.country) };
  })
);

const moon = moonPhase(new Date());
const todayAr = new Date().toLocaleDateString('ar-EG-u-nu-latn', { weekday: 'long', day: 'numeric', month: 'long' });

// Lightweight port list for the overview map (client-side)
const mapPorts = placesIndex.map((p: { id: string; name_ar: string; lat: number; lon: number }) => ({
  id: p.id, name: p.name_ar, lat: p.lat, lon: p.lon
}));

// Full port list for the search dropdown (client-side)
const searchPorts = placesIndex.map((p: { id: string; name_ar: string; name_en: string; country: string }) => ({
  id: p.id, name_ar: p.name_ar, name_en: p.name_en, countryName: countryName(p.country)
}));
const searchPortsJSON = JSON.stringify(searchPorts);

const features = [
  { icon: '🌊', title: 'منحنى المد والجزر', text: 'منحنى يومي لارتفاع الماء مع أوقات المد العالي والجزر المنخفض وتوقعات ٧ أيام.' },
  { icon: '🎣', title: 'أوقات الصيد', text: 'تقييم يومي من ١ إلى ٥ وفترات السولونار الكبرى والصغرى وتقويم شهري لأفضل الأيام.' },
  { icon: '🌙', title: 'الشمس والقمر', text: 'شروق وغروب الشمس والقمر، طور القمر ونسبة إضاءته.' },
  { icon: '🕌', title: 'الصلاة والتاريخ الهجري', text: 'أوقات الصلاة بطريقة أم القرى والتاريخ الهجري التقديري.' },
];
---

<BaseLayout
  title="مواقيت المد والجزر للموانئ العربية"
  description="مواقيت المد والجزر، أوقات الصيد، أطوار القمر، أوقات الصلاة والتاريخ الهجري لـ٣٦ ميناءً عربياً"
>
  <!-- Hero -->
  <section class="hero">
    <div class="max-w-6xl mx-auto px-4 pt-14 pb-24 sm:pt-20 sm:pb-28">
      <p class="inline-flex items-center gap-2 text-xs text-teal-100 bg-white/10 border border-white/15 rounded-full px-3 py-1">
        <span aria-hidden="true">{moon.emoji}</span>
        <span>{todayAr}</span>
        <span class="opacity-50">·</span>
        <span>{moon.phaseNameAr} <span class="latin">{Math.round(moon.illumination * 100)}%</span></span>
      </p>
      <h1 class="mt-5 text-4xl sm:text-5xl font-bold leading-tight display max-w-2xl">
        مواقيت المد والجزر<br/><span class="text-teal-300">للموانئ العربية</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-xl leading-relaxed">
        توقعات المد والجزر، أفضل أوقات الصيد، أطوار القمر وأوقات الصلاة لـ{placesIndex.length} ميناءً من المحيط الأطلسي إلى الخليج العربي.
      </p>

      <!-- Search -->
      <div class="mt-8 max-w-xl relative">
        <label for="port-search" class="sr-only">ابحث عن ميناء</label>
        <input
          type="search"
          id="port-search"
          placeholder="ابحث عن ميناء أو دولة… دبي، جدة، المغرب"
          autocomplete="off"
          aria-controls="search-results"
          aria-expanded="false"
          class="w-full ps-5 pe-12 py-4 text-base rounded-2xl
                 bg-white text-[var(--text-primary)]
                 placeholder:text-[var(--text-dim)]
                 focus:outline-none focus:ring-4 focus:ring-teal-300/40
                 shadow-xl shadow-black/20"
        />
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[var(--text-dim)] pointer-events-none" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <div id="search-results" class="absolute z-40 top-full mt-2 w-full hidden rounded-xl bg-white border border-[var(--border-subtle)] shadow-2xl max-h-80 overflow-y-auto text-[var(--text-primary)]"></div>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
        <span class="text-slate-400 text-xs">الأكثر بحثاً:</span>
        {featuredPorts.slice(0, 4).map(p => (
          <a href={`${BASE}ports/${p.id}`} class="px-3 py-1 rounded-full bg-white/10 hover:bg-white/20 border border-white/10 text-white text-xs transition-colors">{p.name_ar}</a>
        ))}
      </div>

      <!-- Stats -->
      <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl">
        <div class="hero-stat"><dt class="text-xs text-slate-400">موانئ</dt><dd class="text-2xl font-bold latin mt-0.5">{placesIndex.length}</dd></div>
        <div class="hero-stat"><dt class="text-xs text-slate-400">دولة عربية</dt><dd class="text-2xl font-bold latin mt-0.5">{countries.length}</dd></div>
        <div class="hero-stat"><dt class="text-xs text-slate-400">أيام توقعات</dt><dd class="text-2xl font-bold latin mt-0.5">7</dd></div>
        <div class="hero-stat"><dt class="text-xs text-slate-400">مركبة توافقية</dt><dd class="text-2xl font-bold latin mt-0.5">17</dd></div>
      </dl>
    </div>
    <svg class="hero-waves" viewBox="0 0 1440 72" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 40c120-20 240-30 360-18s240 40 360 36 240-34 360-38 240 18 360 26v26H0z" fill="currentColor" />
    </svg>
  </section>

  <main id="main" class="max-w-6xl mx-auto px-4 w-full">

    <!-- Featured ports -->
    <section class="mt-6 mb-16" aria-labelledby="featured-title">
      <div class="section-title">
        <h2 id="featured-title">موانئ مميزة</h2>
        <p>المد والجزر القادم — بالتوقيت المحلي</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredPorts.map(port => (
          <a href={`${BASE}ports/${port.id}`} class="card group block p-5">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="text-xs text-[var(--text-muted)]">{port.countryName}</div>
                <div class="text-lg font-semibold display mt-0.5 group-hover:text-[var(--accent)] transition-colors">{port.name_ar}</div>
                <div class="text-xs text-[var(--text-dim)] latin" lang="en">{port.name_en}</div>
              </div>
              <svg viewBox="0 0 120 32" class="w-28 h-8 chart-ltr shrink-0" aria-hidden="true">
                <path d={port.spark} fill="none" stroke="#0d9488" stroke-width="1.8" stroke-linejoin="round" />
              </svg>
            </div>
            <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-[var(--border-subtle)] text-xs">
              {port.nextHigh && (
                <div>
                  <div class="text-[var(--text-muted)]">▲ المد القادم</div>
                  <div class="text-base font-semibold text-teal-700 latin mt-0.5">{formatTime(port.nextHigh.time, port.tz)}</div>
                </div>
              )}
              {port.nextLow && (
                <div>
                  <div class="text-[var(--text-muted)]">▼ الجزر القادم</div>
                  <div class="text-base font-semibold text-rose-600 latin mt-0.5">{formatTime(port.nextLow.time, port.tz)}</div>
                </div>
              )}
              <div>
                <div class="text-[var(--text-muted)]">مدى اليوم</div>
                <div class="text-base font-semibold latin mt-0.5">{port.range} <span class="text-xs font-normal text-[var(--text-muted)]">سم</span></div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Paid guide -->
    <div class="mb-16"><GuidePromo variant="banner" /></div>

    <!-- Fish guide teaser -->
    <section class="mb-16" aria-labelledby="fish-title">
      <div class="section-title">
        <h2 id="fish-title">دليل الأسماك</h2>
        <p><span class="latin">{fish.length}</span> نوعاً بأسمائها المحلية في كل بلد</p>
        <a href={`${BASE}fish`} class="ms-auto text-sm text-[var(--accent)] hover:underline">كل الأسماك ←</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {['hamour', 'kanad', 'sheri', 'dorade', 'seabass', 'coraltrout'].map(fid => {
          const f = fish.find(x => x.id === fid)!;
          return (
            <a href={`${BASE}fish/${f.id}`} class="card overflow-hidden group block">
              <img src={`${BASE}fish/${f.id}.webp`} alt={f.ar} loading="lazy" decoding="async" class="fish-thumb" />
              <span class="block px-3 py-2">
                <span class="block font-semibold text-sm group-hover:text-[var(--accent)] transition-colors">{f.ar}</span>
                <span class="block text-[11px] text-[var(--text-dim)] truncate">{f.local.map(l => l.name).filter(n => n !== f.ar).slice(0, 2).join('، ') || f.en}</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- What each port page offers -->
    <section class="mb-16" aria-labelledby="features-title">
      <div class="section-title">
        <h2 id="features-title">ماذا تجد في صفحة كل ميناء؟</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {features.map(f => (
          <div class="card p-5">
            <div class="w-10 h-10 rounded-xl bg-[var(--accent-muted)] flex items-center justify-center text-xl" aria-hidden="true">{f.icon}</div>
            <h3 class="mt-3 font-semibold">{f.title}</h3>
            <p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">{f.text}</p>
          </div>
        ))}
      </div>
      <div class="card p-5 mt-4 flex flex-col sm:flex-row sm:items-center gap-3 text-sm">
        <span class="font-semibold shrink-0">مقياس جودة الصيد:</span>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs">
          <span style="color:#16a34a">🐟🐟🐟🐟🐟 ممتاز</span>
          <span style="color:#0d9488">🐟🐟🐟🐟 جيد</span>
          <span style="color:#d97706">🐟🐟🐟 متوسط</span>
          <span style="color:#ea580c">🐟🐟 دون المتوسط</span>
          <span style="color:#dc2626">🐟 ضعيف</span>
        </div>
        <a href={`${BASE}methodology`} class="sm:ms-auto text-xs text-[var(--accent)] hover:underline shrink-0">كيف نحسبه؟</a>
      </div>
    </section>

    <!-- Articles -->
    <section class="mb-16" aria-labelledby="articles-title">
      <div class="section-title">
        <h2 id="articles-title">مقالات</h2>
        <p>أدلة وأرقام من بياناتنا</p>
        <a href={`${BASE}articles`} class="ms-auto text-sm text-[var(--accent)] hover:underline">كل المقالات ←</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {articles.map(a => (
          <a href={`${BASE}articles/${a.slug}`} class="card p-5 flex gap-4 items-start group">
            <span class="w-14 h-14 shrink-0 rounded-2xl flex items-center justify-center text-2xl" style="background:linear-gradient(160deg,#0b2540,#0f3d5c)" aria-hidden="true">{a.icon}</span>
            <span>
              <span class="block font-semibold leading-snug group-hover:text-[var(--accent)] transition-colors">{a.title}</span>
              <span class="block text-sm text-[var(--text-muted)] mt-1 leading-relaxed">{a.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Ports overview map -->
    <section class="mb-16" aria-labelledby="map-title">
      <div class="section-title">
        <h2 id="map-title">خريطة الموانئ</h2>
        <p>اضغط على أي نقطة لفتح صفحة الميناء</p>
      </div>
      <div id="ports-map" class="port-map w-full border border-[var(--border-subtle)]" style="height:420px"></div>
      <p class="text-[11px] text-[var(--text-dim)] mt-2 text-center">بيانات الخريطة &copy; <a href="https://www.openstreetmap.org/copyright" class="underline hover:text-[var(--accent)]" lang="en">OpenStreetMap</a></p>
    </section>

    <!-- Countries -->
    <section id="countries" class="mb-16 scroll-mt-20" aria-labelledby="countries-title">
      <div class="section-title">
        <h2 id="countries-title">تصفح حسب الدولة</h2>
        <p><span class="latin">{countries.length}</span> دولة</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {countries.map((code: string) => {
          const count = placesIndex.filter((p: { country: string }) => p.country === code).length;
          return (
            <a href={`${BASE}country/${code}`} class="card px-4 py-3 flex items-center justify-between gap-2 group">
              <span class="flex items-center gap-2.5 min-w-0">
                <Flag code={code} size={28} />
                <span class="font-medium group-hover:text-[var(--accent)] transition-colors">{countryName(code)}</span>
              </span>
              <span class="text-xs text-[var(--text-muted)] bg-[var(--surface-elevated)] rounded-full px-2 py-0.5 latin">{count}</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- All ports, grouped by country -->
    <section id="ports" class="mb-8 scroll-mt-20" aria-labelledby="ports-title">
      <div class="section-title">
        <h2 id="ports-title">جميع الموانئ</h2>
        <p><span class="latin">{placesIndex.length}</span> ميناءً</p>
      </div>
      <div class="card p-5 sm:p-6 columns-1 sm:columns-2 lg:columns-3 gap-8">
        {countries.map((code: string) => (
          <div class="break-inside-avoid mb-5">
            <a href={`${BASE}country/${code}`} class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--accent)]"><Flag code={code} size={18} />{countryName(code)}</a>
            <ul class="mt-1.5 space-y-0.5">
              {placesIndex.filter((p: { country: string }) => p.country === code).map((port: { id: string; name_ar: string; name_en: string }) => (
                <li>
                  <a href={`${BASE}ports/${port.id}`} class="flex items-baseline gap-2 py-1 text-sm hover:text-[var(--accent)] transition-colors">
                    <span>{port.name_ar}</span>
                    <span class="text-[11px] text-[var(--text-dim)] latin" lang="en">{port.name_en}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<!-- Leaflet overview map (client-only, free OSM tiles) -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline define:vars={{ ports: mapPorts, base: BASE }}>
  (function () {
    function initMap() {
      var el = document.getElementById('ports-map');
      if (!el || typeof L === 'undefined' || !ports.length) return;
      var map = L.map(el, { scrollWheelZoom: false, attributionControl: false });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18, attribution: '&copy; OpenStreetMap'
      }).addTo(map);
      var pts = [];
      ports.forEach(function (p) {
        var m = L.circleMarker([p.lat, p.lon], {
          radius: 6, color: '#ffffff', fillColor: '#0d9488', fillOpacity: 0.9, weight: 2
        }).addTo(map);
        m.bindTooltip(p.name, { direction: 'top', offset: [0, -6] });
        m.on('click', function () { window.location.href = base + 'ports/' + p.id; });
        pts.push([p.lat, p.lon]);
      });
      map.fitBounds(pts, { padding: [30, 30] });
      map.on('click', function () { map.scrollWheelZoom.enable(); });
      setTimeout(function () { map.invalidateSize(); }, 200);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMap);
    } else { initMap(); }
  })();
</script>

<script type="application/json" id="search-data" set:html={searchPortsJSON}></script>
<script is:inline define:vars={{ base: BASE }}>
  var portsData = [];
  var searchEl = document.getElementById('port-search');
  var dropdown = document.getElementById('search-results');

  try {
    var raw = document.getElementById('search-data');
    if (raw) portsData = JSON.parse(raw.textContent || '[]');
  } catch(e) {}

  searchEl?.addEventListener('input', function () {
    var q = this.value.trim().toLowerCase();
    if (!dropdown) return;
    dropdown.innerHTML = '';
    if (!q || !portsData.length) { dropdown.classList.add('hidden'); this.setAttribute('aria-expanded','false'); return; }
    var matches = [];
    for (var i=0; i<portsData.length; i++) {
      var p = portsData[i];
      var txt = (p.name_ar + ' ' + p.name_en + ' ' + p.countryName).toLowerCase();
      if (txt.indexOf(q) !== -1) matches.push(p);
    }
    if (!matches.length) {
      dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-[var(--text-dim)]">لا توجد نتائج</div>';
    } else {
      var html = '';
      for (var j=0; j<Math.min(matches.length, 8); j++) {
        var m = matches[j];
        html += '<a href="' + base + 'ports/' + m.id + '" class="flex items-center gap-3 px-4 py-3 hover:bg-[var(--surface-elevated)] transition-colors text-sm border-b border-[var(--border-subtle)] last:border-0"><span class="font-medium">' + m.name_ar + '</span><span class="text-xs text-[var(--text-dim)]">' + m.countryName + '</span><span class="text-xs text-[var(--text-dim)] latin ms-auto">' + m.name_en + '</span></a>';
      }
      if (matches.length > 8) html += '<div class="px-4 py-2 text-xs text-[var(--text-dim)]">و ' + (matches.length - 8) + ' ميناء آخر...</div>';
      dropdown.innerHTML = html;
    }
    dropdown.classList.remove('hidden');
    this.setAttribute('aria-expanded','true');
  });

  searchEl?.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && dropdown) {
      var first = dropdown.querySelector('a');
      if (first) { e.preventDefault(); window.location.href = first.getAttribute('href'); }
    }
  });
  searchEl?.addEventListener('blur', function () {
    setTimeout(function () { if (dropdown) dropdown.classList.add('hidden'); if (searchEl) searchEl.setAttribute('aria-expanded','false'); }, 200);
  });
  searchEl?.addEventListener('focus', function () {
    if (dropdown && dropdown.children.length) { dropdown.classList.remove('hidden'); this.setAttribute('aria-expanded','true'); }
  });
</script>
