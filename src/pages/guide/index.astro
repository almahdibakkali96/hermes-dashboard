---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignupForm from '../../components/SignupForm.astro';
import { GUIDE, buyUrl, SALES_OPEN } from '../../lib/shop';

const BUY = buyUrl(GUIDE.id);

const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const url = new URL(`${BASE}guide`, Astro.site).href;
const img = (f: string) => `${BASE}guide/${f}`;
const samples = [
  { f: 'sample-moon-phases.jpg', cap: 'أطوار القمر الثمانية وكيف تراها' },
  { f: 'sample-spring-neap.jpg', cap: 'المد الربيعي والمحاقي — ببيانات حقيقية' },
  { f: 'sample-worked-example.jpg', cap: 'مثال محلول: نوافذ الصيد في الدار البيضاء' },
  { f: 'sample-arab-seas.jpg', cap: 'البحار العربية: أين يقوى المد وأين يختفي' },
  { f: 'sample-fish.jpg', cap: 'متى يأكل كل سمك: المد والساعة والطعم' },
  { f: 'sample-calendar.jpg', cap: 'تقويم الصيد: المد القوي ومواسم المنع' },
];
const stats = [
  { n: GUIDE.pages, label: 'صفحة' },
  { n: GUIDE.chapters.length, label: 'فصول' },
  { n: 52, label: 'نوعاً من الأسماك' },
  { n: 12, label: 'شهراً في تقويم الصيد' },
  { n: 53, label: 'ميناءً عربياً في الأمثلة' },  // ports covered by the PDF, not the site's current count
];
const faq = [
  { q: 'ما صيغة الدليل؟', a: `ملف PDF من ${GUIDE.pages} صفحة بحجم A4، باللغة العربية، يُقرأ على الهاتف أو الحاسوب ويمكن طباعته.` },
  ...(SALES_OPEN ? [
    { q: 'كيف أدفع؟', a: 'الدفع آمن على صفحة Stripe بالبطاقة البنكية أو Apple Pay أو Google Pay. لا تمر بيانات بطاقتك بموقعنا، ولا نراها ولا نحفظها.' },
    { q: 'متى يصلني الدليل؟', a: 'يصلك ملف الدليل (PDF) على البريد الإلكتروني الذي تستخدمه عند الدفع خلال 24 ساعة. إن لم تجده فتحقق من مجلد الرسائل غير المرغوب فيها، أو راسلنا من صفحة الاتصال.' },
    { q: 'هل هو اشتراك؟', a: 'لا. تدفع مرة واحدة ويبقى الملف لك، تقرؤه على هاتفك أو تطبعه متى شئت.' },
    { q: 'هل يمكن استرداد المبلغ؟', a: 'نعم. إذا لم يصلك الدليل، أو كان في الملف خلل يمنع قراءته، راسلنا من صفحة الاتصال بالبريد الذي دفعت به، فنرسل لك نسخة سليمة أو نعيد لك المبلغ كاملاً.' },
  ] : [
    { q: 'متى يصدر الدليل؟', a: 'الدليل في مراحله الأخيرة. اترك بريدك الإلكتروني في الأسفل لتصلك رسالة يوم صدوره، وتحمّل الورقة المختصرة مجاناً الآن.' },
  ]),
  { q: 'هل يناسب ميناءي؟', a: 'نعم. الدليل يشرح المبادئ التي تنطبق على كل السواحل، مع أمثلة من الخليج والأطلسي والبحر الأحمر والمتوسط والمحيط الهندي. وأوقات ميناءك اليومية تجدها مجاناً على ArabTides.' },
  { q: 'هل يمكن استخدامه للملاحة؟', a: 'لا. الدليل والموقع للصيد والنزهات. أرقام المد تقديرات فلكية من نموذج EOT20 العالمي، وليست جداول رسمية للموانئ.' },
];
const jsonLd = [
  ...(SALES_OPEN ? [{
    '@context': 'https://schema.org', '@type': 'Product',
    name: GUIDE.title, description: GUIDE.subtitle, inLanguage: 'ar',
    image: new URL(img('cover.jpg'), Astro.site).href,
    brand: { '@type': 'Brand', name: 'ArabTides' },
    offers: {
      '@type': 'Offer', price: GUIDE.price.toFixed(2), priceCurrency: GUIDE.currency, url,
      availability: 'https://schema.org/InStock',
    },
  }] : []),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<BaseLayout title={`${GUIDE.title} — PDF`} description={`${GUIDE.subtitle}. دليل عربي من ${GUIDE.pages} صفحة: أطوار القمر، المد الربيعي، جداول المد، السولونار، و52 نوعاً من الأسماك، وتقويم صيد لـ12 شهراً. ${SALES_OPEN ? `السعر ${GUIDE.priceLabel}.` : 'حمّل الورقة المختصرة مجاناً الآن.'}`} jsonLd={jsonLd} ogImage={img('cover.jpg')}>
  <!-- Hero -->
  <section class="hero">
    <div class="max-w-6xl mx-auto px-4 pt-10 pb-24 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-10 items-center">
      <div>
        <nav class="breadcrumb breadcrumb-light" aria-label="مسار التنقل"><a href={BASE}>الرئيسية</a><span class="sep">/</span><span aria-current="page">دليل الصياد</span></nav>
        <span class="hero-chip mt-5 text-xs">📘 دليل PDF · <span class="latin">{GUIDE.pages}</span> صفحة{!SALES_OPEN && ' · سجّل اهتمامك'}</span>
        <h1 class="mt-4 text-3xl sm:text-5xl font-bold display leading-snug">{GUIDE.title}</h1>
        <p class="mt-4 text-lg text-slate-300 leading-relaxed max-w-xl">{GUIDE.subtitle}.</p>
        <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-slate-200">
          <li>✓ <span class="latin">10</span> فصول برسوم توضيحية واضحة</li>
          <li>✓ أمثلة حقيقية من موانئ عربية</li>
          <li>✓ <span class="latin">52</span> نوعاً من الأسماك: متى تأكل وبماذا</li>
          <li>✓ تقويم صيد لـ<span class="latin">12</span> شهراً مع مواسم المنع</li>
          <li>✓ طريقة من 4 خطوات قبل كل رحلة</li>
          <li>✓ ورقة مختصرة للطباعة والهاتف</li>
        </ul>
        {SALES_OPEN ? (
          <>
            <div class="mt-7 flex flex-wrap items-center gap-4" id="buy">
              <div class="leading-none"><span class="latin text-5xl font-extrabold text-white">{GUIDE.priceLabel}</span><span class="block mt-1.5 text-xs text-slate-300">دفعة واحدة · بلا اشتراك</span></div>
              <a href={BUY} class="btn-primary text-lg" rel="noopener">اشترِ الدليل الآن</a>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2 text-xs text-slate-200" aria-label="ضمانات الشراء">
              <li class="hero-chip">🔒 دفع آمن ومشفّر عبر <span class="latin font-semibold">Stripe</span></li>
              <li class="hero-chip">💳 بطاقة · <span class="latin">Apple Pay</span> · <span class="latin">Google Pay</span></li>
              <li class="hero-chip">↩️ ضمان استرداد المبلغ</li>
            </ul>
          </>
        ) : (
          <>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a href="#free" class="btn-primary text-lg">أخبرني عند صدوره</a>
              <a href="#free" class="btn-ghost">الورقة المختصرة مجاناً</a>
            </div>
            <p class="mt-3 text-sm text-slate-400">✉️ اترك بريدك: تحمّل الورقة المختصرة الآن، ونخبرك يوم صدور الدليل</p>
          </>
        )}
      </div>
      <div class="guide-cover mx-auto"><img src={img('cover.jpg')} alt={`غلاف ${GUIDE.title}`} width="290" height="410" class="w-56 sm:w-72 h-auto" /></div>
    </div>
    <svg class="hero-waves" viewBox="0 0 1440 72" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 40c120-20 240-30 360-18s240 40 360 36 240-34 360-38 240 18 360 26v26H0z" fill="currentColor" />
    </svg>
  </section>

  <main id="main" class="max-w-6xl mx-auto px-4 w-full mt-4">
    <!-- The guide in numbers -->
    <ul class="guide-stats mb-14" aria-label="الدليل بالأرقام">
      {stats.map(s => <li class="card"><span class="latin">{s.n}</span>{s.label}</li>)}
    </ul>

    <!-- What you'll learn -->
    <section class="mb-16" aria-labelledby="learn-title">
      <div class="section-title"><h2 id="learn-title">ماذا ستتعلم؟</h2><p>عشرة فصول، من القمر إلى قرار الخروج للصيد</p></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {GUIDE.chapters.map((c, i) => (
          <div class="card p-5">
            <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-[var(--accent-muted)] flex items-center justify-center text-xl" aria-hidden="true">{c.icon}</span><span class="latin text-sm text-[var(--text-dim)]">{String(i + 1).padStart(2, '0')}</span></div>
            <h3 class="mt-3 font-semibold leading-snug">{c.title}</h3>
            <p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">{c.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Sample pages -->
    <section class="mb-16" aria-labelledby="samples-title">
      <div class="section-title"><h2 id="samples-title">صفحات من الدليل</h2><p>رسوم مرسومة بدقة وأرقام من محرك ArabTides</p></div>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
        {samples.map(s => (
          <figure class="card p-2">
            <img src={img(s.f)} alt={s.cap} width="827" height="1170" loading="lazy" class="w-full h-auto rounded-lg border border-[var(--border-subtle)]" />
            <figcaption class="text-xs text-[var(--text-muted)] text-center mt-2 leading-relaxed">{s.cap}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Who it's for -->
    <section class="mb-16" aria-labelledby="who-title">
      <div class="section-title"><h2 id="who-title">لمن هذا الدليل؟</h2></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card p-5"><div class="text-3xl" aria-hidden="true">🎣</div><h3 class="mt-2 font-semibold">الصياد الهاوي</h3><p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">تريد أن تعرف لماذا تنجح بعض الرحلات وتفشل أخرى، ومتى تخرج.</p></div>
        <div class="card p-5"><div class="text-3xl" aria-hidden="true">🚤</div><h3 class="mt-2 font-semibold">صاحب القارب</h3><p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">تخطط رحلاتك حول التيارات وأوقات المد في ميناءك.</p></div>
        <div class="card p-5"><div class="text-3xl" aria-hidden="true">🌊</div><h3 class="mt-2 font-semibold">محب البحر</h3><p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">تريد أن تفهم القمر والمد والجزر بلغة بسيطة وبرسوم واضحة.</p></div>
      </div>
    </section>

    <!-- Secure payment (only once sales are open) -->
    {SALES_OPEN && (
      <section class="mb-16" aria-labelledby="secure-title">
        <div class="section-title"><h2 id="secure-title">دفع آمن وتسليم مضمون</h2><p>الدفع يتم عبر <span class="latin">Stripe</span>، لا عبر موقعنا</p></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="card p-5"><div class="text-3xl" aria-hidden="true">🔒</div><h3 class="mt-2 font-semibold">مزوّد دفع عالمي</h3><p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">نستخدم <span class="latin">Stripe</span>، مزوّد الدفع الذي تعتمد عليه ملايين الشركات حول العالم، والحاصل على أعلى شهادة أمان في صناعة البطاقات (<span class="latin">PCI DSS</span> المستوى الأول).</p></div>
          <div class="card p-5"><div class="text-3xl" aria-hidden="true">🛡️</div><h3 class="mt-2 font-semibold">لا نرى بيانات بطاقتك</h3><p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">تُدخل بطاقتك في صفحة <span class="latin">Stripe</span> المشفّرة على <span class="latin" dir="ltr">buy.stripe.com</span>. لا تمر بموقعنا، ولا نراها ولا نحفظها.</p></div>
          <div class="card p-5"><div class="text-3xl" aria-hidden="true">📧</div><h3 class="mt-2 font-semibold">إيصال فوري وتسليم خلال 24 ساعة</h3><p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">يصلك إيصال الدفع من <span class="latin">Stripe</span> فور الشراء، ثم ملف الدليل على بريدك الإلكتروني خلال <span class="latin">24</span> ساعة.</p></div>
          <div class="card p-5"><div class="text-3xl" aria-hidden="true">↩️</div><h3 class="mt-2 font-semibold">ضمان استرداد المبلغ</h3><p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">إذا لم يصلك الدليل، أو كان في الملف خلل يمنع قراءته، نرسل لك نسخة سليمة أو نعيد لك المبلغ كاملاً.</p></div>
        </div>
        <p class="mt-4 text-sm text-[var(--text-muted)] text-center">طرق الدفع: <span class="latin">Visa</span> · <span class="latin">Mastercard</span> · <span class="latin">Apple Pay</span> · <span class="latin">Google Pay</span>. السعر بالدولار الأمريكي، ويحوّله بنكك إلى عملتك.</p>
      </section>
    )}

    <!-- Free cheat sheet: the main call to action while sales are closed -->
    {!SALES_OPEN && (
    <section id="free" class="mb-16 scroll-mt-20" aria-labelledby="free-title">
      <div class="card p-6 sm:p-8 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 items-center" style="background:linear-gradient(135deg,#ecfdf5,#f0fdfa);border-color:#99f6e4">
        <div>
          <span class="text-xs font-semibold text-[var(--accent-text)] bg-white rounded-full px-3 py-1">مجاناً</span>
          <h2 id="free-title" class="mt-3 text-2xl font-bold display">الورقة المختصرة: القمر والمد والصيد في صفحة واحدة</h2>
          <p class="mt-2 text-[var(--text-secondary)] leading-relaxed">أطوار القمر، أفضل الساعات، السولونار، و4 خطوات قبل كل رحلة — في صفحة PDF تطبعها أو تحفظها في هاتفك. اترك بريدك وحمّلها فوراً{!SALES_OPEN && '، وسنخبرك يوم صدور الدليل الكامل'}.</p>
          <div class="mt-5 max-w-xl"><SignupForm source="guide" /></div>
        </div>
        <img src={img('cheat-sheet.jpg')} alt="الورقة المختصرة" width="827" height="1170" loading="lazy" class="w-48 h-auto rounded-lg shadow-lg mx-auto rotate-2 border border-[var(--border-subtle)]" />
      </div>
    </section>
    )}

    <!-- FAQ + final CTA -->
    <section class="mb-10 grid grid-cols-1 lg:grid-cols-[1fr_20rem] gap-8 items-start" aria-labelledby="faq-title">
      <div>
        <h2 id="faq-title" class="text-2xl font-bold display">أسئلة شائعة</h2>
        <div class="card mt-4 px-5 divide-y divide-[var(--border-subtle)]">
          {faq.map((f, i) => (
            <details class="faq py-4" open={i === 0}>
              <summary class="flex items-center gap-3 cursor-pointer font-medium list-none"><span class="faq-icon" aria-hidden="true">+</span>{f.q}</summary>
              <p class="mt-2 ps-9 leading-relaxed text-[var(--text-secondary)]">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
      <div class="card p-6 text-center lg:sticky lg:top-24">
        <img src={img('cover.jpg')} alt="" width="160" height="226" loading="lazy" class="w-32 h-auto mx-auto rounded-md shadow-lg" />
        <div class="mt-4 font-semibold">{GUIDE.title}</div>
        {SALES_OPEN ? (
          <>
            <div class="latin text-4xl font-extrabold mt-2 text-[var(--accent-text)]">{GUIDE.priceLabel}</div>
            <a href={BUY} class="btn-primary w-full justify-center mt-4" style="background:var(--accent);color:#fff" rel="noopener">اشترِ الدليل الآن</a>
            <p class="mt-3 text-xs text-[var(--text-secondary)]">🔒 دفع آمن عبر <span class="latin">Stripe</span> · ↩️ ضمان الاسترداد</p>
          </>
        ) : (
          <>
            <div class="text-lg font-bold mt-2 text-[var(--accent-text)]">سجّل اهتمامك</div>
            <a href="#free" class="btn-primary w-full justify-center mt-4" style="background:var(--accent);color:#fff">أخبرني عند صدوره</a>
          </>
        )}
        <p class="mt-3 text-xs text-[var(--text-muted)]">تقديرات فلكية — ليست للملاحة</p>
      </div>
    </section>
    <!-- Free cheat sheet: a quiet fallback below the FAQ once sales are open, so it doesn't compete with Buy -->
    {SALES_OPEN && (
      <section id="free" class="mb-16 scroll-mt-20" aria-labelledby="free-title">
        <div class="card p-6 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 items-center">
          <div>
            <h2 id="free-title" class="text-xl font-bold display">لست مستعداً بعد؟ ابدأ بالورقة المختصرة مجاناً</h2>
            <p class="mt-2 text-sm text-[var(--text-secondary)] leading-relaxed">أطوار القمر، أفضل الساعات، السولونار، و4 خطوات قبل كل رحلة — في صفحة PDF واحدة. اترك بريدك وحمّلها فوراً.</p>
            <div class="mt-4 max-w-xl"><SignupForm source="guide" /></div>
          </div>
          <img src={img('cheat-sheet.jpg')} alt="الورقة المختصرة" width="827" height="1170" loading="lazy" class="w-28 h-auto rounded-md shadow mx-auto border border-[var(--border-subtle)]" />
        </div>
      </section>
    )}
    {SALES_OPEN && <div class="h-20 sm:hidden" aria-hidden="true"></div>}
  </main>

  {SALES_OPEN && (
    <div class="buy-bar sm:hidden" id="buy-bar" hidden>
      <img src={img('cover.jpg')} alt="" width="34" height="48" />
      <span class="min-w-0 leading-tight"><span class="block text-sm font-semibold truncate">دليل القمر والمد للصيادين</span><span class="block text-xs text-[var(--text-muted)]">🔒 دفع آمن عبر <span class="latin">Stripe</span></span></span>
      <a href={BUY} class="btn-primary ms-auto shrink-0" style="background:var(--accent);color:#fff" rel="noopener">اشترِ · <span class="latin">{GUIDE.priceLabel}</span></a>
    </div>
    <script is:inline>
      // Mobile buy bar: shown once the hero's Buy button has scrolled out of view
      (function () {
        var bar = document.getElementById('buy-bar'), buy = document.getElementById('buy');
        if (!bar || !buy || !('IntersectionObserver' in window)) return;
        new IntersectionObserver(function (e) { bar.hidden = e[0].isIntersecting || e[0].boundingClientRect.top > 0; }).observe(buy);
      })();
    </script>
  )}
</BaseLayout>

<style>
  .guide-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  @media (min-width: 640px) { .guide-stats { grid-template-columns: repeat(5, 1fr); } }
  .guide-stats li { padding: 1rem; text-align: center; font-size: 0.875rem; color: var(--text-secondary); }
  .guide-stats li .latin { display: block; font-size: 1.875rem; font-weight: 800; color: var(--accent-text); line-height: 1.2; }
  .guide-stats li:last-child { grid-column: 1 / -1; }
  @media (min-width: 640px) { .guide-stats li:last-child { grid-column: auto; } }
  .buy-bar { position: fixed; inset-inline: 0; bottom: 0; z-index: 40; display: flex; align-items: center; gap: 0.75rem;
    padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom)); background: var(--surface-card); border-top: 1px solid var(--border-subtle);
    box-shadow: 0 -8px 24px -12px rgba(0,0,0,.25); }
  .buy-bar[hidden] { display: none; }
  .buy-bar img { border-radius: 0.3rem; flex-shrink: 0; }
  .buy-bar .btn-primary { padding: 0.55rem 1rem; font-size: 0.95rem; }
</style>
