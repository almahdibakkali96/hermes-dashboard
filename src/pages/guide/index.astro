---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignupForm from '../../components/SignupForm.astro';
import { GUIDE, buyUrl, SALES_OPEN } from '../../lib/shop';

const BUY = buyUrl(GUIDE.id);

const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const url = new URL(`${BASE}guide`, Astro.site).href;
const img = (f: string) => `${BASE}guide/${f}`;
const samples = [
  { f: 'sample-moon-phases.jpg', cap: 'أطوار القمر الثمانية وكيف تراها' },
  { f: 'sample-spring-neap.jpg', cap: 'المد الربيعي والمحاقي — ببيانات حقيقية' },
  { f: 'sample-worked-example.jpg', cap: 'مثال محلول: نوافذ الصيد في الدار البيضاء' },
  { f: 'sample-arab-seas.jpg', cap: 'البحار العربية: أين يقوى المد وأين يختفي' },
];
const faq = [
  { q: 'ما صيغة الدليل؟', a: `ملف PDF من ${GUIDE.pages} صفحة بحجم A4، باللغة العربية، يُقرأ على الهاتف أو الحاسوب ويمكن طباعته.` },
  ...(SALES_OPEN ? [
    { q: 'كيف أدفع؟', a: 'الدفع آمن عبر Stripe بالبطاقة البنكية. لا نرى بيانات بطاقتك ولا نحفظها.' },
    { q: 'متى يصلني الدليل؟', a: 'يصلك ملف الدليل على البريد الإلكتروني الذي تستخدمه عند الدفع.' },
  ] : [
    { q: 'متى يصدر الدليل؟', a: 'الدليل في مراحله الأخيرة. اترك بريدك الإلكتروني في الأسفل لتصلك رسالة يوم صدوره، وتحمّل الورقة المختصرة مجاناً الآن.' },
  ]),
  { q: 'هل يناسب ميناءي؟', a: 'نعم. الدليل يشرح المبادئ التي تنطبق على كل السواحل، مع أمثلة من الخليج والأطلسي والبحر الأحمر والمتوسط والمحيط الهندي. وأوقات ميناءك اليومية تجدها مجاناً على ArabTides.' },
  { q: 'هل يمكن استخدامه للملاحة؟', a: 'لا. الدليل والموقع للصيد والنزهات. أرقام المد تقديرات فلكية من نموذج EOT20 العالمي، وليست جداول رسمية للموانئ.' },
];
const jsonLd = [
  ...(SALES_OPEN ? [{
    '@context': 'https://schema.org', '@type': 'Product',
    name: GUIDE.title, description: GUIDE.subtitle, inLanguage: 'ar',
    image: new URL(img('cover.jpg'), Astro.site).href,
    brand: { '@type': 'Brand', name: 'ArabTides' },
    offers: {
      '@type': 'Offer', price: GUIDE.price.toFixed(2), priceCurrency: GUIDE.currency, url,
      availability: 'https://schema.org/InStock',
    },
  }] : []),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<BaseLayout title={`${GUIDE.title} — PDF`} description={`${GUIDE.subtitle}. دليل عربي من ${GUIDE.pages} صفحة: أطوار القمر، المد الربيعي، جداول المد وفترات السولونار. ${SALES_OPEN ? `السعر ${GUIDE.priceLabel}.` : 'قريباً — والورقة المختصرة مجاناً الآن.'}`} jsonLd={jsonLd} ogImage={img('cover.jpg')}>
  <!-- Hero -->
  <section class="hero">
    <div class="max-w-6xl mx-auto px-4 pt-10 pb-24 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-10 items-center">
      <div>
        <nav class="breadcrumb breadcrumb-light" aria-label="مسار التنقل"><a href={BASE}>الرئيسية</a><span class="sep">/</span><span aria-current="page">دليل الصياد</span></nav>
        <span class="hero-chip mt-5 text-xs">📘 دليل PDF · <span class="latin">{GUIDE.pages}</span> صفحة{!SALES_OPEN && ' · قريباً'}</span>
        <h1 class="mt-4 text-3xl sm:text-5xl font-bold display leading-snug">{GUIDE.title}</h1>
        <p class="mt-4 text-lg text-slate-300 leading-relaxed max-w-xl">{GUIDE.subtitle}.</p>
        <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-slate-200">
          <li>✓ <span class="latin">8</span> فصول برسوم توضيحية واضحة</li>
          <li>✓ أمثلة حقيقية من موانئ عربية</li>
          <li>✓ طريقة من 4 خطوات قبل كل رحلة</li>
          <li>✓ ورقة مختصرة للطباعة والهاتف</li>
        </ul>
        {SALES_OPEN ? (
          <>
            <div class="mt-7 flex flex-wrap items-center gap-4" id="buy">
              <div class="leading-none"><span class="latin text-5xl font-extrabold text-white">{GUIDE.priceLabel}</span></div>
              <a href={BUY} class="btn-primary text-lg" rel="noopener">اشترِ الدليل الآن</a>
            </div>
            <p class="mt-3 text-sm text-slate-400">🔒 دفع آمن عبر Stripe · يصلك ملف PDF على بريدك الإلكتروني</p>
          </>
        ) : (
          <>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a href="#free" class="btn-primary text-lg">أخبرني عند صدوره</a>
              <a href="#free" class="btn-ghost">الورقة المختصرة مجاناً</a>
            </div>
            <p class="mt-3 text-sm text-slate-400">✉️ اترك بريدك: تحمّل الورقة المختصرة الآن، ونخبرك يوم صدور الدليل</p>
          </>
        )}
      </div>
      <div class="guide-cover mx-auto"><img src={img('cover.jpg')} alt={`غلاف ${GUIDE.title}`} width="290" height="410" class="w-56 sm:w-72 h-auto" /></div>
    </div>
    <svg class="hero-waves" viewBox="0 0 1440 72" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 40c120-20 240-30 360-18s240 40 360 36 240-34 360-38 240 18 360 26v26H0z" fill="currentColor" />
    </svg>
  </section>

  <main id="main" class="max-w-6xl mx-auto px-4 w-full mt-4">
    <!-- What you'll learn -->
    <section class="mb-16" aria-labelledby="learn-title">
      <div class="section-title"><h2 id="learn-title">ماذا ستتعلم؟</h2><p>ثمانية فصول، من القمر إلى قرار الخروج للصيد</p></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {GUIDE.chapters.map((c, i) => (
          <div class="card p-5">
            <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-[var(--accent-muted)] flex items-center justify-center text-xl" aria-hidden="true">{c.icon}</span><span class="latin text-sm text-[var(--text-dim)]">{String(i + 1).padStart(2, '0')}</span></div>
            <h3 class="mt-3 font-semibold leading-snug">{c.title}</h3>
            <p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">{c.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Sample pages -->
    <section class="mb-16" aria-labelledby="samples-title">
      <div class="section-title"><h2 id="samples-title">صفحات من الدليل</h2><p>رسوم مرسومة بدقة وأرقام من محرك ArabTides</p></div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {samples.map(s => (
          <figure class="card p-2">
            <img src={img(s.f)} alt={s.cap} width="827" height="1170" loading="lazy" class="w-full h-auto rounded-lg border border-[var(--border-subtle)]" />
            <figcaption class="text-xs text-[var(--text-muted)] text-center mt-2 leading-relaxed">{s.cap}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Who it's for -->
    <section class="mb-16" aria-labelledby="who-title">
      <div class="section-title"><h2 id="who-title">لمن هذا الدليل؟</h2></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card p-5"><div class="text-3xl" aria-hidden="true">🎣</div><h3 class="mt-2 font-semibold">الصياد الهاوي</h3><p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">تريد أن تعرف لماذا تنجح بعض الرحلات وتفشل أخرى، ومتى تخرج.</p></div>
        <div class="card p-5"><div class="text-3xl" aria-hidden="true">🚤</div><h3 class="mt-2 font-semibold">صاحب القارب</h3><p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">تخطط رحلاتك حول التيارات وأوقات المد في ميناءك.</p></div>
        <div class="card p-5"><div class="text-3xl" aria-hidden="true">🌊</div><h3 class="mt-2 font-semibold">محب البحر</h3><p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">تريد أن تفهم القمر والمد والجزر بلغة بسيطة وبرسوم واضحة.</p></div>
      </div>
    </section>

    <!-- Free cheat sheet -->
    <section id="free" class="mb-16 scroll-mt-20" aria-labelledby="free-title">
      <div class="card p-6 sm:p-8 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 items-center" style="background:linear-gradient(135deg,#ecfdf5,#f0fdfa);border-color:#99f6e4">
        <div>
          <span class="text-xs font-semibold text-[var(--accent)] bg-white rounded-full px-3 py-1">مجاناً</span>
          <h2 id="free-title" class="mt-3 text-2xl font-bold display">الورقة المختصرة: القمر والمد والصيد في صفحة واحدة</h2>
          <p class="mt-2 text-[var(--text-secondary)] leading-relaxed">أطوار القمر، أفضل الساعات، السولونار، و4 خطوات قبل كل رحلة — في صفحة PDF تطبعها أو تحفظها في هاتفك. اترك بريدك وحمّلها فوراً{!SALES_OPEN && '، وسنخبرك يوم صدور الدليل الكامل'}.</p>
          <div class="mt-5 max-w-xl"><SignupForm source="guide" /></div>
        </div>
        <img src={img('cheat-sheet.jpg')} alt="الورقة المختصرة" width="827" height="1170" loading="lazy" class="w-48 h-auto rounded-lg shadow-lg mx-auto rotate-2 border border-[var(--border-subtle)]" />
      </div>
    </section>

    <!-- FAQ + final CTA -->
    <section class="mb-10 grid grid-cols-1 lg:grid-cols-[1fr_20rem] gap-8 items-start" aria-labelledby="faq-title">
      <div>
        <h2 id="faq-title" class="text-2xl font-bold display">أسئلة شائعة</h2>
        <div class="card mt-4 px-5 divide-y divide-[var(--border-subtle)]">
          {faq.map((f, i) => (
            <details class="faq py-4" open={i === 0}>
              <summary class="flex items-center gap-3 cursor-pointer font-medium list-none"><span class="faq-icon" aria-hidden="true">+</span>{f.q}</summary>
              <p class="mt-2 ps-9 leading-relaxed text-[var(--text-secondary)]">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
      <div class="card p-6 text-center lg:sticky lg:top-24">
        <img src={img('cover.jpg')} alt="" width="160" height="226" loading="lazy" class="w-32 h-auto mx-auto rounded-md shadow-lg" />
        <div class="mt-4 font-semibold">{GUIDE.title}</div>
        {SALES_OPEN ? (
          <>
            <div class="latin text-4xl font-extrabold mt-2 text-[var(--accent)]">{GUIDE.priceLabel}</div>
            <a href={BUY} class="btn-primary w-full justify-center mt-4" style="background:var(--accent);color:#fff" rel="noopener">اشترِ الدليل الآن</a>
          </>
        ) : (
          <>
            <div class="text-2xl font-bold mt-2 text-[var(--accent)]">قريباً</div>
            <a href="#free" class="btn-primary w-full justify-center mt-4" style="background:var(--accent);color:#fff">أخبرني عند صدوره</a>
          </>
        )}
        <p class="mt-3 text-xs text-[var(--text-muted)]">تقديرات فلكية — ليست للملاحة</p>
      </div>
    </section>
  </main>
</BaseLayout>
