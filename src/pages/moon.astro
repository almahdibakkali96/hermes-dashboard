---
import BaseLayout from '../layouts/BaseLayout.astro';
import { moonPhase, nextPrincipalPhases } from '../lib/astronomy';
import { gregorianToHijri } from '../lib/prayer';
import { getTimezoneOffset, portDay } from '../lib/tides';

const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');

// Dates and phase times in Makkah time (UTC+3), the middle of the ports' UTC+0…+4 span
const TZ = 'Asia/Riyadh';
const now = new Date();
const today = portDay(now, getTimezoneOffset(TZ, now));
const todayKey = today.toISOString().slice(0, 10);
const moonNow = moonPhase(now);
const hijriNow = gregorianToHijri(today);

const monthNames = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
const weekdays = ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'];
const fmtDay = (d: Date) => d.toLocaleDateString('ar-EG-u-nu-latn', { timeZone: TZ, weekday: 'long', day: 'numeric', month: 'long' });
const fmtTime = (d: Date) => d.toLocaleTimeString('en-GB', { timeZone: TZ, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
const keyOf = (d: Date) => d.toLocaleDateString('en-CA', { timeZone: TZ });

// Principal phases from the start of this month to the end of the third month
const y0 = today.getUTCFullYear(), m0 = today.getUTCMonth();
const rangeStart = new Date(Date.UTC(y0, m0, 1) - 3 * 3600000);
const phases = nextPrincipalPhases(rangeStart, 16);
const phaseByDay = new Map(phases.map(p => [keyOf(p.date), p]));
const upcoming = phases.filter(p => p.date > now).slice(0, 8);

// Three month grids (week starts Saturday; the RTL grid flows right to left)
const months = [0, 1, 2].map(k => {
  const y = y0 + Math.floor((m0 + k) / 12), m = (m0 + k) % 12;
  const len = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
  const days = Array.from({ length: len }, (_, i) => {
    const d = new Date(Date.UTC(y, m, i + 1, 12)), key = d.toISOString().slice(0, 10);
    const mp = moonPhase(d), h = gregorianToHijri(d), phase = phaseByDay.get(key);
    return { day: i + 1, key, emoji: phase?.emoji ?? mp.emoji, illum: Math.round(mp.illumination * 100), name: phase?.nameAr ?? mp.phaseNameAr, hijri: h, phase };
  });
  const hijriMonths = [...new Set(days.map(d => `${d.hijri.monthAr} ${d.hijri.year}`))];
  return { y, m, days, blanks: (new Date(Date.UTC(y, m, 1)).getUTCDay() + 1) % 7, hijriMonths };
});

const title = `تقويم القمر ${y0} — أطوار القمر والتاريخ الهجري`;
const description = `أطوار القمر لكل يوم في ${monthNames[m0]} والشهرين التاليين: المحاق والتربيع والبدر، ونسبة الإضاءة، والتاريخ الهجري المقابل، ومواعيد الأطوار بتوقيت مكة المكرمة.`;
const pageUrl = new URL(`${BASE}moon`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: new URL(BASE, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'تقويم القمر', item: pageUrl },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'WebPage', url: pageUrl, name: title, inLanguage: 'ar', dateModified: now.toISOString(), description },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="page-head">
    <div class="max-w-4xl mx-auto px-4 py-8">
      <nav class="breadcrumb" aria-label="مسار التنقل"><a href={BASE}>الرئيسية</a><span class="sep">/</span><span aria-current="page">تقويم القمر</span></nav>
      <h1 class="mt-3 text-3xl font-bold display">تقويم القمر</h1>
      <p class="mt-2 text-[var(--text-secondary)] max-w-2xl leading-relaxed">طور القمر لكل يوم مع التاريخ الهجري المقابل، ومواعيد المحاق والتربيع والبدر. البدر والمحاق يعنيان مداً قوياً في أغلب الموانئ، والتربيع يعني مداً ضعيفاً.</p>
    </div>
  </div>

  <main id="main" class="max-w-4xl mx-auto px-4 py-8 w-full space-y-8">
    <!-- Tonight's moon -->
    <section class="card p-5 flex flex-wrap items-center gap-5" aria-labelledby="now-title">
      <div class="text-6xl leading-none" aria-hidden="true">{moonNow.emoji}</div>
      <div class="min-w-0">
        <h2 id="now-title" class="text-lg font-semibold display">القمر اليوم: {moonNow.phaseNameAr}</h2>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          {fmtDay(today)} · {hijriNow.day} {hijriNow.monthAr} {hijriNow.year} هـ
        </p>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          الإضاءة <span class="latin font-semibold">{Math.round(moonNow.illumination * 100)}%</span>
          · عمر القمر <span class="latin font-semibold">{moonNow.age.toFixed(1)}</span> يوماً
        </p>
      </div>
    </section>

    <!-- Upcoming principal phases -->
    <section aria-labelledby="next-title">
      <h2 id="next-title" class="text-lg font-semibold display mb-3">الأطوار القادمة</h2>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead><tr><th>الطور</th><th>التاريخ</th><th>الساعة</th><th>المد</th></tr></thead>
          <tbody>
            {upcoming.map(p => (
              <tr>
                <td>{p.emoji} {p.nameAr}</td>
                <td>{fmtDay(p.date)}</td>
                <td class="latin">{fmtTime(p.date)}</td>
                <td>{p.target === 0 || p.target === 0.5 ? 'مد ربيعي (قوي)' : 'مد محاقي (ضعيف)'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-[var(--text-muted)]">الأوقات بتوقيت مكة المكرمة (UTC+3). أقوى مد يأتي غالباً بعد البدر أو المحاق بيوم أو يومين.</p>
    </section>

    <!-- Month grids -->
    {months.map(mo => (
      <section class="card p-5" aria-labelledby={`m-${mo.m}`}>
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h2 id={`m-${mo.m}`} class="text-lg font-semibold display">{monthNames[mo.m]} <span class="latin">{mo.y}</span></h2>
          <span class="text-xs text-[var(--text-muted)]">{mo.hijriMonths.join(' — ')} هـ</span>
        </div>
        <div class="mt-4 grid grid-cols-7 gap-1 sm:gap-1.5 text-center">
          {weekdays.map(w => <div class="text-[10px] sm:text-xs text-[var(--text-muted)] pb-1">{w}</div>)}
          {Array.from({ length: mo.blanks }).map(() => <div></div>)}
          {mo.days.map(d => (
            <div class:list={['moon-cell', { 'cal-today': d.key === todayKey, 'moon-key': d.phase }]}
                 title={`${d.day} ${monthNames[mo.m]} — ${d.name} ${d.illum}% — ${d.hijri.day} ${d.hijri.monthAr}`}>
              <div class="text-xs sm:text-sm font-semibold latin">{d.day}</div>
              <div class="text-lg sm:text-xl leading-none my-0.5" aria-hidden="true">{d.emoji}</div>
              <div class="text-[10px] text-[var(--text-muted)] latin">{d.hijri.day}</div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="text-sm text-[var(--text-secondary)] leading-relaxed space-y-2">
      <p>الرقم الصغير تحت كل يوم هو اليوم الهجري. التاريخ الهجري هنا حساب فلكي تقديري، وقد يختلف بيوم واحد عن بداية الشهر المعلنة برؤية الهلال في بلدك.</p>
      <p>
        كيف يؤثر الطور على المد والصيد؟ اقرأ <a href={`${BASE}articles/moon-phases-fishing`} class="text-[var(--accent-text)] hover:underline">أطوار القمر والصيد</a>
        و<a href={`${BASE}articles/tide-coefficient`} class="text-[var(--accent-text)] hover:underline">معامل المد</a>،
        أو افتح صفحة <a href={`${BASE}#ports`} class="text-[var(--accent-text)] hover:underline">ميناءك</a> لترى المد وتقييم الصيد لكل يوم.
      </p>
    </section>
  </main>
</BaseLayout>
