---
// /calendar — the 2027 fishing & tide calendar (one PDF per port). Waitlist mode until a Stripe link is set in
// src/lib/calendar.ts; noindex and out of the sitemap until CAL.public is true. Nothing links here yet.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignupForm from '../../components/SignupForm.astro';
import Flag from '../../components/Flag.astro';
import placesIndex from '../../data/places/places_index.json';
import { countryName } from '../../lib/countries';
import { CAL, CAL_SALES_OPEN, calendarBuyUrl, monthsAr, yearSummary } from '../../lib/calendar';

const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const img = (f: string) => `${BASE}calendar/${f}`;
const DEFAULT_PORT = 'dubai';

type Place = { id: string; name_ar: string; name_en: string; country: string };
const places = placesIndex as Place[];

// Each port's 2027 numbers, as on page 2 of its PDF
const stats: Record<string, (string | number | boolean)[]> = {};
for (const p of places) {
  const data = await import(`../../data/places/${p.id}.json`);
  const s = yearSummary(data.constituents, data.timezone);
  stats[p.id] = [p.name_ar, p.country.toLowerCase(), s.yearMax, s.maxMonth, s.n5, s.n4, s.bestMonth, s.tideType, s.microTidal];
}
const countries = [...new Set(places.map(p => p.country))];
const def = stats[DEFAULT_PORT];
const metres = (cm: number) => (cm / 100).toFixed(2);

// Sales mode: launch link until the full moon, then the full-price link (switched client-side at the exact minute)
const launchUrl = calendarBuyUrl(CAL.launchLink, DEFAULT_PORT);
const fullUrl = calendarBuyUrl(CAL.link, DEFAULT_PORT);
const priceLabel = (n: number | null) => (n == null ? '' : `${n.toFixed(2)}$`);

const features = [
  { icon: '🌊', title: 'المد والجزر يوماً بيوم', text: 'المد العالي والمنخفض لكل يوم بالساعة والارتفاع، ومعامل المد، لسنة 2027 كاملة.' },
  { icon: '🎣', title: 'تقييم الصيد وأفضل الساعات', text: 'تقييم من 1 إلى 5 لكل يوم، والفترتان الرئيسيتان (السولونار)، وعلامة ✦ حين يوافق المد العالي الشروق أو الغروب.' },
  { icon: '🌙', title: 'القمر والشمس والتاريخ الهجري', text: 'طور القمر، والشروق والغروب، والتاريخ الهجري بجانب الميلادي، وأيام نهاية الأسبوع مظللة.' },
  { icon: '📅', title: 'السنة في صفحة واحدة', text: 'اثنا عشر شهراً ملوّنة حسب التقييم، وأفضل 12 يوماً للصيد في السنة، وكل شهر في سطر.' },
  { icon: '🐟', title: 'أسماك ميناءك', text: 'عشرة أنواع سُجّلت قرب ميناءك: أفضل مدّ لكل نوع وأفضل طعم.' },
  { icon: '📝', title: 'مواسم المنع وسجلّ الصيد', text: 'مواسم منع الصيد في بلدك، وصفحة لتسجيل صيدك تطبعها وتأخذها معك.' },
];
const pages = [
  { f: 'port-year.webp', w: 900, cap: 'ميناؤك في 2027: أكبر مدّ، والأيام الممتازة، وأفضل شهر' },
  { f: 'year.webp', w: 900, cap: 'السنة في صفحة: كل يوم بلون تقييمه' },
  { f: 'best-days.webp', w: 900, cap: 'أفضل 12 يوماً للصيد في السنة', lock: true },
  { f: 'month.webp', w: 1100, cap: 'صفحة لكل شهر: المد والقمر وأفضل الساعات لكل يوم' },
  { f: 'fish.webp', w: 900, cap: 'عشرة أسماك من ميناءك: متى تأكل وبماذا' },
  { f: 'catch-log.webp', w: 900, cap: 'سجلّ صيدك للطباعة' },
];
const faq = [
  { q: 'ما هو التقويم؟', a: `ملف PDF من ${CAL.pages} صفحة بحجم A4 لميناء واحد تختاره، باللغة العربية، يغطي كل أيام سنة ${CAL.year}. تقرؤه على هاتفك دون إنترنت أو تطبعه وتعلّقه.` },
  { q: 'ما الموانئ المتوفرة؟', a: `${CAL.ports} ميناءً عربياً من المغرب إلى عُمان، على الأطلسي والمتوسط والبحر الأحمر والخليج العربي والمحيط الهندي. اختر ميناءك في الأعلى لترى أرقامه في ${CAL.year}.` },
  { q: 'بماذا يختلف عن الموقع المجاني؟', a: 'الموقع يعرض أياماً قليلة قادمة. التقويم يجمع السنة كلها لميناءك في ملف واحد، فتخطط رحلاتك وإجازاتك قبل أشهر، وتحجز أفضل الأيام من الآن، حتى دون إنترنت في البحر.' },
  ...(CAL_SALES_OPEN ? [
    { q: 'كيف أدفع ومتى يصلني؟', a: 'الدفع آمن على صفحة Stripe بالبطاقة أو Apple Pay أو Google Pay. بعد الدفع مباشرة تعود إلى صفحة شكر على موقعنا فيها زر تحميل تقويم ميناءك (PDF)، ويصلك إيصال الدفع على بريدك.' },
  ] : [
    { q: 'متى يصدر؟', a: 'قريباً جداً. سجّل بريدك في قائمة الانتظار لتصلك رسالة يوم الإطلاق، ويصلك سعر الإطلاق قبل الجميع بيوم.' },
  ]),
  { q: 'من أين تأتي الأرقام؟', a: 'من محرك ArabTides نفسه: نموذج المد العالمي EOT20 وحسابات فلكية للقمر والشمس، مع التوقيت المحلي لكل يوم. الارتفاعات من أدنى مستوى فلكي للجزر، كما في الجداول الرسمية.' },
  { q: 'هل يصلح للملاحة؟', a: 'لا. التقويم للصيد والنزهات. أرقام المد تقديرات فلكية، وقد يغيّرها الطقس والرياح، فراجع الجداول الرسمية لميناءك قبل الملاحة.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<BaseLayout title={`${CAL.title} لميناءك — PDF`} description={`${CAL.title}: سنة كاملة يوماً بيوم لميناءك. المد والجزر بالساعة، القمر، الشروق والغروب، أفضل ساعات الصيد وتقييم كل يوم، لـ${CAL.ports} ميناءً عربياً.`} jsonLd={jsonLd} ogImage={img('cover.webp')} noindex={!CAL.public}>
  <section class="hero">
    <div class="max-w-6xl mx-auto px-4 pt-10 pb-24 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-10 items-center">
      <div>
        <nav class="breadcrumb breadcrumb-light" aria-label="مسار التنقل"><a href={BASE}>الرئيسية</a><span class="sep">/</span><span aria-current="page">تقويم <span class="latin">{CAL.year}</span></span></nav>
        <span class="hero-chip mt-5 text-xs">📅 تقويم PDF · <span class="latin">{CAL.pages}</span> صفحة · <span class="latin">{CAL.ports}</span> ميناءً عربياً</span>
        <h1 class="mt-4 text-3xl sm:text-5xl font-bold display leading-snug">تقويم الصيد والمد والجزر <span class="latin">{CAL.year}</span> لميناءك</h1>
        <p class="mt-4 text-lg text-slate-300 leading-relaxed max-w-xl">سنة كاملة، يوماً بيوم، في ملف واحد.</p>
        <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-slate-200">
          <li>✓ المد والجزر لكل يوم بالساعة والارتفاع</li>
          <li>✓ تقييم الصيد من <span class="latin">1</span> إلى <span class="latin">5</span> لكل يوم</li>
          <li>✓ أفضل ساعات الصيد والقمر والشروق</li>
          <li>✓ أفضل <span class="latin">12</span> يوماً في السنة</li>
          <li>✓ أسماك ميناءك ومواسم المنع</li>
          <li>✓ يُقرأ دون إنترنت ويُطبع</li>
        </ul>
        {CAL_SALES_OPEN ? (
          <div class="mt-7 flex flex-wrap items-center gap-4" id="buy">
            <div class="leading-none" data-cal-price>
              {CAL.launchPrice != null && CAL.launchLink && <span class="price-launch"><span class="latin text-5xl font-extrabold text-white">{priceLabel(CAL.launchPrice)}</span>{CAL.price != null && <s class="latin ms-2 text-slate-400">{priceLabel(CAL.price)}</s>}<span class="block mt-1.5 text-xs text-amber-300">سعر الإطلاق حتى ليلة البدر</span></span>}
              {CAL.price != null && CAL.link && <span class="price-full" hidden={Boolean(CAL.launchLink)}><span class="latin text-5xl font-extrabold text-white">{priceLabel(CAL.price)}</span><span class="block mt-1.5 text-xs text-slate-300">دفعة واحدة · بلا اشتراك</span></span>}
            </div>
            <a href={launchUrl || fullUrl} data-launch={launchUrl} data-full={fullUrl} class="btn-primary text-lg cal-buy" rel="noopener"><span>اشترِ تقويم <span class="cal-port-name">{def[0]}</span></span></a>
          </div>
        ) : (
          <>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a href="#waitlist" class="btn-primary text-lg">سجّلني في قائمة الانتظار</a>
              <a href="#port" class="btn-ghost"><span>ميناؤك في <span class="latin">{CAL.year}</span></span></a>
            </div>
            <p class="mt-3 text-sm text-slate-400">✉️ سجّل، ويصلك سعر الإطلاق قبل الجميع بيوم</p>
          </>
        )}
      </div>
      <div class="cal-covers mx-auto" aria-hidden="true">
        <img src={img('cover-kuwait.webp')} alt="" width="400" height="566" class="c-side c-a" />
        <img src={img('cover-casablanca.webp')} alt="" width="400" height="566" class="c-side c-b" />
        <img src={img('cover.webp')} alt="" width="640" height="905" class="c-main" />
      </div>
    </div>
    <svg class="hero-waves" viewBox="0 0 1440 72" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 40c120-20 240-30 360-18s240 40 360 36 240-34 360-38 240 18 360 26v26H0z" fill="currentColor" />
    </svg>
  </section>

  <main id="main" class="max-w-6xl mx-auto px-4 w-full mt-4">
    <!-- Your port in 2027 -->
    <section id="port" class="mb-16 scroll-mt-20" aria-labelledby="port-title">
      <div class="section-title"><h2 id="port-title">ميناؤك في <span class="latin">{CAL.year}</span></h2><p>اختر ميناءك لترى أرقام سنته، كما في الصفحة الثانية من التقويم</p></div>
      <div class="card p-5 sm:p-6">
        <div class="flex flex-wrap items-center gap-3">
          <span class="cal-flag"><Flag code={def[1] as string} /></span>
          <label class="sr-only" for="cal-port">الميناء</label>
          <select id="cal-port" class="cal-select">
            {countries.map(cc => (
              <optgroup label={countryName(cc)}>
                {places.filter(p => p.country === cc).map(p => <option value={p.id} selected={p.id === DEFAULT_PORT}>{p.name_ar}</option>)}
              </optgroup>
            ))}
          </select>
        </div>
        <ul class="cal-stats mt-5" aria-live="polite">
          <li><span class="latin" data-k="max">{metres(def[2] as number)} م</span>أكبر مدّ في السنة<small data-k="maxm">في {monthsAr[def[3] as number]}</small></li>
          <li><span class="latin" data-k="n5">{def[4]}</span>يوماً ممتازاً للصيد<small>تقييم <span class="latin">5/5</span>، و<span class="latin" data-k="n4">{def[5]}</span> يوماً جيداً</small></li>
          <li><span data-k="best">{monthsAr[def[6] as number]}</span>أفضل شهر للصيد<small>أكثر الأيام الممتازة والجيدة</small></li>
          <li><span class="cal-type" data-k="type">{def[7]}</span>نوع المد<small data-k="micro" hidden={!def[8]}>مدّ ضعيف: التقييم يعتمد أكثر على القمر</small></li>
        </ul>
        <p class="mt-4 text-sm text-[var(--text-muted)]">كل أيام السنة، بالساعة، في تقويم <span class="font-semibold text-[var(--text-secondary)] cal-port-name">{def[0]}</span>. <a href={`${BASE}ports/${DEFAULT_PORT}`} class="cal-port-link underline">صفحة الميناء اليوم ←</a></p>
      </div>
    </section>

    <!-- What's inside -->
    <section class="mb-16" aria-labelledby="inside-title">
      <div class="section-title"><h2 id="inside-title">ماذا في التقويم؟</h2><p><span class="latin">{CAL.pages}</span> صفحة لميناءك، من الغلاف إلى سجلّ الصيد</p></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {features.map(f => (
          <div class="card p-5">
            <span class="w-10 h-10 rounded-xl bg-[var(--accent-muted)] flex items-center justify-center text-xl" aria-hidden="true">{f.icon}</span>
            <h3 class="mt-3 font-semibold leading-snug">{f.title}</h3>
            <p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">{f.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Sample pages -->
    <section class="mb-16" aria-labelledby="pages-title">
      <div class="section-title"><h2 id="pages-title">صفحات من التقويم</h2><p>مثال: تقويم دبي <span class="latin">{CAL.year}</span></p></div>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
        {pages.map(p => (
          <figure class="card p-2">
            <div class:list={['cal-page', { 'cal-lock': p.lock }]}>
              <img src={img(p.f)} alt={p.cap} width={p.w} height={Math.round(p.w * 2246 / 1588)} loading="lazy" class="w-full h-auto rounded-lg border border-[var(--border-subtle)]" />
              {p.lock && <span class="cal-lock-label">🔒 في التقويم</span>}
            </div>
            <figcaption class="text-xs text-[var(--text-muted)] text-center mt-2 leading-relaxed">{p.cap}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Waitlist (until sales open): email + port, no gift -->
    {!CAL_SALES_OPEN && (
    <section id="waitlist" class="mb-16 scroll-mt-20" aria-labelledby="waitlist-title">
      <div class="card p-6 sm:p-8 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 items-center" style="background:linear-gradient(135deg,#ecfdf5,#f0fdfa);border-color:#99f6e4">
        <div>
          <span class="text-xs font-semibold text-[var(--accent-text)] bg-white rounded-full px-3 py-1">قائمة الانتظار</span>
          <h2 id="waitlist-title" class="mt-3 text-2xl font-bold display">كن أول من يعرف</h2>
          <p class="mt-2 text-[var(--text-secondary)] leading-relaxed">سجّل بريدك، ويصلك سعر الإطلاق قبل الجميع بيوم، مع رابط تقويم ميناءك: <span class="font-semibold cal-port-name">{def[0]}</span>.</p>
          <ul class="mt-3 text-sm text-[var(--text-secondary)] space-y-1">
            <li>✓ رسالة واحدة يوم الإطلاق، لا رسائل مزعجة</li>
            <li>✓ سعر الإطلاق قبل الجميع بيوم</li>
          </ul>
          <div class="mt-5 max-w-xl"><SignupForm source="calendar" port={DEFAULT_PORT} product={CAL.id} gift={false} cta="سجّلني في قائمة الانتظار" done="✓ سجّلناك! سنراسلك بسعر الإطلاق قبل الجميع بيوم." /></div>
        </div>
        <img src={img('cover.webp')} alt="" width="640" height="905" loading="lazy" class="w-44 h-auto rounded-lg shadow-lg mx-auto -rotate-2" />
      </div>
    </section>
    )}

    <!-- FAQ -->
    <section class="mb-16" aria-labelledby="faq-title">
      <h2 id="faq-title" class="text-2xl font-bold display">أسئلة شائعة</h2>
      <div class="card mt-4 px-5 divide-y divide-[var(--border-subtle)]">
        {faq.map((f, i) => (
          <details class="faq py-4" open={i === 0}>
            <summary class="flex items-center gap-3 cursor-pointer font-medium list-none"><span class="faq-icon" aria-hidden="true">+</span>{f.q}</summary>
            <p class="mt-2 ps-9 leading-relaxed text-[var(--text-secondary)]">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-4 text-xs text-[var(--text-muted)] text-center">تقديرات فلكية — ليست للملاحة. <a href={`${BASE}methodology`} class="underline">كيف نحسب</a></p>
    </section>
  </main>

  <script type="application/json" id="cal-data" set:html={JSON.stringify({ stats, months: monthsAr, base: BASE, flags: `${BASE}flags/`, end: CAL.launchPriceEnd, ref: CAL.id })} />
  <script is:inline>
    (function () {
      var D = JSON.parse(document.getElementById('cal-data').textContent), sel = document.getElementById('cal-port');
      var q = new URLSearchParams(location.search).get('port'), saved = null;
      try { saved = JSON.parse(localStorage.getItem('arabtides.myPort') || 'null'); } catch (e) {}
      var start = (q && D.stats[q]) ? q : (saved && D.stats[saved.id]) ? saved.id : null;
      var $ = function (k) { return document.querySelector('[data-k="' + k + '"]'); };
      var launch = Date.now() < Date.parse(D.end);

      // Sales mode: launch price until the full moon, then the full-price link
      document.querySelectorAll('.price-launch').forEach(function (el) { if (!launch) el.hidden = true; });
      document.querySelectorAll('.price-full').forEach(function (el) { el.hidden = launch && !!document.querySelector('.price-launch'); });

      function show(id, fromUser) {
        var s = D.stats[id];
        if (!s) return;
        $('max').textContent = (s[2] / 100).toFixed(2) + ' م';
        $('maxm').textContent = 'في ' + D.months[s[3]];
        $('n5').textContent = s[4]; $('n4').textContent = s[5];
        $('best').textContent = D.months[s[6]];
        $('type').textContent = s[7];
        $('micro').hidden = !s[8];
        var flag = document.querySelector('.cal-flag img');
        if (flag) { flag.src = D.flags + s[1] + '.svg'; flag.alt = ''; }
        document.querySelectorAll('.cal-port-name').forEach(function (el) { el.textContent = s[0]; });
        document.querySelectorAll('.cal-port-link').forEach(function (el) { el.href = D.base + 'ports/' + id; });
        document.querySelectorAll('form.signup input[name=port]').forEach(function (el) { el.value = id; });
        document.querySelectorAll('.cal-buy').forEach(function (a) {
          var link = (launch && a.dataset.launch) || a.dataset.full || a.dataset.launch;
          if (link) a.href = link.replace(/client_reference_id=[^&]*/, 'client_reference_id=' + D.ref + '-' + id.replace(/[^A-Za-z0-9_-]/g, '_'));
        });
        if (fromUser) {
          try { if (window.va) window.va('event', { name: 'port_select', data: { port: id } }); } catch (e) {}
          try { if (window.gtag) window.gtag('event', 'port_select', { port: id }); } catch (e) {}
        }
      }
      if (start) { sel.value = start; show(start); } else show(sel.value);
      sel.addEventListener('change', function () { show(sel.value, true); });
    })();
  </script>
</BaseLayout>

<style>
  .cal-covers { position: relative; width: 17rem; height: 23rem; }
  .cal-covers img { position: absolute; top: 0; border-radius: 0.6rem; box-shadow: 0 24px 50px -12px rgba(0,0,0,.55); }
  .cal-covers .c-main { width: 15rem; inset-inline-start: 1rem; z-index: 2; }
  .cal-covers .c-side { width: 12rem; top: 2rem; opacity: .9; }
  .cal-covers .c-a { inset-inline-start: -2.5rem; rotate: 8deg; }
  .cal-covers .c-b { inset-inline-end: -2.5rem; rotate: -8deg; }
  @media (max-width: 639px) {
    .cal-covers { width: 13rem; height: 17rem; }
    .cal-covers .c-main { width: 11rem; }
    .cal-covers .c-side { width: 8.5rem; }
    .cal-covers .c-a { inset-inline-start: -1.25rem; }
    .cal-covers .c-b { inset-inline-end: -1.25rem; }
  }
  .cal-flag :global(img) { width: 2.25rem; height: auto; border-radius: 0.2rem; box-shadow: 0 0 0 1px var(--border-subtle); }
  .cal-select { flex: 1 1 14rem; min-width: 0; padding: 0.65rem 0.9rem; border-radius: 0.75rem; border: 1px solid var(--border-subtle);
    background: var(--surface-card); color: var(--text-primary); font-size: 1.05rem; font-weight: 600; }
  .cal-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  @media (min-width: 768px) { .cal-stats { grid-template-columns: repeat(4, 1fr); } }
  .cal-stats li { padding: 1rem; border-radius: 0.9rem; background: var(--accent-muted); text-align: center; font-size: 0.9rem; color: var(--text-secondary); }
  .cal-stats li > span:first-child { display: block; font-size: 1.75rem; font-weight: 800; color: var(--accent-text); line-height: 1.3; }
  .cal-stats li .cal-type { font-size: 1.05rem; line-height: 1.5; padding-block: 0.3rem; }
  .cal-stats small { display: block; margin-top: 0.25rem; font-size: 0.75rem; color: var(--text-muted); }
  .cal-page { position: relative; overflow: hidden; border-radius: 0.5rem; }
