---
import BaseLayout from '../../layouts/BaseLayout.astro';
import placesIndex from '../../data/places/places_index.json';

export function getStaticPaths() {
  const codes = [...new Set(placesIndex.map((p: { country: string }) => p.country))];
  return codes.map(code => ({ params: { code } }));
}

const { code } = Astro.params;
const BASE = import.meta.env.BASE_URL;

const countryNames: Record<string, string> = {
  AE: 'الإمارات', BH: 'البحرين', DJ: 'جيبوتي', DZ: 'الجزائر',
  EG: 'مصر', IQ: 'العراق', JO: 'الأردن', KM: 'جزر القمر',
  KW: 'الكويت', LB: 'لبنان', LY: 'ليبيا', MA: 'المغرب',
  MR: 'موريتانيا', OM: 'عُمان', PS: 'فلسطين', QA: 'قطر',
  SA: 'السعودية', SD: 'السودان', SO: 'الصومال', SY: 'سوريا',
  TN: 'تونس', YE: 'اليمن',
};

const name = countryNames[code!] || code!;
const ports = placesIndex.filter((p: { country: string }) => p.country === code);
const title = `موانئ ${name}`;
---

<BaseLayout title={title} description={`مواقيت المد والجزر للموانئ في ${name}`}>
  <div class="min-h-screen flex flex-col">

    <!-- Top bar -->
    <header class="sticky top-0 z-10 backdrop-blur-md bg-[#0a0f16]/90 border-b border-[rgba(255,255,255,0.06)]">
      <div class="max-w-4xl mx-auto px-4 py-3 flex items-center gap-4">
        <a href={BASE} class="flex items-center gap-2 shrink-0 text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors">
          <span class="text-sm">&larr;</span>
          <span class="text-sm">الرئيسية</span>
        </a>
        <span class="text-[var(--text-dim)] text-sm hidden sm:inline">/</span>
        <span class="text-[var(--text-primary)] text-sm font-medium">{name}</span>
        <span class="text-xs text-[var(--text-dim)] ml-auto shrink-0">{ports.length} ميناء</span>
      </div>
    </header>

    <main class="flex-1 max-w-4xl mx-auto px-4 py-8 w-full">
      <h1 class="text-2xl font-semibold text-white mb-2">{title}</h1>
      <p class="text-sm text-[var(--text-secondary)] mb-8">
        اختر ميناء لعرض مواقيت المد والجزر والحسابات الفلكية
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {ports.map((port: { id: string; name_ar: string; name_en: string; lat: number; lon: number }) => (
          <a
            href={`${BASE}ports/${port.id}`}
            class="block p-4 rounded-[var(--radius-lg)]
                   bg-[var(--surface-card)]
                   border border-[var(--border-subtle)]
                   hover:border-[var(--accent-border)]
                   hover:bg-[var(--surface-elevated)]
                   transition-all duration-150"
          >
            <div class="flex items-center gap-3">
              <span class="text-[var(--accent)] text-sm opacity-60">⚓</span>
              <div>
                <div class="text-white font-medium">{port.name_ar}</div>
                <div class="text-xs text-[var(--text-dim)] latin mt-0.5">
                  {port.name_en} &middot; {port.lat.toFixed(2)}&deg;N, {port.lon.toFixed(2)}&deg;E
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 pt-8 border-t border-[var(--border-subtle)] text-center">
        <a href={BASE} class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">
          &larr; العودة للرئيسية
        </a>
      </div>
    </main>

  </div>
</BaseLayout>