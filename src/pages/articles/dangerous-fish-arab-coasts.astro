---
import ArticleLayout from '../../components/ArticleLayout.astro';
import { articleBySlug } from '../../lib/articles';
import { fish } from '../../lib/fish';

const meta = articleBySlug('dangerous-fish-arab-coasts');
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const F = (id: string) => fish.find(f => f.id === id)!;
const link = (id: string) => `${BASE}fish/${id}`;

const toc = [
  { id: 'spines', label: 'أشواك سامة: لا تمسكها بيدك' },
  { id: 'rays', label: 'اللخم والرعّاد: خطر تحت الرمل' },
  { id: 'eat', label: 'أسماك لا تأكلها' },
  { id: 'teeth', label: 'أسنان ومخالب' },
  { id: 'aid', label: 'الإسعاف الأولي خطوة بخطوة' },
  { id: 'kit', label: 'ما تحمله في حقيبة الصيد' },
];
const takeaways = [
  'وخز الأشواك السامة (سمكة الأسد، عقرب البحر، الصافي، اللخم) يُعالج أولاً بـ<strong>الماء الساخن</strong>: الحرارة تكسر السم.',
  '<strong>سمكة الأرنب</strong> في المتوسط والبحر الأحمر سامة قاتلة إذا أُكلت، والطهي لا يزيل سمها.',
  'الأفراد الكبيرة من <strong>الباراكودا</strong> وبعض أسماك الشعاب قد تحمل سم السيغواتيرا؛ اختر الأحجام المتوسطة للأكل.',
  'في الماء الضحل الرملي امشِ <strong>بخطوات جارّة</strong> حتى تبتعد اللخم قبل أن تدوس عليها.',
];
const faq = [
  { q: 'ماذا أفعل إذا وخزتني سمكة الأسد أو عقرب البحر؟', a: 'اخرج من الماء، انزع أي بقايا شوكة ظاهرة بحذر، ثم اغمر مكان الوخزة في ماء ساخن تحتمله يدك (نحو 40 إلى 45 درجة) لمدة 30 إلى 90 دقيقة، وجرّب حرارة الماء بيدك السليمة أولاً. ثم راجع الطبيب، وفوراً إذا ظهر ضيق تنفس أو دوار.' },
  { q: 'هل يزول سم سمكة الأرنب بالطهي؟', a: 'لا. سم التيترودوتوكسين لا يزول بالطهي ولا بالتجميد ولا بالتمليح، وقد سُجلت حالات وفاة في دول المتوسط بعد أكلها. لا تأكلها ولا تبعها ولا تعطها لأحد.' },
  { q: 'هل كل الباراكودا خطرة على الأكل؟', a: 'لا. الصغيرة والمتوسطة تؤكل في كثير من البلدان. الخطر يتركز في الأفراد الكبيرة من الشعاب الاستوائية، لأن سم السيغواتيرا يتراكم في السلسلة الغذائية. اسأل الصيادين المحليين عن الأحجام والأماكن التي يتجنبونها.' },
  { q: 'هل أشواك الصافي (السيجان) سامة فعلاً؟', a: 'نعم. في أشواك زعانفه غدد سامة، والوخزة مؤلمة لساعات لكنها نادراً ما تكون خطرة. تُعالج بالماء الساخن مثل غيرها.' },
  { q: 'هل يجب أن أمص مكان اللسعة أو أجرحه؟', a: 'لا. لا تجرح المكان ولا تمصه ولا تربط الطرف برباط ضاغط. الماء الساخن ثم الطبيب هو الطريق الصحيح.' },
];
---

<ArticleLayout meta={meta} toc={toc} takeaways={takeaways} faq={faq} relatedPorts={['alexandria', 'beirut', 'hurghada', 'jeddah']}>
  <svg slot="art" viewBox="0 0 300 260" class="w-full h-auto">
    <path d="M150 40 L260 220 H40 Z" fill="none" stroke="#fde68a" stroke-width="10" stroke-linejoin="round"/>
    <path d="M150 105 v55" stroke="#fde68a" stroke-width="12" stroke-linecap="round"/><circle cx="150" cy="190" r="8" fill="#fde68a"/>
    <g fill="#f43f5e" opacity=".85"><path d="M40 70 l14 -30 l6 32z"/><path d="M62 74 l10 -36 l8 38z"/><path d="M86 80 l6 -34 l10 36z"/></g>
  </svg>

  <p>معظم ما تصطاده على سواحلنا آمن تماماً. لكن في كل بحر عربي أسماكاً قليلة تستحق أن تعرفها قبل أن تمد يدك إليها أو تضعها في القدر. هذا الدليل يجمعها في مكان واحد، مع ما تفعله إذا أصابك شيء منها.</p>

  <h2 id="spines">أشواك سامة: لا تمسكها بيدك</h2>
  <p>أكثر الإصابات شيوعاً عند الصيادين ليست العضة، بل <strong>الوخزة</strong>: شوكة زعنفة تخترق الجلد وتحقن سماً يسبب ألماً حاداً وتورماً قد يستمر ساعات. والأسماك التي تفعل ذلك كثيراً ما تبدو بريئة.</p>
  <ul>
    <li><a href={link('lionfish')}><strong>{F('lionfish').ar}</strong></a>: أشواكها الظهرية والحوضية والشرجية كلها سامة. موطنها البحر الأحمر، وانتشرت في شرق المتوسط بعد عبورها قناة السويس، فصارت تُصادف في لبنان وسوريا ومصر.</li>
    <li><a href={link('scorpionfish')}><strong>{F('scorpionfish').ar}</strong></a>: تختبئ بين الصخور بلون الطحالب حتى يكاد لا يراها أحد، فيُمسكها الصياد وهو يظنها حجراً أو سمكة عادية.</li>
    <li><a href={link('safi')}><strong>{F('safi').ar}</strong></a> (السيجان أو البطاطا): من أكثر الأسماك التي يصطادها الناس من الصخور في الخليج والمتوسط، وأشواكه مؤلمة جداً. أمسكه دائماً بقطعة قماش.</li>
  </ul>
  <div class="callout tip"><span class="ic">🧤</span><div>عادة بسيطة تحميك من معظم هذه الإصابات: لا تمسك أي سمكة شوكية بيدك المجردة، واستخدم قطعة قماش مبللة أو ملقطاً لإخراج الخطاف.</div></div>

  <h2 id="rays">اللخم والرعّاد: خطر تحت الرمل</h2>
  <p>تدفن أنواع كثيرة من اللخم نفسها في الرمل الضحل. وهي لا تهاجم، لكن من يدوس عليها يتلقى ضربة من شوكة ذيلها المسننة السامة، فتسبب جرحاً عميقاً وألماً شديداً. أشهرها على الشعاب <a href={link('bluespotray')}>{F('bluespotray').ar}</a> في البحر الأحمر.</p>
  <p>الحل سهل: حين تمشي في الماء الضحل فوق الرمل، <strong>جرّ قدميك</strong> بدل رفعهما. الاهتزاز يجعل اللخمة تبتعد قبل أن تصل إليها.</p>
  <p>أما <a href={link('torpedo')}>{F('torpedo').ar}</a> في المتوسط والأطلسي فلا شوكة له، لكنه يصعق من يلمسه بتيار كهربائي قوي، حتى وهو عالق في الشبكة. لا تلمسه بيدك.</p>

  <h2 id="eat">أسماك لا تأكلها</h2>
  <p>هنا الخطر أكبر، لأن السم لا يظهر في شكل السمكة ولا رائحتها، ولا يزول بالطهي.</p>
  <div class="callout warn"><span class="ic">☠️</span><div><a href={link('puffer')}><strong>{F('puffer').ar}</strong></a>: عبرت من البحر الأحمر وانتشرت في كل شرق المتوسط. يحمل جسمها سماً عصبياً قاتلاً، وقد سُجلت وفيات بعد أكلها. تُعرف بجسمها الفضي ونقاطها الداكنة وأسنانها الأربعة الملتحمة كالمنقار، وبقدرتها على الانتفاخ. لا تأكلها أبداً.</div></div>
  <p><strong>السيغواتيرا:</strong> سم تنتجه طحالب دقيقة على الشعاب، تأكلها أسماك صغيرة، ثم تأكلها أسماك أكبر، فيتراكم السم في المفترسات الكبيرة. أكثر الأسماك ارتباطاً به عندنا الأفراد الكبيرة من <a href={link('barracuda')}>الباراكودا</a> وبعض أنواع <a href={link('hamra')}>النهاش</a> مثل البهار، و<a href={link('gt')}>الجش الكبير</a>. أعراضه اضطرابات في المعدة ثم تنميل وإحساس معكوس بالحرارة والبرودة. والقاعدة: كلما كبرت سمكة الشعاب المفترسة زاد الاحتمال.</p>
  <p><strong>الهلوسة:</strong> قد يسبب أكل رأس <a href={link('salema')}>{F('salema').ar}</a> أو أحشائها في مواسم معينة هلوسات وكوابيس تستمر أياماً. نظّفها جيداً وتخلص من الرأس والأحشاء.</p>

  <h2 id="teeth">أسنان ومخالب</h2>
  <p>بعض الأسماك لا تحمل سماً، لكن أسنانها تجرح بعمق إذا أدخلت أصابعك في فمها لإخراج الخطاف: <a href={link('kanad')}>{F('kanad').ar}</a> والباراكودا و<a href={link('nuwaibi')}>{F('nuwaibi').ar}</a>. ولـ<a href={link('bluecrab')}>{F('bluecrab').ar}</a> مخالب قوية، أمسكه من الخلف. وعلى ذيل <a href={link('sohal')}>{F('sohal').ar}</a> شوكة كالمشرط. استخدم دائماً كماشة أو أداة لإخراج الخطاف.</p>

  <h2 id="aid">الإسعاف الأولي خطوة بخطوة</h2>
  <p>معظم سموم الأشواك البحرية بروتينات تتكسر بالحرارة. لذلك يتفق الأطباء على خطوات بسيطة لوخزات الأشواك ولسعات اللخم:</p>
  <ol>
    <li>اخرج من الماء واجلس في الظل، واطلب المساعدة إن كنت وحدك.</li>
    <li>انزع بحذر أي جزء ظاهر من الشوكة، دون أن تضغط على الجرح.</li>
    <li>اغمر مكان الإصابة في <strong>ماء ساخن</strong> تحتمله اليد السليمة، نحو 40 إلى 45 درجة، لمدة 30 إلى 90 دقيقة. جرّب الماء بيدك السليمة أولاً حتى لا تحترق، لأن المكان المصاب قد لا يشعر بالحرارة.</li>
    <li>نظّف الجرح بالماء والصابون، وراجع الطبيب، فقد تبقى قطع صغيرة من الشوكة تسبب التهاباً.</li>
    <li>اطلب الإسعاف فوراً إذا ظهر ضيق في التنفس أو تورم في الوجه أو دوار أو ألم في الصدر.</li>
  </ol>
  <p>وفي حالات التسمم بالأكل، كسمكة الأرنب، لا انتظار: أي تنميل في الشفاه أو اللسان بعد أكل سمكة يعني التوجه إلى الطوارئ فوراً.</p>
  <div class="pull">لا تجرح مكان اللسعة، ولا تمصه، ولا تربطه برباط ضاغط.</div>

  <h2 id="kit">ما تحمله في حقيبة الصيد</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-5">
    <div class="card p-4"><div class="font-semibold">🔧 كماشة طويلة</div><p class="text-sm text-[var(--text-secondary)] !my-1">لإخراج الخطاف دون أن تقترب أصابعك من الأسنان والأشواك.</p></div>
    <div class="card p-4"><div class="font-semibold">🧤 قطعة قماش أو قفاز</div><p class="text-sm text-[var(--text-secondary)] !my-1">للإمساك بالأسماك الشوكية مثل الصافي وعقرب البحر.</p></div>
    <div class="card p-4"><div class="font-semibold">♨️ ترمس ماء ساخن</div><p class="text-sm text-[var(--text-secondary)] !my-1">في رحلات الصخور والقوارب البعيدة، قد يكون أهم ما في الحقيبة.</p></div>
    <div class="card p-4"><div class="font-semibold">🩹 إسعافات أولية</div><p class="text-sm text-[var(--text-secondary)] !my-1">مطهر، ضمادات، ملقط، ورقم الإسعاف في بلدك.</p></div>
  </div>
  <p>وتعرّف على الأسماك قبل أن تصطادها: في <a href={`${BASE}fish`}>دليل الأسماك</a> صور وأسماء محلية لكل نوع، مع تحذير واضح على صفحة كل سمكة خطرة.</p>
  <p class="text-sm text-[var(--text-muted)]">هذه معلومات عامة للتوعية، ولا تغني عن استشارة الطبيب.</p>
</ArticleLayout>
