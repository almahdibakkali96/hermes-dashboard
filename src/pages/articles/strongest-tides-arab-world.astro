---
import ArticleLayout from '../../components/ArticleLayout.astro';
import { articleBySlug } from '../../lib/articles';
import { yearStats, seas, type SeaId } from '../../lib/seas';
import { countryName } from '../../lib/countries';

const meta = articleBySlug('strongest-tides-arab-world');
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const year = new Date().getUTCFullYear();
const rows = await yearStats(year);            // sorted by maxRange, largest first
const top = rows[0], bottom = rows[rows.length - 1];
const maxR = top.maxRange;
const m = (cm: number) => (cm / 100).toFixed(1);
const dateAr = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('ar-EG-u-nu-latn', { day: 'numeric', month: 'long' });
const byId = (id: string) => rows.find(r => r.id === id)!;

// Per-sea summaries
const seaOrder: SeaId[] = ['gulf', 'indian', 'atlantic', 'red', 'med'];
const seaStats = seaOrder.map(id => {
  const list = rows.filter(r => r.sea === id);
  return { id, ...seas[id], list, max: list[0], min: list[list.length - 1] };
});
const med = seaStats.find(s => s.id === 'med')!, red = seaStats.find(s => s.id === 'red')!, atl = seaStats.find(s => s.id === 'atlantic')!;
const gulf = seaStats.find(s => s.id === 'gulf')!, ind = seaStats.find(s => s.id === 'indian')!;
const overOneM = rows.filter(r => r.maxRange >= 100).length;
const underHalfM = rows.filter(r => r.maxRange < 50).length;
const gabes = byId('gabes'), jeddah = byId('jeddah'), portSudan = byId('port-sudan'), alex = byId('alexandria');

const why: Record<SeaId, string> = {
  gulf: `موجة المد تدخل الخليج من مضيق هرمز وتنعكس داخله. في رأس الخليج، عند الكويت وأم قصر وشط العرب، يتراكم الماء فيصل المدى إلى نحو ${m(gulf.max.maxRange)} م، بينما يقل في الوسط قرب ${gulf.min.name_ar} (${m(gulf.min.maxRange)} م).`,
  indian: `سواحل مفتوحة على المحيط الهندي وبحر العرب. أكبرها في ${ind.max.name_ar} (${m(ind.max.maxRange)} م)، وفي خليج عدن وخليج عُمان يتراوح المدى بين 2 و3 أمتار تقريباً.`,
  atlantic: `ساحل مفتوح مباشرة على المحيط الأطلسي، والمد نصف يومي منتظم. يبلغ المدى نحو ${m(atl.max.maxRange)} م في ${atl.max.name_ar}، ويتناقص جنوباً حتى ${atl.min.name_ar} (${m(atl.min.maxRange)} م).`,
  red: `البحر الأحمر طويل وضيق، ويقع في وسطه تقريباً «نقطة لا مد» (نقطة أمفيدرومية) يكاد المد يختفي حولها: ${portSudan.name_ar} ${portSudan.maxRange} سم و${jeddah.name_ar} ${jeddah.maxRange} سم فقط. ويزداد المدى نحو الطرفين، كما في ${red.max.name_ar} (${red.max.maxRange} سم).`,
  med: `البحر المتوسط شبه مغلق ويتصل بالمحيط عبر مضيق جبل طارق الضيق، فلا تدخله إلا موجة مد صغيرة: معظم موانئه أقل من نصف متر، مثل ${alex.name_ar} (${alex.maxRange} سم). الاستثناء خليج قابس في تونس، حيث يضخّم الجرف الضحل الواسع المد في ${gabes.name_ar} إلى نحو ${m(gabes.maxRange)} م.`,
};

const toc = [
  { id: 'ranking', label: 'الترتيب الكامل' },
  { id: 'scale', label: 'كم يبلغ 4 أمتار؟' },
  { id: 'seas', label: 'بحر ببحر: لماذا الاختلاف؟' },
  { id: 'fishers', label: 'ماذا يعني هذا للصياد؟' },
  { id: 'method', label: 'كيف حسبنا الأرقام' },
];
const takeaways = [
  `أقوى مد في الموانئ العربية في <strong>${top.name_ar}</strong> (${countryName(top.country)}): يصل الفرق بين المد والجزر إلى نحو <strong>${m(top.maxRange)} م</strong> في ${year}.`,
  `<strong>${overOneM}</strong> ميناءً من ${rows.length} يتجاوز فيها المدى متراً واحداً، و<strong>${underHalfM}</strong> لا يصل فيها إلى نصف متر.`,
  `في <strong>البحر المتوسط</strong> و<strong>وسط البحر الأحمر</strong> يكاد المد يختفي: ${bottom.name_ar} ${bottom.maxRange} سم فقط.`,
  `ساحل <strong>المغرب الأطلسي</strong> يشهد مداً منتظماً قرابة 3 أمتار، مرتين يومياً.`,
];
const faq = [
  { q: 'أين أقوى مد وجزر في العالم العربي؟', a: `حسب حسابات ArabTides لعام ${year}، أكبر مدى يومي بين ${rows.length} ميناءً عربياً في ${top.name_ar} (${countryName(top.country)}) بنحو ${m(top.maxRange)} م، تليها ${rows[1].name_ar} (${m(rows[1].maxRange)} م) و${rows[2].name_ar} (${m(rows[2].maxRange)} م).` },
  { q: 'لماذا لا يوجد مد تقريباً في البحر المتوسط؟', a: `لأنه بحر شبه مغلق يتصل بالمحيط الأطلسي عبر مضيق جبل طارق الضيق، فلا تدخله إلا موجة مد صغيرة. معظم الموانئ العربية على المتوسط مداها أقل من 50 سم، باستثناء خليج قابس (${gabes.name_ar} نحو ${m(gabes.maxRange)} م).` },
  { q: 'كم يبلغ المد والجزر في جدة؟', a: `المد في جدة صغير جداً: أقصى مدى يومي نحو ${jeddah.maxRange} سم في ${year}، لأنها قريبة من نقطة انعدام المد في وسط البحر الأحمر.` },
  { q: 'كم يبلغ المد والجزر في الكويت؟', a: `في مدينة الكويت يصل أقصى مدى يومي إلى نحو ${m(byId('kuwait-city').maxRange)} م (${dateAr(byId('kuwait-city').maxRangeDate)})، وهو من أكبر المديات في المنطقة.` },
  { q: 'ما مصدر هذه الأرقام؟', a: 'حسبها ArabTides من نموذج EOT20 العالمي للمد والجزر (Hart-Davis et al. 2021) لكل يوم من السنة. هي تقديرات فلكية وليست قياسات رسمية، وقد تختلف قليلاً عن جداول الموانئ الرسمية.' },
];
---

<ArticleLayout meta={meta} toc={toc} takeaways={takeaways} faq={faq} relatedPorts={[top.id, 'casablanca', 'jeddah', 'alexandria']}>
  <div slot="art" class="text-center">
    <div class="text-slate-400 text-sm">أقوى مد عربي</div>
    <div class="latin font-extrabold text-7xl text-teal-300 leading-none mt-2">{m(top.maxRange)}<span class="text-3xl"> m</span></div>
    <div class="mt-2 text-lg">{top.name_ar}</div>
    <svg viewBox="0 0 280 90" class="w-full mt-4"><path d="M0 60 C35 60 35 10 70 10 S105 85 140 85 S175 10 210 10 S245 60 280 60" fill="none" stroke="#2dd4bf" stroke-width="5" stroke-linecap="round"/></svg>
  </div>

  <p>بين الدار البيضاء والكويت، يتصرف البحر بطرق مختلفة جداً. في ميناء يرتفع الماء وينخفض قرابة <strong>{m(top.maxRange)} أمتار</strong>، وفي آخر لا يتجاوز الفرق <strong>{bottom.maxRange} سنتيمتراً</strong>. حسبنا أقصى مدى يومي للمد والجزر في كل ميناء من موانئ ArabTides الـ{rows.length} لكل يوم من عام {year} — وهذه النتيجة.</p>

  <div class="stat-grid">
    <div class="stat"><div class="v">{m(top.maxRange)} م</div><div class="l">أكبر مدى: {top.name_ar}</div></div>
    <div class="stat"><div class="v">{bottom.maxRange} سم</div><div class="l">أصغر مدى: {bottom.name_ar}</div></div>
    <div class="stat"><div class="v">{overOneM}/{rows.length}</div><div class="l">موانئ مداها فوق متر</div></div>
  </div>

  <h2 id="ranking">الترتيب الكامل: {rows.length} ميناءً</h2>
  <p>أقصى فرق بين أعلى مد وأدنى جزر في يوم واحد خلال {year}. الألوان تمثل البحر:</p>
  <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm my-3">
    {seaOrder.map(id => <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm" style={`background:${seas[id].color}`}></span>{seas[id].name}</span>)}
  </div>
  <figure class="figure !p-3 sm:!p-5">
    <ol class="space-y-1.5" aria-label="ترتيب الموانئ حسب أقصى مدى للمد">
      {rows.map((r, i) => (
        <li>
          <a href={`${BASE}ports/${r.id}`} class="rank-row group">
            <span class="latin text-xs text-[var(--text-muted)] w-6 text-center">{i + 1}</span>
            <span class="w-28 sm:w-36 truncate text-sm group-hover:text-[var(--accent-text)]">{r.name_ar}</span>
            <span class="flex-1 h-5 rounded-md bg-[var(--surface-elevated)] overflow-hidden">
              <span class="block h-full rounded-md" style={`width:${Math.max(2, (r.maxRange / maxR) * 100)}%;background:${seas[r.sea].color}`}></span>
            </span>
            <span class="latin text-sm font-semibold w-16 text-start">{r.maxRange >= 100 ? `${m(r.maxRange)} m` : `${r.maxRange} cm`}</span>
          </a>
        </li>
      ))}
    </ol>
    <figcaption>اضغط على أي ميناء لرؤية جدول المد اليومي.</figcaption>
  </figure>

  <h2 id="scale">كم يبلغ {m(top.maxRange)} أمتار فعلاً؟</h2>
  <p>تخيّل شخصاً طوله 1.75 م يقف على الشاطئ عند أدنى جزر. هذا ارتفاع الماء فوقه عند المد العالي في ثلاثة موانئ:</p>
  <figure class="figure">
    <div class="flex items-end justify-around gap-4 h-64 chart-ltr">
      {[top, byId('casablanca'), jeddah].map(r => {
        const H = 230, scale = H / Math.max(top.maxRange, 175);
        return (
          <div class="flex flex-col items-center gap-2 w-28">
            <div class="relative w-full flex items-end justify-center" style={`height:${H}px`}>
              <div class="absolute bottom-0 inset-x-0 rounded-t-lg" style={`height:${r.maxRange * scale}px;background:linear-gradient(180deg,rgba(45,212,191,.55),rgba(13,148,136,.25));border-top:3px solid #0d9488`}></div>
              <svg viewBox="0 0 20 60" style={`height:${175 * scale}px`} class="relative" aria-hidden="true"><circle cx="10" cy="6" r="5" fill="#334155"/><path d="M4 14h12l-2 22h-2l-1 24h-2l-1-24H6z" fill="#334155"/></svg>
            </div>
            <div class="text-center"><div class="font-semibold text-sm">{r.name_ar}</div><div class="latin text-xs text-[var(--text-muted)]">{r.maxRange >= 100 ? `${m(r.maxRange)} m` : `${r.maxRange} cm`}</div></div>
          </div>
        );
      })}
    </div>
    <figcaption>الماء عند أقصى مد مقارنة بإنسان طوله 1.75 م (بالمقياس نفسه).</figcaption>
  </figure>

  <h2 id="seas">بحر ببحر: لماذا كل هذا الاختلاف؟</h2>
  <p>قوة جذب القمر واحدة في كل مكان. الذي يختلف هو <strong>شكل البحر وعمقه</strong>: موجة المد تتضخم في الخلجان الضحلة الطويلة، وتضعف في البحار المغلقة أو قرب «نقاط انعدام المد».</p>
  <div class="space-y-4 my-6">
    {seaStats.map(s => (
      <div class="card p-5" style={`border-inline-start:5px solid ${s.color}`}>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="font-bold text-lg !m-0">{s.name}</h3>
          <span class="text-sm text-[var(--text-muted)]">من <span class="latin">{s.min.maxRange >= 100 ? m(s.min.maxRange) + ' m' : s.min.maxRange + ' cm'}</span> إلى <span class="latin">{s.max.maxRange >= 100 ? m(s.max.maxRange) + ' m' : s.max.maxRange + ' cm'}</span></span>
        </div>
        <p class="!mt-2 !mb-3 text-[var(--text-secondary)]">{why[s.id]}</p>
        <div class="flex flex-wrap gap-1.5">
          {s.list.map(r => <a href={`${BASE}ports/${r.id}`} class="text-xs px-2.5 py-1 rounded-full bg-[var(--surface-elevated)] hover:bg-[var(--accent-muted)] hover:text-[var(--accent-text)]">{r.name_ar}</a>)}
        </div>
      </div>
    ))}
  </div>
  <div class="callout fact"><span class="ic">🌀</span><div><strong>النقطة الأمفيدرومية</strong> مكان في البحر لا يرتفع فيه الماء ولا ينخفض تقريباً، وتدور موجة المد حوله كعقارب الساعة. كلما ابتعدت عنه كبر المد. في وسط البحر الأحمر واحدة منها، وهذا سر هدوء المد في جدة وبورتسودان.</div></div>

  <h2 id="fishers">ماذا يعني هذا للصياد؟</h2>
  <ul class="bullets">
    <li><strong>في الموانئ ذات المد الكبير</strong> (الخليج، الأطلسي، المحيط الهندي): المد يغيّر الشاطئ تماماً. التيار قوي، وأوقات المد هي أهم عامل في نجاح رحلة الصيد — وفي سلامتك.</li>
    <li><strong>في الموانئ ذات المد الصغير</strong> (المتوسط، وسط البحر الأحمر): الرياح والطقس تؤثر في مستوى الماء أكثر من المد نفسه. طور القمر وأوقات الشروق والغروب أكثر فائدة لك.</li>
  </ul>
  <div class="pull">في الكويت قد يغطي المد العالي رصيفاً كان مكشوفاً قبل ست ساعات. في الإسكندرية بالكاد تلاحظ الفرق.</div>

  <h2 id="method">كيف حسبنا الأرقام</h2>
  <p>لكل ميناء، حسبنا منحنى المد كل 5 دقائق لكل يوم من {year} باستخدام <strong>17 مركبة توافقية</strong> من نموذج <span class="latin">EOT20</span> العالمي، مع التصحيحات الفلكية والعقدية. ثم أخذنا لكل يوم الفرق بين أعلى مد وأدنى جزر، واخترنا أكبر قيمة في السنة. تحققنا من محرك الحساب مقابل مكتبة <span class="latin">pyTMD</span> المستقلة (فرق أقل من 0.2 سم). <a href={`${BASE}methodology`}>المزيد عن المنهجية</a>.</p>
  <div class="callout warn"><span class="ic">⚠️</span><div>نموذج EOT20 يقرأ القيم من أقرب خلية بحرية في شبكة عالمية، لذلك قد يختلف المد داخل الموانئ والخلجان الصغيرة عن الأرقام هنا. هذه تقديرات للمقارنة والصيد، وليست للملاحة.</div></div>
</ArticleLayout>
