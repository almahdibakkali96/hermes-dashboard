---
import ArticleLayout from '../../components/ArticleLayout.astro';
import { articleBySlug } from '../../lib/articles';
import { dayExtremes, getTimezoneOffset, type Constituent } from '../../lib/tides';
import { moonPhase, nextPrincipalPhases } from '../../lib/astronomy';

const meta = articleBySlug('moon-phases-fishing');
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const today = new Date();
const load = async (id: string) => (await import(`../../data/places/${id}.json`)).default;

// Daily range (highest high − lowest low, cm) in a port's local day
async function rangeOn(id: string, d: Date) {
  const port = await load(id);
  const ex = dayExtremes(port.constituents as Record<string, Constituent>, d, getTimezoneOffset(port.timezone, d));
  const h = ex.filter(e => e.type === 'high'), l = ex.filter(e => e.type === 'low');
  return h.length && l.length ? Math.round(Math.max(...h.map(e => e.height)) - Math.min(...l.map(e => e.height))) : 0;
}

// --- The next four principal phases (first day each starts), with the range they bring
const KEY: Record<string, string> = { 'محاق': 'مد ربيعي', 'تربيع أول': 'مد محاقي', 'بدر': 'مد ربيعي', 'تربيع أخير': 'مد محاقي' };
const upcoming: { date: string; emoji: string; name: string; tide: string; muscat: number; casa: number }[] = [];
for (const p of nextPrincipalPhases(today, 4)) {
  upcoming.push({
    date: p.date.toLocaleDateString('ar-EG-u-nu-latn', { timeZone: 'Asia/Riyadh', weekday: 'long', day: 'numeric', month: 'long' }),
    emoji: p.emoji, name: p.nameAr, tide: KEY[p.nameAr],
    muscat: await rangeOn('muscat', p.date), casa: await rangeOn('casablanca', p.date),
  });
}
const now = moonPhase(today);

const phases = [
  ['🌑', 'محاق', 'القمر بين الأرض والشمس، لا يُرى. مد قوي.'],
  ['🌒', 'هلال متزايد', 'يظهر بعد الغروب ويكبر كل ليلة.'],
  ['🌓', 'تربيع أول', 'نصف القمر مضيء. مد ضعيف.'],
  ['🌔', 'أحدب متزايد', 'أكثر من النصف، والمد يقوى من جديد.'],
  ['🌕', 'بدر', 'القمر كامل طوال الليل. مد قوي.'],
  ['🌖', 'أحدب متناقص', 'يشرق متأخراً بعد الغروب ويصغر.'],
  ['🌗', 'تربيع أخير', 'نصف القمر، يُرى بعد منتصف الليل. مد ضعيف.'],
  ['🌘', 'هلال متناقص', 'يُرى قبل الفجر، ثم يعود المحاق.'],
];

const toc = [
  { id: 'cycle', label: 'دورة القمر في 29.5 يوماً' },
  { id: 'tide', label: 'كيف يغيّر الطور قوة المد؟' },
  { id: 'full-new', label: 'البدر أم المحاق؟' },
  { id: 'quarters', label: 'أيام التربيع' },
  { id: 'upcoming', label: 'الأطوار القادمة' },
];
const takeaways = [
  'يكمل القمر دورته في <strong>29.5 يوماً</strong> تقريباً، ويمر بـ<strong>8 أطوار</strong>.',
  'عند <strong>البدر والمحاق</strong> يكون المد قوياً (مد ربيعي)، وعند <strong>التربيع</strong> يكون ضعيفاً (مد محاقي).',
  'المد القوي يعني تيارات أقوى وطعاماً أكثر حركة، لذلك يفضّل كثير من الصيادين <strong>الأيام حول البدر والمحاق</strong>. في الخليج العربي يؤثر أيضاً ميل القمر.',
  `القمر اليوم: <strong>${now.emoji} ${now.phaseNameAr}</strong>، مضاء بنسبة <strong>${Math.round(now.illumination * 100)}%</strong>.`,
];
const faq = [
  { q: 'هل الصيد في البدر أفضل؟', a: 'البدر من أقوى أيام المد، والماء يتحرك فيه بقوة، وهذا مفيد للصيد عادة. لكن ضوء القمر الكامل يجعل بعض الأسماك تتغذى ليلاً، فقد يكون الصيد في النهار أهدأ. كثير من الصيادين يفضلون الأيام الثلاثة قبل البدر وبعده.' },
  { q: 'هل المحاق جيد للصيد؟', a: 'نعم. المحاق يعطي مداً قوياً مثل البدر، والليالي المظلمة مناسبة للصيد بالأضواء، مثل صيد الحبار الذي ينجذب إلى الضوء أكثر حين لا يكون هناك قمر.' },
  { q: 'لماذا يكون المد ضعيفاً في التربيع؟', a: 'في التربيع تكون الشمس والقمر بزاوية قائمة من الأرض، فيعاكس جذب الشمس جذب القمر جزئياً، فيصغر الفرق بين المد والجزر.' },
  { q: 'هل يؤثر القمر على الأسماك مباشرة أم عبر المد فقط؟', a: 'التأثير الأوضح علمياً هو عبر المد والتيارات. أما التأثير المباشر للضوء ولإيقاع القمر فموجود لدى بعض الأنواع، لكن الأبحاث لم تحسمه لكل الأسماك.' },
  { q: 'كم يتأخر طور القمر بين شهر وآخر؟', a: 'الشهر القمري 29.5 يوماً، أي أقصر من الشهر الميلادي بيوم أو يومين، فيأتي البدر كل شهر ميلادي أبكر بيوم أو يومين تقريباً.' },
];
---

<ArticleLayout meta={meta} toc={toc} takeaways={takeaways} faq={faq} relatedPorts={['muscat', 'casablanca', 'kuwait-city', 'dubai']}>
  <svg slot="art" viewBox="0 0 300 260" class="w-full h-auto">
    <circle cx="150" cy="110" r="70" fill="#fde68a"/>
    <circle cx="125" cy="90" r="12" fill="#f5d36a"/><circle cx="175" cy="130" r="9" fill="#f5d36a"/><circle cx="160" cy="80" r="6" fill="#f5d36a"/>
    <path d="M0 220 C50 200 100 240 150 220 S250 200 300 220 V260 H0Z" fill="#2dd4bf" opacity=".35"/>
  </svg>

  <h2 id="cycle">دورة القمر في 29.5 يوماً</h2>
  <p>القمر لا يضيء بنفسه، بل يعكس ضوء الشمس. ومع دورانه حول الأرض نرى منه جزءاً مضيئاً يكبر ثم يصغر. تتكرر هذه الدورة كل <strong>29 يوماً و12 ساعة و44 دقيقة</strong> تقريباً، وهي أساس الشهر الهجري.</p>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-6">
    {phases.map(p => (
      <div class={`card p-3 text-center ${p[1] === now.phaseNameAr ? 'ring-2 ring-[var(--accent)]' : ''}`}>
        <div class="text-3xl" aria-hidden="true">{p[0]}</div>
        <div class="font-semibold mt-1">{p[1]}</div>
        <div class="text-xs text-[var(--text-secondary)] mt-1 leading-relaxed">{p[2]}</div>
      </div>
    ))}
  </div>

  <h2 id="tide">كيف يغيّر الطور قوة المد؟</h2>
  <p>المد يصنعه جذب <strong>القمر والشمس</strong> معاً. حين يكونان على خط واحد مع الأرض (البدر والمحاق) تتجمع قوتهما فيرتفع المد أعلى وينخفض الجزر أكثر: هذا <strong>المد الربيعي</strong>. وحين يكونان بزاوية قائمة (التربيع) يتعاكسان جزئياً فيصغر المدى: هذا <strong>المد المحاقي</strong>.</p>
  <div class="callout fact"><span class="ic">⏱️</span><div>أقوى مد لا يأتي يوم البدر بالضبط، بل غالباً <strong>بعده بيوم أو يومين</strong>، لأن المحيطات تحتاج وقتاً لتستجيب لقوى الجذب.</div></div>
  <p>والفرق كبير: في نفس الميناء قد يكون المدى أيام البدر <strong>ضعفي أو ثلاثة أضعاف</strong> المدى أيام التربيع. <a href={`${BASE}articles/how-to-read-tide-table`}>شاهد مثال الدار البيضاء ←</a></p>

  <h2 id="full-new">البدر أم المحاق؟</h2>
  <p>كلاهما يعطي مداً قوياً، والفرق الأساسي في <strong>ضوء الليل</strong>:</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-5">
    <div class="card p-4"><div class="font-semibold">🌕 البدر</div><p class="text-sm text-[var(--text-secondary)] !my-1">ليل مضيء طوال الليل. بعض الأسماك تتغذى ليلاً فتكون أهدأ في النهار. مناسب للصيد الليلي من الشاطئ.</p></div>
    <div class="card p-4"><div class="font-semibold">🌑 المحاق</div><p class="text-sm text-[var(--text-secondary)] !my-1">ليل مظلم تماماً. الأضواء تجذب الطعم والحبار أكثر. كثيرون يجدون الصيد في الفجر والمساء أنشط.</p></div>
  </div>
  <div class="pull">لا تبحث عن يوم البدر وحده: الأيام الثلاثة قبله وبعده غالباً بنفس الجودة.</div>

  <h2 id="quarters">أيام التربيع</h2>
  <p>في <strong>التربيع الأول والأخير</strong> يكون المد ضعيفاً والتيارات هادئة. هذا ليس سيئاً دائماً:</p>
  <ul class="list-disc ps-6 space-y-2 my-4">
    <li>الماء الهادئ أنسب للمبتدئين وللصيد من القوارب الصغيرة.</li>
    <li>في الموانئ ذات المد القوي، مثل الكويت والدار البيضاء، يكون الصيد على الصخور أكثر أماناً.</li>
    <li>الماء أصفى عادة، وهذا مفيد للصيد بالطعوم الصناعية.</li>
  </ul>

  <h2 id="upcoming">الأطوار القادمة</h2>
  <p>هذه الأطوار الرئيسية الأربعة القادمة، مع مدى المد المتوقع ذلك اليوم في ميناءين بمد قوي:</p>
  <div class="overflow-x-auto">
    <table class="data-table">
      <thead><tr><th>الطور</th><th>التاريخ</th><th>نوع المد</th><th>مسقط</th><th>الدار البيضاء</th></tr></thead>
      <tbody>
        {upcoming.map(u => (
          <tr><td>{u.emoji} {u.name}</td><td>{u.date}</td><td>{u.tide}</td><td><span class="latin">{u.muscat}</span> سم</td><td><span class="latin">{u.casa}</span> سم</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="text-sm text-[var(--text-muted)]">المدى: الفرق بين أعلى مد وأدنى جزر في ذلك اليوم بالتوقيت المحلي. التواريخ بتوقيت مكة المكرمة.</p>
  <div class="callout fact"><span class="ic">🧭</span><div><strong>في الخليج العربي القاعدة أقل وضوحاً.</strong> المد هناك مختلط، فيتأثر أيضاً بـ<strong>ميل القمر</strong> شمال خط الاستواء أو جنوبه. لذلك قد يأتي أكبر مد في الكويت مثلاً في أيام التربيع لا البدر. راجع تقويم ميناءك بدل الاعتماد على طور القمر وحده.</div></div>
  <p>في صفحة كل ميناء تجد <strong>تقويماً شهرياً</strong> فيه طور القمر وتقييم الصيد لكل يوم، حتى تخطط رحلتك مسبقاً.</p>
</ArticleLayout>
