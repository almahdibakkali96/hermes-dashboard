---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../lib/articles';

const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const fmtDate = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('ar-EG-u-nu-latn', { day: 'numeric', month: 'long', year: 'numeric' });
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'مقالات ArabTides', inLanguage: 'ar',
  hasPart: articles.map(a => ({ '@type': 'Article', headline: a.title, url: new URL(`${BASE}articles/${a.slug}`, Astro.site).href, datePublished: a.published })),
};
---

<BaseLayout title="مقالات عن المد والجزر والصيد" description="أدلة ومقالات بالعربية عن المد والجزر، أفضل أوقات الصيد، وأطوار القمر في الموانئ العربية." jsonLd={jsonLd}>
  <section class="hero">
    <div class="max-w-6xl mx-auto px-4 pt-10 pb-24">
      <nav class="breadcrumb breadcrumb-light" aria-label="مسار التنقل"><a href={BASE}>الرئيسية</a><span class="sep">/</span><span aria-current="page">مقالات</span></nav>
      <h1 class="mt-4 text-4xl sm:text-5xl font-bold display">مقالات</h1>
      <p class="mt-3 text-lg text-slate-300 max-w-xl">أدلة عملية وأرقام من بياناتنا عن المد والجزر والصيد في الموانئ العربية.</p>
    </div>
    <svg class="hero-waves" viewBox="0 0 1440 72" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 40c120-20 240-30 360-18s240 40 360 36 240-34 360-38 240 18 360 26v26H0z" fill="currentColor" />
    </svg>
  </section>

  <main id="main" class="max-w-6xl mx-auto px-4 w-full mt-2">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {articles.map(a => (
        <a href={`${BASE}articles/${a.slug}`} class="card overflow-hidden group block">
          <div class="h-40 flex items-center justify-center text-6xl" style="background:linear-gradient(160deg,#0b2540,#0f3d5c 60%,#0d5c63)" aria-hidden="true">{a.icon}</div>
          <div class="p-5">
            <span class="text-xs font-semibold text-[var(--accent-text)] bg-[var(--accent-muted)] rounded-full px-2.5 py-1">{a.tag}</span>
            <h2 class="mt-3 text-xl font-bold display leading-snug group-hover:text-[var(--accent-text)] transition-colors">{a.title}</h2>
            <p class="mt-2 text-[var(--text-secondary)] leading-relaxed">{a.summary}</p>
            <p class="mt-4 text-xs text-[var(--text-muted)]">{fmtDate(a.published)} · <span class="latin">{a.readingMinutes}</span> دقائق قراءة</p>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
