---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fish, kindNames } from '../../lib/fish';
import { seas, type SeaId } from '../../lib/seaNames';

const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const pageUrl = new URL(`${BASE}fish`, Astro.site).href;
const seaIds = Object.keys(seas) as SeaId[];
const description = `دليل ${fish.length} نوعاً من أسماك البحار العربية بالصور: الاسم الفصيح والأسماء المحلية في كل بلد، والبحار التي تعيش فيها، وأفضل وقت ومد لصيدها.`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: new URL(BASE, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'دليل الأسماك', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: 'دليل أسماك البحار العربية',
    itemListElement: fish.map((f, i) => ({
      '@type': 'ListItem', position: i + 1, name: f.ar, url: new URL(`${BASE}fish/${f.id}`, Astro.site).href,
    })),
  },
];
---

<BaseLayout title="دليل الأسماك: أسماء أسماك البحار العربية وصورها" description={description} jsonLd={jsonLd}>
  <div class="page-head">
    <div class="max-w-6xl mx-auto px-4 py-8">
      <nav class="breadcrumb" aria-label="مسار التنقل">
        <a href={BASE}>الرئيسية</a><span class="sep">/</span>
        <span aria-current="page">دليل الأسماك</span>
      </nav>
      <h1 class="mt-3 text-3xl font-bold display">دليل الأسماك</h1>
      <p class="mt-2 text-[var(--text-secondary)] max-w-2xl leading-relaxed">
        السمكة نفسها لها اسم في الكويت وآخر في مصر وثالث في تونس. هنا <span class="latin">{fish.length}</span> نوعاً من أسماك البحار العربية بأسمائها المحلية، مع أفضل مرحلة من المد لصيد كل منها، والموانئ التي تجدها قربها.
      </p>
    </div>
  </div>

  <main id="main" class="max-w-6xl mx-auto px-4 py-8 w-full">
    <div class="flex flex-wrap gap-2 mb-6" role="group" aria-label="تصفية حسب البحر">
      <button type="button" class="sea-chip" data-sea="" aria-pressed="true">كل البحار</button>
      {seaIds.map(s => (
        <button type="button" class="sea-chip" data-sea={s} aria-pressed="false" style={`--sea:${seas[s].color}`}>{seas[s].name}</button>
      ))}
    </div>

    <div id="fish-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {fish.map(f => (
        <a href={`${BASE}fish/${f.id}`} class="card overflow-hidden group block" data-seas={f.seas.join(' ')}>
          <img src={`${BASE}fish/${f.id}.webp`} alt={f.ar} loading="lazy" decoding="async" class="fish-thumb" />
          <span class="block p-3">
            <span class="block text-[11px] text-[var(--text-muted)]">{kindNames[f.kind]}</span>
            <span class="block font-semibold display text-lg leading-snug group-hover:text-[var(--accent)] transition-colors">{f.ar}</span>
            <span class="block text-xs text-[var(--text-secondary)] mt-1 leading-relaxed">
              {f.local.filter(l => l.name !== f.ar).slice(0, 2).map(l => l.name).join('، ')}
            </span>
            <span class="block text-[11px] text-[var(--text-dim)] latin italic mt-1" lang="la">{f.sci}</span>
          </span>
        </a>
      ))}
    </div>
    <p id="fish-empty" class="hidden text-sm text-[var(--text-muted)]">لا توجد أنواع في هذا البحر.</p>

    <p class="mt-10 text-xs text-[var(--text-muted)] leading-relaxed">
      الصور من ويكيميديا كومنز بتراخيص مفتوحة.
      <a href={`${BASE}fish/credits`} class="text-[var(--accent)] hover:underline">مصادر الصور وتراخيصها</a>.
      الأسماء المحلية تختلف من مدينة إلى أخرى داخل البلد الواحد؛ إن كان لديك اسم آخر شائع في منطقتك
      <a href={`${BASE}contact`} class="text-[var(--accent)] hover:underline">راسلنا</a>.
    </p>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('button.sea-chip');
    var cards = document.querySelectorAll('#fish-grid > a');
    var empty = document.getElementById('fish-empty');
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var sea = chip.getAttribute('data-sea');
        chips.forEach(function (c) { c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'); });
        var shown = 0;
        cards.forEach(function (card) {
          var ok = !sea || (' ' + card.getAttribute('data-seas') + ' ').indexOf(' ' + sea + ' ') !== -1;
          card.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        if (empty) empty.classList.toggle('hidden', shown > 0);
      });
    });
  })();
</script>
