---
// Self-hosted fonts (bundled with the CSS): one fewer render-blocking round trip than Google Fonts.
// V2 (#075): IBM Plex Sans Arabic for text and UI, Noto Kufi Arabic for headings (the Reels' title font; Reem Kufi
// broke some letters' dots), Inter for numbers and times.
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-700.css';
import '@fontsource/noto-kufi-arabic/arabic-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-800.css';
import plex400 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import kufi700 from '@fontsource/noto-kufi-arabic/files/noto-kufi-arabic-arabic-700-normal.woff2?url';
import '../styles/global.css';
import VercelAnalytics from '@vercel/analytics/astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { arabPlaces, worldPlaces } from '../lib/regions';
import { COMPANY } from '../lib/company';

export interface Props {
  title: string;
  description?: string;
  /** schema.org objects for this page, added next to the site-wide Organization/WebSite */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** keep out of search results (e.g. the post-payment page) */
  noindex?: boolean;
  /** no Google Analytics (the calendar's thanks page: its URL carries the buyer's download session_id) */
  noGA?: boolean;
  /** pages the mobile app links to (/app/*): no site header or footer, so no shop banners or purchase links
   *  (App Store guideline 3.1.1, Google Play payments policy) */
  bare?: boolean;
}

const { title, description, jsonLd, ogType = 'website', ogImage, noindex = false, noGA = false, bare = false } = Astro.props;
const fullTitle = `${title} — ArabTides`;
const desc = description || 'مواقيت المد والجزر والحسابات الفلكية للموانئ العربية';
const gaId = noGA ? null : import.meta.env.PUBLIC_GA_ID || null;
// The GitHub Pages build (docs/, base /hermes-dashboard) is a mirror: it points search engines to
// the production page and keeps itself out of the index, so Google never sees two copies of the site.
const PRODUCTION = 'https://www.arabtides.com';
const isMirror = import.meta.env.BASE_URL !== '/';
// Google AdSense (publisher id is public; it is also in public/ads.txt). Production only, and never on the
// app's bare pages (store policies) or the noGA pages (their URL carries the buyer's session_id).
// Which ads show, where, and the EEA/UK consent message are set in the AdSense dashboard.
const ADSENSE_CLIENT = 'ca-pub-5041199642834513';
const adsense = !isMirror && !bare && !noGA && !noindex;
const path = Astro.url.pathname.slice(isMirror ? import.meta.env.BASE_URL.replace(/\/$/, '').length : 0) || '/';
// No trailing slash, matching the sitemap and internal links
const canonical = new URL(path.replace(/(.)\/$/, '$1'), isMirror ? PRODUCTION : Astro.site).href;
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const image = new URL(ogImage || `${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/og-default.png`, Astro.site).href;

// Site-wide entities: lets search engines and AI assistants identify the publisher and the site
const siteGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}#org`,
    name: 'ArabTides',
    alternateName: 'المد والجزر العربي',
    legalName: COMPANY.legalName,
    email: COMPANY.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: COMPANY.street,
      addressLocality: COMPANY.city,
      addressRegion: COMPANY.region,
      postalCode: COMPANY.postalCode,
      addressCountry: COMPANY.country,
    },
    url: siteUrl,
    sameAs: ['https://www.instagram.com/arabtides/'],
    logo: new URL(`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/favicon.svg`, Astro.site).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: 'ArabTides — المد والجزر العربي',
    url: siteUrl,
    inLanguage: 'ar',
    publisher: { '@id': `${siteUrl}#org` },
    description: `مواقيت المد والجزر وأوقات الصيد وأطوار القمر لـ${arabPlaces.length} ميناءً من المحيط الأطلسي إلى الخليج العربي، و${worldPlaces.length} مكاناً حول العالم بالعربية، محسوبة من نموذج EOT20.`,
  },
];
const graph = [...siteGraph, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : isMirror ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#0b2540" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/favicon.ico`} />
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:site_name" content="ArabTides — المد والجزر العربي" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <link rel="alternate" type="text/plain" title="LLM guide" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/llms.txt`} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <!-- Fonts -->
    <link rel="preload" href={plex400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={kufi700} as="font" type="font/woff2" crossorigin />
    <!-- Google Analytics -->
    {gaId && (<>      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>)}
    {adsense && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">تخطَّ إلى المحتوى</a>
    {bare ? (
      <header class="app-bare-head"><span class="latin">ArabTides</span></header>
    ) : <SiteHeader />}
    <div class="flex-1 flex flex-col">
      <slot />
    </div>
    {!bare && <SiteFooter />}
    <VercelAnalytics />
    <script is:inline>
      // A click on any [data-track] element (calendar buttons, …) is an analytics event: Vercel custom events,
      // and Google Analytics when PUBLIC_GA_ID is set. data-track-where says which placement was used.
      document.addEventListener('click', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('[data-track]') : null;
        if (!el) return;
        var name = el.getAttribute('data-track'), data = { where: el.getAttribute('data-track-where') || '', path: location.pathname };
        try { if (window.va) window.va('event', { name: name, data: data }); } catch (err) {}
        try { if (window.gtag) window.gtag('event', name, data); } catch (err) {}
      });
    </script>
  </body>
</html>
