---
// Self-hosted fonts (bundled with the CSS): one fewer render-blocking round trip than Google Fonts
import '@fontsource/noto-naskh-arabic/arabic-400.css';
import '@fontsource/noto-naskh-arabic/arabic-500.css';
import '@fontsource/noto-naskh-arabic/arabic-600.css';
import '@fontsource/noto-naskh-arabic/arabic-700.css';
import '@fontsource/reem-kufi/arabic-400.css';
import '@fontsource/reem-kufi/arabic-500.css';
import '@fontsource/reem-kufi/arabic-600.css';
import '@fontsource/reem-kufi/arabic-700.css';
import '@fontsource/reem-kufi/latin-600.css';
import '@fontsource/reem-kufi/latin-700.css';
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-800.css';
import naskh400 from '@fontsource/noto-naskh-arabic/files/noto-naskh-arabic-arabic-400-normal.woff2?url';
import kufi600 from '@fontsource/reem-kufi/files/reem-kufi-arabic-600-normal.woff2?url';
import '../styles/global.css';
import VercelAnalytics from '@vercel/analytics/astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
  title: string;
  description?: string;
  /** schema.org objects for this page, added next to the site-wide Organization/WebSite */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** keep out of search results (e.g. the post-payment page) */
  noindex?: boolean;
}

const { title, description, jsonLd, ogType = 'website', ogImage, noindex = false } = Astro.props;
const fullTitle = `${title} — ArabTides`;
const desc = description || 'مواقيت المد والجزر والحسابات الفلكية للموانئ العربية';
const gaId = import.meta.env.PUBLIC_GA_ID || null;
// The GitHub Pages build (docs/, base /hermes-dashboard) is a mirror: it points search engines to
// the production page and keeps itself out of the index, so Google never sees two copies of the site.
const PRODUCTION = 'https://www.arabtides.com';
const isMirror = import.meta.env.BASE_URL !== '/';
const path = Astro.url.pathname.slice(isMirror ? import.meta.env.BASE_URL.replace(/\/$/, '').length : 0) || '/';
// No trailing slash, matching the sitemap and internal links
const canonical = new URL(path.replace(/(.)\/$/, '$1'), isMirror ? PRODUCTION : Astro.site).href;
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const image = new URL(ogImage || `${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/og-default.png`, Astro.site).href;

// Site-wide entities: lets search engines and AI assistants identify the publisher and the site
const siteGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}#org`,
    name: 'ArabTides',
    alternateName: 'المد والجزر العربي',
    url: siteUrl,
    sameAs: ['https://www.instagram.com/arabtides/'],
    logo: new URL(`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/favicon.svg`, Astro.site).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: 'ArabTides — المد والجزر العربي',
    url: siteUrl,
    inLanguage: 'ar',
    publisher: { '@id': `${siteUrl}#org` },
    description: 'مواقيت المد والجزر وأوقات الصيد وأطوار القمر لـ53 ميناءً عربياً، محسوبة من نموذج EOT20.',
  },
];
const graph = [...siteGraph, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : isMirror ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#0b2540" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/favicon.ico`} />
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:site_name" content="ArabTides — المد والجزر العربي" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <link rel="alternate" type="text/plain" title="LLM guide" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/llms.txt`} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <!-- Fonts -->
    <link rel="preload" href={naskh400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={kufi600} as="font" type="font/woff2" crossorigin />
    <!-- Google Analytics -->
    {gaId && (<>      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">تخطَّ إلى المحتوى</a>
    <SiteHeader />
    <div class="flex-1 flex flex-col">
      <slot />
    </div>
    <SiteFooter />
    <VercelAnalytics />
  </body>
</html>
