---
// The port field for the 2027 calendar: a search box with a suggestion list (Arabic, English or French port names, or a
// country name for its ports). The text is still sent exactly as typed for sign-ups; the page script
// (src/pages/calendar/index.astro) fills the list and picks the port.
interface Props { id: string; label: string }
const { id, label } = Astro.props;
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
---

<label class="signup-label" for={id}>{label}</label>
<div class="cal-port-field">
  <img class="cal-port-flag" src={`${BASE}flags/ae.svg`} alt="" width="28" height="21" hidden />
  <div class="cal-port-box">
    <input id={id} name="port" type="text" required maxlength="60" autocomplete="off" spellcheck="false"
      placeholder="ابحث: مدينة أو بلد (عربي أو لاتيني)" class="cal-select" data-cal-port
      role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-list`} />
    <ul id={`${id}-list`} class="cal-suggest" role="listbox" aria-label="اقتراحات الموانئ" hidden></ul>
  </div>
</div>
