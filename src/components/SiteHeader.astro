---
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const path = Astro.url.pathname.replace(/\/$/, '');

const links = [
  { href: `${BASE}#ports`, label: 'الموانئ', match: '/ports' },
  { href: `${BASE}#countries`, label: 'الدول', match: '/country' },
  { href: `${BASE}fish`, label: 'الأسماك', match: '/fish' },
  { href: `${BASE}articles`, label: 'مقالات', match: '/articles' },
  { href: `${BASE}moon`, label: 'القمر', match: '/moon' },
  { href: `${BASE}methodology`, label: 'المنهجية', match: '/methodology' },
  { href: `${BASE}about`, label: 'عن الموقع', match: '/about' },
];
const guideActive = path.includes('/guide');
---

<header class="site-header">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center gap-3 lg:gap-6 relative">
    <a href={BASE} class="flex items-center gap-2.5 shrink-0" aria-label="ArabTides — الصفحة الرئيسية">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="36" height="36">
          <defs>
            <linearGradient id="hdr-bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0f3d5c" /><stop offset="1" stop-color="#0b2540" /></linearGradient>
            <mask id="hdr-crescent"><rect width="64" height="64" fill="#fff" /><circle cx="47.5" cy="16" r="8.6" fill="#000" /></mask>
          </defs>
          <rect width="64" height="64" rx="16" fill="url(#hdr-bg)" />
          <circle cx="42" cy="20" r="10" fill="#fde68a" mask="url(#hdr-crescent)" />
          <path d="M9 39c3.75-5 7.5-5 11.25 0s7.5 5 11.25 0 7.5-5 11.25 0 7.5 5 11.25 0" fill="none" stroke="#2dd4bf" stroke-width="4.2" stroke-linecap="round" />
          <path d="M9 49c3.75-5 7.5-5 11.25 0s7.5 5 11.25 0 7.5-5 11.25 0 7.5 5 11.25 0" fill="none" stroke="#14b8a6" stroke-opacity=".55" stroke-width="4.2" stroke-linecap="round" />
        </svg>
      </span>
      <span class="leading-none">
        <span class="block text-lg font-extrabold latin tracking-tight text-[var(--text-primary)]">ArabTides</span>
        <span class="block text-[11px] text-[var(--text-muted)] mt-0.5">المد والجزر العربي</span>
      </span>
    </a>

    <!-- Wide screens: the links inline -->
    <nav class="site-nav" aria-label="التنقّل الرئيسي">
      {links.map(l => (
        <a href={l.href} class:list={['site-nav-link', { active: path.includes(l.match) }]}
           aria-current={path.includes(l.match) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <!-- The paid guide stays visible at every width -->
    <a href={`${BASE}guide`} class:list={['nav-cta', { active: guideActive }]} aria-current={guideActive ? 'page' : undefined}>
      <span aria-hidden="true">📘</span> <span class="nav-cta-short">الدليل</span><span class="nav-cta-long">دليل الصياد</span>
    </a>

    <!-- Narrow screens: the links in a menu -->
    <details class="nav-menu" id="nav-menu">
      <summary aria-label="القائمة">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <nav class="nav-menu-panel" aria-label="القائمة">
        {links.map(l => (
          <a href={l.href} class:list={['nav-menu-link', { active: path.includes(l.match) }]}
             aria-current={path.includes(l.match) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  (function () {
    // Close the menu on a tap outside it, on Escape, and when a link inside it (e.g. #ports) is followed
    var m = document.getElementById('nav-menu');
    if (!m) return;
    document.addEventListener('click', function (e) { if (m.open && !m.contains(e.target)) m.open = false; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') m.open = false; });
    m.querySelector('.nav-menu-panel').addEventListener('click', function (e) { if (e.target.closest('a')) m.open = false; });
  })();
</script>
