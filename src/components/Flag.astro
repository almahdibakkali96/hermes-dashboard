---
// Country flag from public/flags/<code>.svg (flag-icons, MIT). Decorative: the country name sits beside it.
interface Props { code: string; size?: number; class?: string }
const { code, size = 20, class: cls = '' } = Astro.props;
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
---
<img src={`${BASE}flags/${code.toLowerCase()}.svg`} alt="" aria-hidden="true" width={size} height={Math.round(size * 0.75)}
  loading="lazy" decoding="async" class={`flag ${cls}`} />
