---
// The port <select> for the 2027 calendar: every port, grouped by country (index order, west → east), with a flag
// beside it that the page script updates. Starts on "اختر ميناءك…" so choosing is a deliberate step.
import placesIndex from '../data/places/places_index.json';
import { countryName } from '../lib/countries';

interface Props { id: string; label: string }
const { id, label } = Astro.props;
const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
type Place = { id: string; name_ar: string; country: string };
const places = placesIndex as Place[];
const countries = [...new Set(places.map(p => p.country))];
---

<label class="signup-label" for={id}>{label}</label>
<div class="cal-port-field">
  <img class="cal-port-flag" src={`${BASE}flags/ae.svg`} alt="" width="28" height="21" hidden />
  <select id={id} name="port" required class="cal-select" data-cal-port>
    <option value="" selected>اختر ميناءك…</option>
    {countries.map(cc => (
      <optgroup label={countryName(cc)}>
        {places.filter(p => p.country === cc).map(p => <option value={p.id}>{p.name_ar}</option>)}
      </optgroup>
    ))}
  </select>
</div>
