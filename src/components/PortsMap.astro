---
// Homepage map of every port, in the brand's map style (public/map/land.svg, the Reels' look): each dot shows whether
// the water is rising or falling right now, or today's fishing rating; tabs zoom to a sea; a tap opens the port's card.
// The land, tabs and sea names are drawn here; src/scripts/ports-map.ts adds the dots (links to the ports, which the
// homepage's port list also links to) and everything that moves.
import { mapRegions, seaOrder, zoneOrder } from '../lib/mapData';
import { zoneNames } from '../lib/regions';
import { PROJ, project } from '../lib/mapProjection';
import { seas, type SeaId } from '../lib/seaNames';

const BASE = (import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/');
const tabNames: Record<SeaId, string> = { atlantic: 'الأطلسي', med: 'المتوسط', red: 'البحر الأحمر', gulf: 'الخليج', indian: 'بحر العرب' };
// The dots and their live data come from /map/now.json (src/pages/map/now.json.ts), fetched by the script when
// the map nears the screen: they are most of the map's weight and the homepage loads faster without them
const regions = mapRegions();

// First view (before the script fits it to the box): "all" at a wide aspect
const fit = ([x0, y0, x1, y1]: number[], aspect: number) => {
  const pad = 14 + 0.06 * Math.max(x1 - x0, y1 - y0);
  let w = x1 - x0 + 2 * pad, h = y1 - y0 + 2 * pad;
  if (w / h < aspect) w = h * aspect; else h = w / aspect;
  return [(x0 + x1) / 2 - w / 2, (y0 + y1) / 2 - h / 2, w, h].map(v => +v.toFixed(1));
};
const vb0 = fit(regions.all, 16 / 7);

// Faint lines every 10°, and the seas' names
const grat: string[] = [];
for (let lon = -170; lon <= 170; lon += 10) { const [x] = project(lon, 0); grat.push(`M${x.toFixed(1)} 0V${PROJ.H}`); }
for (let lat = -50; lat <= 70; lat += 10) { const [, y] = project(0, lat); grat.push(`M0 ${y.toFixed(1)}H${PROJ.W}`); }
const seaLabels = [
  { t: 'المحيط الأطلسي', lon: -19.5, lat: 29, rot: 0 },
  { t: 'البحر الأبيض المتوسط', lon: 18.5, lat: 34.6, rot: 0 },
  { t: 'البحر الأحمر', lon: 37.6, lat: 21.6, rot: 60 },
  { t: 'الخليج العربي', lon: 51.3, lat: 27.6, rot: 25 },
  { t: 'بحر العرب', lon: 62, lat: 15.5, rot: 0 },
  { t: 'المحيط الهندي', lon: 80, lat: -18, rot: 0 },
  { t: 'المحيط الهادئ', lon: -140, lat: 5, rot: 0 },
  { t: 'المحيط الهادئ', lon: 160, lat: 25, rot: 0 },
  { t: 'المحيط الأطلسي', lon: -40, lat: 32, rot: 0 },
  { t: 'المحيط الأطلسي', lon: -20, lat: -20, rot: 0 },
].map(l => { const [x, y] = project(l.lon, l.lat); return { ...l, x: +x.toFixed(1), y: +y.toFixed(1) }; });


---

<div class="pmap" data-ports-map data-src={`${BASE}map/now.json`}>
  <div class="pmap-bar">
    <div class="pmap-tabs" role="group" aria-label="اختر البحر">
      <button type="button" class="pmap-tab" data-region="all" aria-pressed="true">العالم العربي</button>
      {seaOrder.map(s => <button type="button" class="pmap-tab" data-region={s} aria-pressed="false" style={`--sea:${seas[s].color}`}>{tabNames[s]}</button>)}
      <span class="pmap-sep" aria-hidden="true"></span>
      <button type="button" class="pmap-tab" data-region="world" aria-pressed="false">العالم كله</button>
      {zoneOrder.map(z => <button type="button" class="pmap-tab" data-region={z} aria-pressed="false">{zoneNames[z]}</button>)}
    </div>
    <div class="pmap-modes" role="group" aria-label="ماذا تعرض النقاط">
      <button type="button" class="pmap-mode" data-mode="tide" aria-pressed="true">المد الآن</button>
      <button type="button" class="pmap-mode" data-mode="fish" aria-pressed="false">الصيد اليوم</button>
    </div>
  </div>

  <div class="pmap-stage">
    <svg class="pmap-svg" viewBox={vb0.join(' ')} preserveAspectRatio="xMidYMid meet" role="img" aria-label="خريطة الموانئ العربية وحول العالم">
      <defs>
        <radialGradient id="pmap-glow" cx="0.55" cy="0.35" r="0.7"><stop offset="0" stop-color="#14506b" /><stop offset="1" stop-color="#0b2540" /></radialGradient>
      </defs>
      <rect x="-400" y="-400" width={PROJ.W + 800} height={PROJ.H + 800} fill="url(#pmap-glow)" />
      <path d={grat.join('')} class="pmap-grat" />
      <image href={`${BASE}map/land.svg`} x="0" y="0" width={PROJ.W} height={PROJ.H} />
      <g class="pmap-seas" aria-hidden="true">
        {seaLabels.map(l => <text class="pmap-sea" x={l.x} y={l.y} text-anchor="middle" transform={l.rot ? `rotate(${l.rot} ${l.x} ${l.y})` : undefined}>{l.t}</text>)}
      </g>
      <g class="pmap-labels" aria-hidden="true"></g>
      <g class="pmap-dots"></g>
    </svg>
    <div class="pmap-zoom" role="group" aria-label="تكبير الخريطة">
      <button type="button" data-zoom="in" aria-label="تكبير">+</button>
      <button type="button" data-zoom="out" aria-label="تصغير">−</button>
      <button type="button" data-zoom="fit" aria-label="العودة إلى المنطقة المختارة" title="العودة إلى المنطقة المختارة">⤢</button>
    </div>
    <div class="pmap-legend" aria-hidden="true">
      <span data-legend="tide"><i style="background:#2dd4bf"></i>يرتفع <i style="background:#fb7185"></i>ينخفض</span>
      <span data-legend="fish" hidden>{[5, 4, 3, 2, 1].map(r => <><i class={`r${r}`}></i><b class="latin">{r}</b></>)}</span>
    </div>
  </div>

  <div class="pmap-card" aria-live="polite">
    <p class="pmap-hint">اسحب الخريطة لتحريكها وقرّبها بإصبعين أو بالزرين، ثم اضغط على أي ميناء لترى هل يرتفع الماء فيه الآن، وموعد المد والجزر القادمين، وتقييم الصيد اليوم.</p>
  </div>
</div>

<script>
  import '../scripts/ports-map';
</script>
